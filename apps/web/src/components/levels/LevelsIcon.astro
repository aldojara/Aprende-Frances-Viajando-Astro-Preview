---
import type { LevelsIconName } from "../../data/levelsLanding";

interface Props {
  name: LevelsIconName;
  label?: string;
}

const { name, label } = Astro.props;
---

<span
  class="levels-icon"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <svg viewBox="0 0 24 24" focusable="false">
    {
      name === "arrow" && (
        <>
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </>
      )
    }
    {
      name === "book" && (
        <>
          <path d="M4 5.5c2.8-.85 5.05-.38 7 1.45v11.6c-1.95-1.7-4.2-2.2-7-1.45z" />
          <path d="M20 5.5c-2.8-.85-5.05-.38-7 1.45v11.6c1.95-1.7 4.2-2.2 7-1.45z" />
          <path d="M12 6.95v11.6" />
        </>
      )
    }
    {
      name === "briefcase" && (
        <>
          <path d="M5 8h14v10H5z" />
          <path d="M9 8V6h6v2" />
          <path d="M5 12h14" />
        </>
      )
    }
    {
      name === "chart" && (
        <>
          <path d="M4 19h16" />
          <path d="M7 16v-4" />
          <path d="M12 16V8" />
          <path d="M17 16v-7" />
          <path d="m6 10 4-4 3 3 5-5" />
        </>
      )
    }
    {
      name === "compass" && (
        <>
          <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18" />
          <path d="m15.5 8.5-2 5-5 2 2-5z" />
        </>
      )
    }
    {
      name === "edit" && (
        <>
          <path d="M5 19h4l10-10-4-4L5 15z" />
          <path d="m13 7 4 4" />
        </>
      )
    }
    {
      name === "folder" && (
        <>
          <path d="M4 7h6l2 2h8v9H4z" />
          <path d="M4 10h16" />
        </>
      )
    }
    {
      name === "headphones" && (
        <>
          <path d="M5 13v-1a7 7 0 0 1 14 0v1" />
          <path d="M5 13h3v6H6a1 1 0 0 1-1-1z" />
          <path d="M19 13h-3v6h2a1 1 0 0 0 1-1z" />
        </>
      )
    }
    {
      name === "megaphone" && (
        <>
          <path d="M4 13h3l9 4V7l-9 4H4z" />
          <path d="m8 13 2 6" />
          <path d="M19 9.5c.8.8 1.2 1.6 1.2 2.5s-.4 1.7-1.2 2.5" />
        </>
      )
    }
    {
      name === "play" && (
        <>
          <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18" />
          <path d="m10 8 6 4-6 4z" />
        </>
      )
    }
    {
      name === "spark" && (
        <>
          <path d="M12 3 14 9l6 2-6 2-2 8-2-8-6-2 6-2z" />
          <path d="M19 3v4" />
          <path d="M21 5h-4" />
        </>
      )
    }
    {
      name === "target" && (
        <>
          <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18" />
          <path d="M12 17a5 5 0 1 0 0-10 5 5 0 0 0 0 10" />
          <path d="M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2" />
          <path d="m15 9 4-4" />
        </>
      )
    }
    {
      name === "tower" && (
        <>
          <path d="M12 3 8 20" />
          <path d="m12 3 4 17" />
          <path d="M9 10h6" />
          <path d="M8 15h8" />
          <path d="M6 20h12" />
          <path d="M10 7h4" />
        </>
      )
    }
    {
      name === "vocabulary" && (
        <>
          <path d="M6 19V5" />
          <path d="M5 19h6" />
          <path d="M5 5h6" />
          <path d="M8 5v14" />
          <path d="M15 5h3l-4 14h3" />
          <path d="M14 19h5" />
        </>
      )
    }
  </svg>
</span>

<style>
  .levels-icon {
    display: inline-grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    color: currentColor;
  }

  .levels-icon svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
  }
</style>
