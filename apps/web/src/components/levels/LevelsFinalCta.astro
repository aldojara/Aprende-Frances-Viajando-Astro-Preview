---
import LevelsIcon from "./LevelsIcon.astro";
import { finalCtas } from "../../data/levelsLanding";
import { withBase } from "../../utils/paths";
---

<section class="levels-final-cta" aria-labelledby="levels-final-cta-title">
  <div class="container final-cta-panel">
    <h2 id="levels-final-cta-title" class="visually-hidden">
      Continúa explorando Aprende Francés Viajando
    </h2>

    <ul>
      {
        finalCtas.map((item) => (
          <li>
            <article>
              <LevelsIcon name={item.icon} />
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <a href={withBase(item.href)}>
                  {item.cta}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>

    <div class="voyage-seal" aria-hidden="true">
      <span>Apprende</span>
      <strong>Français</strong>
      <span>Voyage</span>
    </div>
  </div>
</section>

<style>
  .levels-final-cta {
    padding-block: 1.25rem 2.2rem;
  }

  .final-cta-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: center;
    overflow: hidden;
    padding: 1.35rem;
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 6% 20%, rgba(246, 213, 149, 0.18), transparent 12rem),
      linear-gradient(135deg, #062b59, #073873);
    color: #ffffff;
    box-shadow: 0 18px 42px rgba(11, 47, 85, 0.18);
  }

  .final-cta-panel ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .final-cta-panel article {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    min-height: 8rem;
    align-items: center;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.96);
    color: var(--color-heading);
  }

  .final-cta-panel .levels-icon {
    width: 3rem;
    height: 3rem;
    color: var(--color-blue-dark);
  }

  .final-cta-panel h3 {
    font-size: 1.1rem;
  }

  .final-cta-panel p {
    margin: 0.38rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.48;
  }

  .final-cta-panel a {
    display: inline-flex;
    min-height: 2.2rem;
    align-items: center;
    gap: 0.42rem;
    margin-top: 0.62rem;
    color: var(--color-gold);
    font-size: 0.78rem;
    font-weight: 900;
  }

  .final-cta-panel a:hover,
  .final-cta-panel a:focus-visible {
    color: var(--color-blue-dark);
  }

  .voyage-seal {
    display: grid;
    width: 7.2rem;
    aspect-ratio: 1;
    place-items: center;
    align-content: center;
    border: 2px solid var(--color-gold);
    border-radius: 50%;
    color: #f6d595;
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-align: center;
    text-transform: uppercase;
  }

  .voyage-seal strong {
    color: #ffffff;
    font-size: 0.8rem;
  }

  @media (max-width: 1080px) {
    .final-cta-panel {
      grid-template-columns: 1fr;
    }

    .final-cta-panel ul {
      grid-template-columns: 1fr;
    }

    .voyage-seal {
      justify-self: center;
    }
  }

  @media (max-width: 560px) {
    .final-cta-panel {
      padding: 0.9rem;
    }

    .final-cta-panel article {
      grid-template-columns: 1fr;
      min-height: auto;
    }
  }
</style>
