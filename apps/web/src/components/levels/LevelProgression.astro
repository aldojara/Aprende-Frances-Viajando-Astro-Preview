---
import LevelsIcon from "./LevelsIcon.astro";
import { progressionFacts, progressionLevels } from "../../data/levelsLanding";
---

<article class="progression-card" aria-labelledby="progression-title">
  <div class="progression-top">
    <span aria-hidden="true"></span>
    <h2 id="progression-title">Progresión A1-C1</h2>
    <span aria-hidden="true"></span>
  </div>

  <ol class="progression-nodes" aria-label="Progresión de niveles A1 a C1">
    {
      progressionLevels.map((level) => (
        <li style={`--level-color: ${level.color}`}>
          <span>{level.code}</span>
        </li>
      ))
    }
  </ol>

  <ul class="progression-facts" aria-label="Características de la ruta">
    {
      progressionFacts.map((fact) => (
        <li>
          <LevelsIcon name={fact.icon} />
          <strong>{fact.value}</strong>
          <span>{fact.label}</span>
        </li>
      ))
    }
  </ul>

  <p>Progreso claro, objetivos reales, aprendizaje significativo.</p>
</article>

<style>
  .progression-card {
    overflow: hidden;
    border: 1px solid rgba(11, 47, 85, 0.16);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: 0 18px 44px rgba(11, 47, 85, 0.14);
  }

  .progression-top {
    display: grid;
    grid-template-columns: minmax(1rem, 1fr) auto minmax(1rem, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 1.4rem 1.35rem 0.95rem;
    background:
      radial-gradient(circle at 15% 18%, rgba(255, 255, 255, 0.18), transparent 22%),
      linear-gradient(180deg, #0b3770, #062b59);
    color: #ffffff;
  }

  .progression-top span {
    height: 1px;
    background: rgba(255, 255, 255, 0.22);
  }

  .progression-top h2 {
    color: #ffffff;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
    text-align: center;
  }

  .progression-nodes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(3rem, 1fr));
    gap: 0.6rem;
    padding: 1.15rem 1.35rem 1.4rem;
    margin: 0;
    overflow-x: auto;
    background: #062b59;
    list-style: none;
    scrollbar-width: thin;
  }

  .progression-nodes::before {
    position: absolute;
    top: 50%;
    right: 2.5rem;
    left: 2.5rem;
    height: 2px;
    border-top: 2px dashed rgba(246, 213, 149, 0.8);
    content: "";
  }

  .progression-nodes li {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
  }

  .progression-nodes span {
    display: grid;
    width: 4.15rem;
    aspect-ratio: 1;
    place-items: center;
    border: 2px solid rgba(255, 255, 255, 0.72);
    border-radius: 50%;
    background: var(--level-color);
    color: #ffffff;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 800;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.18);
  }

  .progression-facts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-bottom: 1px solid var(--color-border);
    list-style: none;
  }

  .progression-facts li {
    display: grid;
    min-height: 7.1rem;
    align-content: center;
    justify-items: center;
    gap: 0.18rem;
    padding: 0.82rem 0.55rem;
    border-right: 1px solid var(--color-border);
    color: var(--color-blue-dark);
    text-align: center;
  }

  .progression-facts li:last-child {
    border-right: 0;
  }

  .progression-facts .levels-icon {
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.2rem;
  }

  .progression-facts strong {
    color: var(--color-blue-dark);
    font-size: 0.82rem;
    line-height: 1.2;
  }

  .progression-facts span {
    color: var(--color-heading);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .progression-card > p {
    margin: 0;
    padding: 1rem 1.2rem;
    background: #fff8ea;
    color: var(--color-blue-dark);
    font-size: 0.86rem;
    font-weight: 700;
    text-align: center;
  }

  @media (max-width: 620px) {
    .progression-nodes {
      grid-template-columns: repeat(5, 3.4rem);
      padding-inline: 1rem;
    }

    .progression-nodes span {
      width: 3.35rem;
      font-size: 1.1rem;
    }

    .progression-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .progression-facts li {
      border-bottom: 1px solid var(--color-border);
    }

    .progression-facts li:nth-child(2n) {
      border-right: 0;
    }

    .progression-facts li:last-child {
      grid-column: 1 / -1;
      border-bottom: 0;
    }
  }
</style>
