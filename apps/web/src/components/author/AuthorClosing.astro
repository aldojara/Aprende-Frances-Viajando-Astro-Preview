---
import { withBase } from "../../utils/paths";

type SocialLink = {
  label: string;
  href: string;
  icon: "linkedin" | "instagram" | "tiktok";
};

const socialLinks: SocialLink[] = [
  {
    label: "LinkedIn de Aldo Jara Pisconti",
    href: "https://www.linkedin.com/in/aldojarapisconti/",
    icon: "linkedin",
  },
  {
    label: "Instagram de Aldo viajero 4x4",
    href: "https://www.instagram.com/aldoviajero4x4/",
    icon: "instagram",
  },
  {
    label: "TikTok de viajes de Aldo",
    href: "https://www.tiktok.com/@aldo.mundo.viajero",
    icon: "tiktok",
  },
  {
    label: "TikTok profesional de Big Talent Analytica",
    href: "https://www.tiktok.com/@big.talent.analytica",
    icon: "tiktok",
  },
  {
    label: "TikTok de Aprende Francés Viajando",
    href: "https://www.tiktok.com/@aprende_frances_viajando",
    icon: "tiktok",
  },
];
---

<section class="author-closing" aria-labelledby="closing-title">
  <div class="container closing-grid">
    <div class="closing-copy">
      <h2 id="closing-title">No construyo solo una página de autor.</h2>
      <p class="closing-highlight">Construyo un ecosistema de ideas, experiencias y proyectos.</p>
    </div>

    <div class="closing-actions">
      <p>Si compartes esta visión o quieres colaborar en algo significativo, conversemos.</p>
      <a
        class="button button-primary"
        href="https://www.linkedin.com/in/aldojarapisconti/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Conectar conmigo
      </a>
      <a
        class="closing-secondary"
        href="https://aldojarapisconti.com/"
        target="_blank"
        rel="noopener noreferrer"
      >
        Sitio personal de Aldo Jara Pisconti
      </a>
      <a class="closing-secondary" href={withBase("/")}>Explorar Aprende Francés Viajando</a>
    </div>

    <nav class="social-links" aria-label="Redes sociales de Aldo Jara Pisconti">
      {
        socialLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
            <span class={`social-icon social-${link.icon}`} aria-hidden="true">
              {link.icon === "linkedin" && "in"}
              {link.icon === "instagram" && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <rect x="4" y="4" width="16" height="16" rx="5" />
                  <circle cx="12" cy="12" r="3.4" />
                  <path d="M17 7.2h.01" />
                </svg>
              )}
              {link.icon === "tiktok" && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M14 4v10.2a4.3 4.3 0 1 1-4-4.28M14 4c1 3 2.8 4.6 5.5 4.9" />
                </svg>
              )}
            </span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .author-closing {
    margin-top: 3.5rem;
    border-top: 1px solid rgba(11, 47, 85, 0.1);
    background:
      linear-gradient(90deg, rgba(11, 47, 85, 0.08) 0 1px, transparent 1px),
      linear-gradient(180deg, rgba(255, 255, 255, 0.8), #eef6ff);
    background-size: 34px 100%, auto;
  }

  .closing-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.8fr);
    gap: 2rem;
    align-items: center;
    padding-block: 2.8rem;
  }

  .closing-copy {
    position: relative;
    min-height: 10rem;
    display: grid;
    align-content: center;
  }

  .closing-copy::before {
    position: absolute;
    inset: auto auto 0 0;
    width: min(28rem, 100%);
    height: 7rem;
    opacity: 0.18;
    background:
      linear-gradient(to top, var(--color-blue-dark) 0 2px, transparent 2px),
      linear-gradient(135deg, transparent 0 44%, var(--color-blue-dark) 44% 46%, transparent 46%),
      radial-gradient(circle at 12% 78%, var(--color-red) 0 0.34rem, transparent 0.36rem),
      radial-gradient(circle at 78% 36%, var(--color-red) 0 0.34rem, transparent 0.36rem);
    clip-path: polygon(0 100%, 13% 56%, 27% 78%, 42% 34%, 58% 66%, 76% 20%, 100% 100%);
    content: "";
  }

  .closing-copy h2 {
    max-width: 31rem;
    font-size: clamp(2rem, 3.8vw, 3rem);
  }

  .closing-highlight {
    max-width: 37rem;
    margin: 0.35rem 0 0;
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.55rem);
    font-weight: 700;
    line-height: 1.12;
  }

  .closing-actions {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }

  .closing-actions p {
    margin: 0;
    color: var(--color-heading);
    line-height: 1.62;
  }

  .closing-secondary {
    color: var(--color-blue-dark);
    font-size: 0.9rem;
    font-weight: 900;
  }

  .closing-secondary:hover,
  .closing-secondary:focus-visible {
    color: var(--color-blue);
  }

  .social-links {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    padding-top: 1.3rem;
    border-top: 1px solid rgba(11, 47, 85, 0.1);
  }

  .social-links a {
    display: grid;
    width: 2.45rem;
    height: 2.45rem;
    place-items: center;
    border: 1px solid rgba(11, 47, 85, 0.15);
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: var(--color-blue-dark);
    box-shadow: var(--shadow-sm);
  }

  .social-links a:hover,
  .social-links a:focus-visible {
    color: var(--color-blue);
    border-color: rgba(0, 85, 164, 0.32);
  }

  .social-icon {
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 900;
  }

  .social-icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .social-icon path,
  .social-icon rect,
  .social-icon circle {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  @media (max-width: 760px) {
    .closing-grid {
      grid-template-columns: 1fr;
    }

    .closing-actions .button {
      width: 100%;
    }
  }
</style>
