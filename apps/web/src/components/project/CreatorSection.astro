---
import { creatorProfile, creatorProfilePath } from "../../data/creator";
import { withBase } from "../../utils/paths";

const positions = [
  {
    title: "Tecnología y datos",
    text: "Experiencia en analítica, sistemas, bases de datos y automatización.",
    icon: "chart",
  },
  {
    title: "Diseño educativo",
    text: "Estructuración pedagógica de contenidos, rutas y recursos.",
    icon: "book",
  },
  {
    title: "Francés en primera persona",
    text: "Aprendizaje real del idioma, cultura, comunicación y preparación DELF.",
    icon: "chat",
  },
  {
    title: "Visión del proyecto",
    text: "Una plataforma A1-C1 útil, clara, progresiva y en evolución.",
    icon: "target",
  },
];

const professionalActions = [
  { label: "Ver perfil profesional", href: creatorProfilePath, primary: true },
  { label: "LinkedIn", href: creatorProfile.linkedinUrl },
  { label: "GitHub", href: creatorProfile.githubUrl },
  { label: "Contactar", href: creatorProfile.contactUrl },
];

const aboutCreatorImage = "/images/project/aldo-jara-pisconti-paris.webp";
const aboutCreatorImageAlt = "Aldo Jara Pisconti frente a la Torre Eiffel en París";
---

<section id="creador" class="creator-section" aria-labelledby="creator-title">
  <div class="section-heading">
    <p class="eyebrow">Marca personal y visión educativa</p>
    <h2 id="creator-title">El creador detrás del proyecto</h2>
  </div>

  <div class="creator-layout">
    <article class="creator-card">
      <div class="creator-portrait">
        <img
          src={withBase(aboutCreatorImage)}
          alt={aboutCreatorImageAlt}
          width="640"
          height="720"
          loading="lazy"
        />
      </div>

      <div class="creator-copy">
        <h3>{creatorProfile.name}</h3>
        <p class="creator-descriptor">{creatorProfile.professionalDescriptor}</p>
        <p>{creatorProfile.shortBio}</p>
        <p class="creator-signature">Merci et à bientôt !</p>
      </div>
    </article>

    <div class="position-grid" aria-label="Áreas de posicionamiento profesional">
      {
        positions.map((item) => (
          <article class={`position-card position-${item.icon}`}>
            <span class="position-icon" aria-hidden="true">
              {item.icon === "chart" && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M5 19V9M12 19V5M19 19v-7" />
                  <path d="M4 19h16" />
                </svg>
              )}
              {item.icon === "book" && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M5 5c3-.7 5.3-.3 7 1.2V19c-1.7-1.5-4-1.9-7-1.2z" />
                  <path d="M19 5c-3-.7-5.3-.3-7 1.2V19c1.7-1.5 4-1.9 7-1.2z" />
                </svg>
              )}
              {item.icon === "chat" && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M5 7.5A7 7 0 0 1 12 4h1a7 7 0 0 1 3.6 13l.4 3-3.2-1.7c-.6.1-1.2.2-1.8.2h-1A7 7 0 0 1 5 7.5Z" />
                  <path d="M9 11h.01M12 11h.01M15 11h.01" />
                </svg>
              )}
              {item.icon === "target" && (
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M12 20a8 8 0 1 0-8-8" />
                  <path d="M12 16a4 4 0 1 0-4-4" />
                  <path d="M12 12l7-7M17 5h2v2" />
                </svg>
              )}
            </span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="creator-actions" aria-label="Presencia profesional">
    <span>Mi presencia profesional</span>
    {
      professionalActions.map((action) =>
        action.href ? (
          <a
            class:list={["creator-action", { "creator-action-primary": action.primary }]}
            href={withBase(action.href)}
          >
            {action.label}
            {action.primary && <span aria-hidden="true">→</span>}
          </a>
        ) : (
          <span class="creator-action creator-action-disabled" aria-disabled="true">
            {action.label}
          </span>
        ),
      )
    }
  </div>
</section>

<style>
  .creator-section {
    display: grid;
    gap: 1rem;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 3vw, 2.55rem);
  }

  .section-heading h2::after {
    display: block;
    width: 4.2rem;
    height: 2px;
    margin-top: 0.62rem;
    background: var(--color-gold);
    content: "";
  }

  .creator-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    gap: 1rem;
    align-items: stretch;
  }

  .creator-card,
  .position-grid,
  .creator-actions {
    border: 1px solid rgba(11, 47, 85, 0.14);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.84);
    box-shadow: var(--shadow-sm);
  }

  .creator-card {
    display: grid;
    grid-template-columns: minmax(13rem, 0.48fr) minmax(0, 0.52fr);
    gap: 1rem;
    align-items: center;
    overflow: hidden;
    padding: 0.9rem;
  }

  .creator-portrait {
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: #eef5fc;
  }

  .creator-portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 9;
    object-fit: cover;
  }

  .creator-copy {
    padding: 0.5rem 0.6rem;
  }

  .creator-copy h3 {
    font-size: clamp(1.6rem, 3vw, 2.25rem);
  }

  .creator-descriptor {
    margin: 0.45rem 0 0.85rem;
    color: #9a5d00;
    font-size: 0.82rem;
    font-weight: 800;
  }

  .creator-copy p:not(.creator-descriptor) {
    color: var(--color-heading);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .creator-signature {
    margin: 0.95rem 0 0;
    color: var(--color-blue-dark);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 1.75rem) !important;
    font-style: italic;
  }

  .position-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    padding: 1rem;
    background:
      linear-gradient(150deg, rgba(255, 255, 255, 0.95), rgba(249, 246, 239, 0.75)),
      var(--color-surface);
  }

  .position-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    min-height: 7.2rem;
    padding: 0.9rem;
    border: 1px solid rgba(11, 47, 85, 0.12);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.78);
  }

  .position-icon {
    display: grid;
    width: 2.45rem;
    height: 2.45rem;
    place-items: center;
    border-radius: 50%;
    background: rgba(0, 85, 164, 0.08);
    color: var(--color-blue-dark);
  }

  .position-book .position-icon {
    color: var(--color-gold);
  }

  .position-chat .position-icon {
    color: #128043;
  }

  .position-target .position-icon {
    color: #6337c7;
  }

  .position-icon svg {
    width: 1.35rem;
    height: 1.35rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .position-card h3 {
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 900;
  }

  .position-card p {
    margin: 0.28rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    line-height: 1.45;
  }

  .creator-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    padding: 1rem;
  }

  .creator-actions > span:first-child {
    margin-right: auto;
    color: var(--color-heading);
    font-size: 0.86rem;
    font-weight: 900;
  }

  .creator-action {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-width: 8.2rem;
    padding: 0.6rem 1rem;
    border: 1px solid rgba(11, 47, 85, 0.35);
    border-radius: var(--radius-sm);
    color: var(--color-heading);
    font-size: 0.86rem;
    font-weight: 900;
  }

  .creator-action-primary {
    border-color: transparent;
    background: var(--color-blue-dark);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .creator-action:not(.creator-action-disabled):hover,
  .creator-action:not(.creator-action-disabled):focus-visible {
    border-color: var(--color-blue);
    color: var(--color-blue);
  }

  .creator-action-primary:hover,
  .creator-action-primary:focus-visible {
    background: var(--color-blue);
    color: #ffffff !important;
  }

  .creator-action-disabled {
    cursor: not-allowed;
    opacity: 0.52;
  }

  @media (max-width: 1060px) {
    .creator-layout,
    .creator-card {
      grid-template-columns: 1fr;
    }

    .creator-portrait {
      max-width: 22rem;
    }
  }

  @media (max-width: 680px) {
    .position-grid {
      grid-template-columns: 1fr;
    }

    .creator-actions > span:first-child,
    .creator-action {
      width: 100%;
    }
  }
</style>
