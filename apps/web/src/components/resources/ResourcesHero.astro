---
import ResourceIcon from "./ResourceIcon.astro";
---

<section class="resources-hero" aria-labelledby="resources-hero-title">
  <div class="container resources-hero-grid">
    <div class="resources-hero-copy">
      <p class="resources-eyebrow">RECURSOS PARA APRENDER Y PROGRESAR</p>
      <h1 id="resources-hero-title">
        Todos los recursos que necesitas, organizados para ti.
      </h1>
      <p>
        Audios, guías, fichas de práctica, transcripciones, mapas visuales y
        más materiales para aprender francés de manera eficaz, a tu ritmo y en
        contexto.
      </p>

      <form class="hero-search" role="search" data-resource-search-form>
        <label class="visually-hidden" for="resource-search">Buscar recursos</label>
        <input
          id="resource-search"
          name="q"
          type="search"
          placeholder="Buscar recursos..."
          autocomplete="off"
          data-resource-search
        />
        <button type="submit" aria-label="Buscar recursos">
          <ResourceIcon name="search" />
        </button>
      </form>

      <button class="button button-primary hero-catalog-button" type="button" data-clear-and-scroll>
        Explorar todos los recursos
      </button>
    </div>

    <div class="resources-paris-visual" aria-hidden="true">
      <svg viewBox="0 0 420 360" focusable="false">
        <path class="wash" d="M78 224c31-68 82-96 153-82 58 12 98 47 119 106-75 44-164 48-272-24Z" />
        <path class="cloud" d="M58 118c8-19 34-20 43-2 13-5 29 4 33 18H34c2-10 10-16 24-16Z" />
        <path class="cloud" d="M304 105c7-15 27-16 35-2 11-3 22 5 25 16h-77c2-8 8-13 17-14Z" />
        <path class="tower" d="M276 38 226 317M276 38l52 279M247 145h60M237 210h82M216 314h124M256 84h39M247 145l68 172M307 145l-66 172M266 67h22M257 112h38M242 195h72M231 258h96" />
        <path class="city" d="M14 307c41-22 77-24 110-7 27-25 58-28 94-8 43-20 93-18 151 5" />
        <path class="city" d="M34 318h344M62 303v-60l26-24 26 24v60M75 274h25M140 303v-44h46v44M154 282h19M344 304v-35h30v35" />
        <path class="plane" d="M74 54 130 34l-22 49-9-21-25-8Z" />
        <path class="trail" d="M71 65c-28 9-45 25-51 49" />
      </svg>
    </div>

    <aside class="explore-panel" aria-labelledby="explore-panel-title">
      <h2 id="explore-panel-title">Explora a tu manera</h2>

      <div class="explore-options">
        <button type="button" data-focus-filter="levels">
          <span><ResourceIcon name="layers" /></span>
          <strong>Por nivel</strong>
          <small>A1 a C1</small>
        </button>
        <button type="button" data-focus-filter="competencies">
          <span><ResourceIcon name="nodes" /></span>
          <strong>Por competencia</strong>
          <small>4 competencias</small>
        </button>
        <button type="button" data-focus-filter="formats">
          <span><ResourceIcon name="clipboard" /></span>
          <strong>Por formato</strong>
          <small>Tipos disponibles</small>
        </button>
        <button type="button" data-focus-filter="topics">
          <span><ResourceIcon name="book" /></span>
          <strong>Por tema</strong>
          <small>Vocabulario, gramática y más</small>
        </button>
        <button type="button" data-topic-shortcut="viajes-cultura">
          <span><ResourceIcon name="plane" /></span>
          <strong>Para viajar</strong>
          <small>Situaciones reales y prácticas</small>
        </button>
        <button type="button" data-topic-shortcut="delf">
          <span><ResourceIcon name="badge" /></span>
          <strong>Para el DELF</strong>
          <small>Preparación por pruebas</small>
        </button>
      </div>

      <p><ResourceIcon name="spark" /> Nuevos recursos progresivamente</p>
    </aside>
  </div>
</section>

<style>
  .resources-hero {
    position: relative;
    overflow: hidden;
    padding-block: 3rem 1.5rem;
    background:
      radial-gradient(circle at 52% 28%, rgba(184, 134, 11, 0.09), transparent 19rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(247, 244, 237, 0.24)),
      var(--color-bg);
  }

  .resources-hero-grid {
    display: grid;
    grid-template-columns: minmax(17rem, 0.95fr) minmax(17rem, 0.9fr) minmax(21rem, 1fr);
    gap: 1.35rem;
    align-items: center;
  }

  .resources-hero-copy {
    display: grid;
    gap: 0.9rem;
  }

  .resources-eyebrow {
    margin: 0;
    color: var(--color-gold);
    font-size: 0.74rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    line-height: 1.25;
  }

  .resources-hero h1 {
    max-width: 13ch;
    font-size: clamp(2.15rem, 4.4vw, 4rem);
    line-height: 1.02;
  }

  .resources-hero-copy > p:not(.resources-eyebrow) {
    max-width: 34rem;
    margin: 0;
    color: var(--color-heading);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .hero-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    width: min(100%, 25rem);
    min-height: 3rem;
    margin-top: 0.15rem;
    overflow: hidden;
    border: 1px solid rgba(11, 47, 85, 0.18);
    border-radius: 999px;
    background: #ffffff;
    box-shadow: var(--shadow-sm);
  }

  .hero-search:focus-within {
    outline: 3px solid rgba(184, 134, 11, 0.28);
    outline-offset: 3px;
  }

  .hero-search input {
    min-height: 3rem;
    width: 100%;
    border: 0;
    padding-inline: 1.05rem 0.35rem;
    background: transparent;
    color: var(--color-heading);
    outline: 0;
  }

  .hero-search button {
    --resource-icon-size: 1.15rem;

    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 0;
    background: transparent;
    color: var(--color-blue-dark);
    cursor: pointer;
  }

  .hero-catalog-button {
    justify-self: start;
    border-radius: 999px;
  }

  .resources-paris-visual {
    min-width: 0;
    color: var(--color-blue-dark);
    opacity: 0.68;
  }

  .resources-paris-visual svg {
    width: 100%;
    min-height: 18rem;
  }

  .resources-paris-visual path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .wash {
    fill: rgba(184, 134, 11, 0.1);
    stroke: none;
  }

  .cloud {
    opacity: 0.22;
    stroke-width: 1.2;
  }

  .tower {
    stroke-width: 1.9;
  }

  .city {
    opacity: 0.46;
    stroke-width: 1.25;
  }

  .plane,
  .trail {
    color: var(--color-gold);
    stroke-width: 1.5;
  }

  .trail {
    stroke-dasharray: 6 8;
  }

  .explore-panel {
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--color-blue-dark);
    color: #ffffff;
    box-shadow: var(--shadow-md);
  }

  .explore-panel h2 {
    padding: 1.3rem 1.35rem 0;
    color: #ffffff;
    font-size: 1.18rem;
  }

  .explore-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    padding: 1rem 1rem 1.1rem;
  }

  .explore-options button {
    display: grid;
    min-height: 8rem;
    align-content: start;
    gap: 0.35rem;
    padding: 0.82rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.025);
    color: #ffffff;
    cursor: pointer;
    text-align: left;
  }

  .explore-options button:hover,
  .explore-options button:focus-visible {
    background: rgba(255, 255, 255, 0.09);
  }

  .explore-options span {
    --resource-icon-size: 1.2rem;

    display: grid;
    width: 2.2rem;
    height: 2.2rem;
    place-items: center;
    border-radius: 999px;
    background: #ffffff;
    color: var(--color-blue-dark);
  }

  .explore-options strong {
    margin-top: 0.18rem;
    font-size: 0.76rem;
    line-height: 1.2;
  }

  .explore-options small {
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .explore-panel p {
    --resource-icon-size: 1rem;

    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
    padding: 0.85rem 1.35rem;
    border-top: 1px solid rgba(11, 47, 85, 0.12);
    background: #ffffff;
    color: var(--color-heading);
    font-size: 0.78rem;
    font-weight: 800;
  }

  .explore-panel p :global(svg) {
    color: var(--color-gold);
  }

  @media (max-width: 960px) {
    .resources-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(21rem, 0.9fr);
    }

    .resources-paris-visual {
      grid-column: 1 / -1;
      grid-row: 2;
      max-width: 34rem;
      justify-self: center;
    }
  }

  @media (max-width: 780px) {
    .resources-hero {
      padding-block: 2.35rem 1.2rem;
    }

    .resources-hero-grid {
      grid-template-columns: 1fr;
    }

    .resources-hero h1 {
      max-width: 12.5ch;
      font-size: clamp(2rem, 9vw, 2.72rem);
    }

    .hero-search,
    .hero-catalog-button {
      width: 100%;
    }

    .hero-catalog-button {
      justify-self: stretch;
    }

    .resources-paris-visual {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .explore-options {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
