---
import ResourceIcon from "./ResourceIcon.astro";
import {
  topicFilters,
  type ResourceTopicId,
} from "../../data/resourcesCatalog";

interface Props {
  counts: Record<ResourceTopicId, number>;
}

const { counts } = Astro.props;
---

<section class="topic-section container" aria-labelledby="topic-title">
  <h2 id="topic-title">Recursos por tema</h2>

  <ul class="topic-grid">
    {
      topicFilters.map((topic) => (
        <li>
          <button
            type="button"
            class="topic-card"
            data-filter-shortcut="topic"
            data-filter-value={topic.id}
          >
            <ResourceIcon name={topic.icon} />
            <span>
              <strong>{topic.label}</strong>
              <small>
                {(counts[topic.id] ?? 0) > 0
                  ? `${counts[topic.id]} ${(counts[topic.id] ?? 0) === 1 ? "recurso" : "recursos"}`
                  : "Próximamente"}
              </small>
            </span>
          </button>
        </li>
      ))
    }
    <li>
      <button type="button" class="topic-card topic-card-all" data-clear-and-scroll>
        <span>
          <strong>Ver todos los temas</strong>
          <small>Mostrar catálogo completo</small>
        </span>
        <ResourceIcon name="arrow" />
      </button>
    </li>
  </ul>
</section>

<style>
  .topic-section {
    display: grid;
    gap: 0.85rem;
    padding-block: 1rem 1.1rem;
  }

  .topic-section h2 {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
  }

  .topic-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0.8rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .topic-card {
    --resource-icon-size: 1.55rem;

    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    width: 100%;
    min-height: 5.1rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: var(--color-heading);
    cursor: pointer;
    text-align: left;
    box-shadow: var(--shadow-sm);
  }

  .topic-card:hover,
  .topic-card:focus-visible {
    border-color: rgba(0, 85, 164, 0.3);
    background: #eef5fc;
  }

  .topic-card :global(svg) {
    color: var(--color-blue-dark);
  }

  .topic-card span {
    display: grid;
    gap: 0.18rem;
  }

  .topic-card strong {
    font-size: 0.72rem;
    line-height: 1.25;
  }

  .topic-card small {
    color: var(--color-text-muted);
    font-size: 0.62rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .topic-card-all {
    color: var(--color-blue-dark);
  }

  @media (max-width: 1180px) {
    .topic-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .topic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .topic-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
