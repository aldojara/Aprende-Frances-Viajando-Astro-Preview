---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {
    name === "search" && (
      <>
        <circle cx="11" cy="11" r="6" />
        <path d="m16 16 4 4" />
      </>
    )
  }
  {
    name === "headphones" && (
      <>
        <path d="M4 13a8 8 0 0 1 16 0" />
        <path d="M4 13v4a2 2 0 0 0 2 2h1v-7H6a2 2 0 0 0-2 2" />
        <path d="M20 13v4a2 2 0 0 1-2 2h-1v-7h1a2 2 0 0 1 2 2" />
      </>
    )
  }
  {
    name === "book" && (
      <>
        <path d="M4 5.5c2.6-.8 5-.35 8 1.5v12c-3-1.85-5.4-2.3-8-1.5z" />
        <path d="M20 5.5c-2.6-.8-5-.35-8 1.5v12c3-1.85 5.4-2.3 8-1.5z" />
        <path d="M12 7v12" />
      </>
    )
  }
  {
    name === "users" && (
      <>
        <path d="M8 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8" />
        <path d="M16.5 12a3.3 3.3 0 1 0 0-6.6" />
        <path d="M2.5 20a5.5 5.5 0 0 1 11 0" />
        <path d="M14.5 20a4.6 4.6 0 0 1 7 0" />
      </>
    )
  }
  {
    name === "pen" && (
      <>
        <path d="m4 20 4.5-1 10-10a2.8 2.8 0 0 0-4-4l-10 10z" />
        <path d="m13.5 6.5 4 4" />
      </>
    )
  }
  {
    name === "file" && (
      <>
        <path d="M7 3h7l3 3v15H7z" />
        <path d="M14 3v4h4" />
        <path d="M9.5 11h5" />
        <path d="M9.5 15h5" />
      </>
    )
  }
  {
    name === "document" && (
      <>
        <path d="M6 3h9l3 3v15H6z" />
        <path d="M15 3v4h4" />
        <path d="M9 11h6" />
        <path d="M9 14h6" />
        <path d="M9 17h4" />
      </>
    )
  }
  {
    name === "clipboard" && (
      <>
        <path d="M9 4h6l1 2h3v15H5V6h3z" />
        <path d="M9 4h6v3H9z" />
        <path d="m8 12 1.6 1.6L13 10.2" />
        <path d="M15 13h2" />
        <path d="m8 17 1.6 1.6L13 15.2" />
        <path d="M15 18h2" />
      </>
    )
  }
  {
    name === "nodes" && (
      <>
        <circle cx="6" cy="6" r="2.4" />
        <circle cx="18" cy="7" r="2.4" />
        <circle cx="12" cy="18" r="2.4" />
        <path d="M8.2 7.2 15.8 6.8" />
        <path d="M7.3 8.1 10.8 16" />
        <path d="M16.8 8.8 13.2 16" />
      </>
    )
  }
  {
    name === "video" && (
      <>
        <path d="M5 6h10a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H5z" />
        <path d="m10 9 4 3-4 3z" />
      </>
    )
  }
  {
    name === "layout" && (
      <>
        <path d="M4 5h16v14H4z" />
        <path d="M4 10h16" />
        <path d="M10 10v9" />
      </>
    )
  }
  {
    name === "checklist" && (
      <>
        <path d="M7 4h10v17H7z" />
        <path d="m9 9 1 1 2-2" />
        <path d="M14 9h1.5" />
        <path d="m9 14 1 1 2-2" />
        <path d="M14 14h1.5" />
      </>
    )
  }
  {
    name === "cards" && (
      <>
        <path d="M8 5h10v13H8z" />
        <path d="M6 7v13h10" />
        <path d="M10.5 10h5" />
        <path d="M10.5 13h3.5" />
      </>
    )
  }
  {
    name === "mic" && (
      <>
