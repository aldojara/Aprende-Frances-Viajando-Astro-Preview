        <path d="M12 16v4" />
      </>
    )
  }
  {
    name === "badge" && (
      <>
        <circle cx="12" cy="9" r="5" />
        <path d="m9 14-1 6 4-2 4 2-1-6" />
      </>
    )
  }
  {
    name === "target" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="12" cy="12" r="1" />
      </>
    )
  }
  {
    name === "ear" && (
      <>
        <path d="M8 10a4 4 0 1 1 8 0c0 4-4 4.5-4 8" />
        <path d="M10.5 10a1.5 1.5 0 1 1 3 0c0 1.5-1.5 2-2 3" />
      </>
    )
  }
  {
    name === "plane" && (
      <>
        <path d="m3 11 18-7-7 18-3-8z" />
        <path d="m21 4-10 10" />
      </>
    )
  }
  {
    name === "briefcase" && (
      <>
        <path d="M5 8h14v11H5z" />
        <path d="M9 8V6h6v2" />
        <path d="M5 13h14" />
      </>
    )
  }
  {
    name === "layers" && (
      <>
        <path d="m12 3 8 4-8 4-8-4z" />
        <path d="m4 12 8 4 8-4" />
        <path d="m4 17 8 4 8-4" />
      </>
    )
  }
  {
    name === "spark" && (
      <>
        <path d="M12 3v5" />
        <path d="M12 16v5" />
        <path d="M3 12h5" />
        <path d="M16 12h5" />
        <path d="m6 6 3 3" />
        <path d="m15 15 3 3" />
        <path d="m18 6-3 3" />
        <path d="m9 15-3 3" />
      </>
    )
  }
  {
    name === "arrow" && (
      <>
        <path d="M5 12h14" />
        <path d="m13 6 6 6-6 6" />
      </>
    )
  }
</svg>

<style>
  svg {
    width: var(--resource-icon-size, 1.25rem);
    height: var(--resource-icon-size, 1.25rem);
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.75;
  }
</style>
