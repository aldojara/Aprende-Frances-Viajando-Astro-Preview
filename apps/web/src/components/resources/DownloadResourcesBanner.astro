---
import ResourceIcon from "./ResourceIcon.astro";

interface Props {
  downloadableCount: number;
}

const { downloadableCount } = Astro.props;
const hasDownloads = downloadableCount > 0;
---

<section class="download-banner container" aria-labelledby="download-banner-title">
  <div class="luggage-illustration" aria-hidden="true">
    <svg viewBox="0 0 220 120" focusable="false">
      <path class="spark" d="M20 24v10M15 29h10M184 18v9M179.5 22.5h9" />
      <path class="case" d="M48 38h78a11 11 0 0 1 11 11v50H37V49a11 11 0 0 1 11-11Z" />
      <path class="case" d="M65 38v-8h44v8M59 47v52M115 47v52" />
      <path class="passport" d="M126 50h44v58h-44z" />
      <path class="passport" d="M138 68h20M138 82h20" />
      <path class="plane" d="m172 47 34-13-13 34-6-15z" />
      <path class="trail" d="M153 89c28-8 48-22 60-43" />
    </svg>
  </div>

  <div class="download-copy">
    <h2 id="download-banner-title">Recursos para aprender en cualquier lugar</h2>
    <p>
      Descarga guías, audios y fichas para estudiar sin conexión, en tus viajes
      o cuando prefieras.
    </p>
  </div>

  {
    hasDownloads ? (
      <button class="download-action" type="button" data-downloadable-shortcut>
        Ver recursos descargables
        <ResourceIcon name="arrow" />
      </button>
    ) : (
      <button class="download-action download-action-disabled" type="button" disabled aria-describedby="download-state">
        Próximamente: recursos descargables
      </button>
    )
  }
  {!hasDownloads && <p id="download-state" class="visually-hidden">Aún no existen descargas finales enlazadas en el catálogo.</p>}
</section>

<style>
  .download-banner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1.35rem;
    align-items: center;
    overflow: hidden;
    margin-block: 0.9rem 1.3rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background:
      radial-gradient(circle at 18% 20%, rgba(184, 134, 11, 0.18), transparent 12rem),
      var(--color-blue-dark);
    color: #ffffff;
  }

  .luggage-illustration {
    width: min(10.5rem, 24vw);
    color: #ffffff;
  }

  .luggage-illustration svg {
    width: 100%;
  }

  .luggage-illustration path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .case {
    fill: rgba(184, 134, 11, 0.22);
    stroke-width: 2;
  }

  .passport {
    fill: rgba(255, 255, 255, 0.1);
    stroke-width: 1.7;
  }

  .plane,
  .trail,
  .spark {
    color: var(--color-gold);
    stroke-width: 1.5;
  }

  .trail {
    stroke-dasharray: 6 7;
  }

  .download-copy h2 {
    color: #ffffff;
    font-size: clamp(1.35rem, 2.4vw, 1.8rem);
  }

  .download-copy p {
    max-width: 38rem;
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: 0.92rem;
    line-height: 1.52;
  }

  .download-action {
    --resource-icon-size: 1rem;

    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    padding: 0.72rem 1.2rem;
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    background: transparent;
    color: #ffd67a;
    cursor: pointer;
    font-weight: 900;
    white-space: nowrap;
  }

  .download-action:hover,
  .download-action:focus-visible {
    background: rgba(255, 255, 255, 0.08);
  }

  .download-action-disabled {
    cursor: not-allowed;
    opacity: 0.78;
  }

  @media (max-width: 820px) {
    .download-banner {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .luggage-illustration {
      width: 9rem;
    }

    .download-action {
      width: 100%;
      white-space: normal;
    }
  }
</style>
