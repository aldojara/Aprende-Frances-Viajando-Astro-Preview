---
import ResourceIcon from "./ResourceIcon.astro";
import { formatCategories, type ResourceFormatCategoryId } from "../../data/resourcesCatalog";

interface Props {
  counts: Record<ResourceFormatCategoryId, number>;
}

const { counts } = Astro.props;
---

<section class="resources-section format-section" aria-labelledby="format-section-title">
  <div class="container">
    <h2 id="format-section-title">Explora por formato</h2>
    <ul class="format-grid" aria-label="Formatos de recursos">
      {
        formatCategories.map((format) => {
          const count = counts[format.id] ?? 0;
          return (
            <li>
              <button
                type="button"
                class="format-card"
                data-filter-shortcut="format"
                data-filter-value={format.id}
                aria-pressed="false"
              >
                <ResourceIcon name={format.icon} />
                <strong>{format.label}</strong>
                <span>{count > 0 ? `${count} ${count === 1 ? "recurso" : "recursos"}` : "Próximamente"}</span>
              </button>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .format-section {
    padding-block: 1.15rem 1.35rem;
  }

  .format-section .container {
    display: grid;
    gap: 0.85rem;
  }

  .format-section h2 {
    font-size: clamp(1.42rem, 2.2vw, 1.82rem);
  }

  .format-grid {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: 0.65rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .format-card {
    --resource-icon-size: 1.65rem;

    display: grid;
    min-height: 7.2rem;
    width: 100%;
    align-content: center;
    justify-items: center;
    gap: 0.42rem;
    padding: 0.7rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: #ffffff;
    color: var(--color-heading);
    cursor: pointer;
    text-align: center;
    box-shadow: var(--shadow-sm);
  }

  .format-card:hover,
  .format-card:focus-visible,
  .format-card.is-selected {
    border-color: rgba(0, 85, 164, 0.35);
    background: #eef5fc;
  }

  .format-card :global(svg) {
    color: var(--color-blue-dark);
  }

  .format-card strong {
    font-size: 0.69rem;
    line-height: 1.25;
  }

  .format-card span {
    color: var(--color-text-muted);
    font-size: 0.6rem;
    font-weight: 800;
    line-height: 1.2;
  }

  @media (max-width: 1180px) {
    .format-grid {
      display: flex;
      gap: 0.7rem;
      overflow-x: auto;
      padding-bottom: 0.4rem;
      scroll-padding-inline: 1rem;
      scrollbar-width: thin;
    }

    .format-grid > li {
      flex: 0 0 7.25rem;
    }
  }

  @media (max-width: 520px) {
    .format-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
    }

    .format-grid > li {
      flex: none;
    }
  }
</style>
