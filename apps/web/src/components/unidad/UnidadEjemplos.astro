---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  ejemplos?: Unidad["ejemplos"];
}

const { ejemplos } = Astro.props;
if (!ejemplos || !ejemplos.items || ejemplos.items.length === 0) return null;
---

<section class="u-seccion u-ejemplos" id="ejemplos" aria-labelledby="ejemplos-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Historia de viaje en contexto real</p>
    <h2 id="ejemplos-titulo" class="u-seccion-titulo">
      {ejemplos.titulo || "Ejemplos en contexto"}
    </h2>
    {ejemplos.intro && <p class="u-seccion-sub">{ejemplos.intro}</p>}
  </div>

  <div class="u-tabla-ejemplos-card">
    <div class="u-tabla-ejemplos-head">
      <span class="u-th-num">#</span>
      <span class="u-th-fr">Francés</span>
      <span class="u-th-es">Español</span>
      <span class="u-th-nota">Nota</span>
    </div>

    <div class="u-tabla-ejemplos-body">
      {
        ejemplos.items.map((item, index) => (
          <article class="u-ejemplo-fila">
            <span class="u-fila-num">{index + 1}</span>

            <div class="u-fila-fr-col">
              <p class="u-fila-fr" lang="fr">
                {item.fr}
              </p>
            </div>

            <div class="u-fila-es-col">
              <p class="u-fila-es">{item.es}</p>
            </div>

            <div class="u-fila-nota-col">
              {item.nota ? (
                <details class="u-ejemplo-nota-details" open>
                  <summary class="u-nota-toggle">
                    <span class="u-nota-tag">Nota</span>
                    <span class="u-nota-arrow" aria-hidden="true">▾</span>
                  </summary>
                  <div class="u-nota-body">
                    <span class="u-nota-texto">{item.nota}</span>
                  </div>
                </details>
              ) : (
                <span class="u-nota-vacia">—</span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.25rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.45rem, 2.8vw, 1.9rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.35rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 0.95rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.5;
  }

  .u-tabla-ejemplos-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    box-shadow: 0 2px 8px rgba(11, 47, 85, 0.04);
    overflow: hidden;
  }

  .u-tabla-ejemplos-head {
    display: grid;
    grid-template-columns: 2.2rem 1.2fr 1fr auto;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-surface-soft, #efede8);
    border-bottom: 2px solid var(--color-border, #e2ded7);
    font-size: 0.76rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #6d6861);
  }

  .u-th-fr {
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-tabla-ejemplos-body {
    display: flex;
    flex-direction: column;
  }

  .u-ejemplo-fila {
    display: grid;
    grid-template-columns: 2.2rem 1.2fr 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.55rem 0.85rem;
    border-bottom: 1px solid var(--color-border, #e2ded7);
    transition: background 0.15s ease;
  }

  .u-ejemplo-fila:last-child {
    border-bottom: 0;
  }

  .u-ejemplo-fila:nth-child(even) {
    background: rgba(247, 244, 237, 0.4);
  }

  .u-ejemplo-fila:hover {
    background: rgba(240, 212, 138, 0.1);
  }

  .u-fila-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(0, 85, 164, 0.08);
    color: var(--color-blue, #0055a4);
    font-size: 0.74rem;
    font-weight: 800;
  }

  .u-fila-fr-col,
  .u-fila-es-col {
    min-width: 0;
  }

  .u-fila-fr {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.4;
  }

  .u-fila-es {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text, #2e2b27);
    line-height: 1.4;
  }

  .u-fila-nota-col {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  .u-ejemplo-nota-details {
    position: relative;
  }

  .u-nota-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: rgba(184, 134, 11, 0.12);
    border: 1px solid rgba(184, 134, 11, 0.3);
    color: #8b6508;
    font-size: 0.72rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
    user-select: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .u-nota-toggle::-webkit-details-marker {
    display: none;
  }

  .u-nota-toggle:hover {
    background: rgba(184, 134, 11, 0.22);
  }

  .u-nota-arrow {
    font-size: 0.75rem;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .u-ejemplo-nota-details[open] .u-nota-arrow {
    transform: rotate(180deg);
  }

  .u-nota-body {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    z-index: 10;
    min-width: 200px;
    max-width: 280px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-left: 3px solid var(--color-gold, #b8860b);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.5rem 0.75rem;
    box-shadow: 0 6px 18px rgba(11, 47, 85, 0.12);
  }

  .u-nota-texto {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--color-text, #2e2b27);
    display: block;
  }

  .u-nota-vacia {
    color: var(--color-border, #e2ded7);
    font-size: 0.8rem;
    padding-right: 0.5rem;
  }

  @media (max-width: 640px) {
    .u-tabla-ejemplos-head {
      display: none;
    }

    .u-seccion-header {
      margin-bottom: 0.75rem;
    }

    .u-ejemplo-fila {
      grid-template-columns: 1.6rem 1fr auto;
      grid-template-areas:
        "num fr nota"
        "num es es";
      gap: 0.2rem 0.5rem;
      padding: 0.45rem 0.6rem;
      align-items: start;
    }

    .u-fila-num {
      grid-area: num;
      align-self: flex-start;
      margin-top: 0.15rem;
      width: 20px;
      height: 20px;
      font-size: 0.7rem;
    }

    .u-fila-fr-col {
      grid-area: fr;
    }

    .u-fila-fr {
      font-size: 0.88rem;
      line-height: 1.35;
    }

    .u-fila-es-col {
      grid-area: es;
    }

    .u-fila-es {
      font-size: 0.82rem;
      line-height: 1.35;
    }

    .u-fila-nota-col {
      grid-area: nota;
      justify-content: flex-end;
      margin-top: 0;
    }

    .u-nota-toggle {
      padding: 0.12rem 0.45rem;
      font-size: 0.68rem;
    }

    .u-nota-body {
      position: absolute;
      right: 0;
      top: calc(100% + 4px);
      min-width: 200px;
      max-width: 280px;
      margin-top: 0;
      z-index: 20;
    }
  }
</style>
