---
import type { Unidad } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  relacionados?: Unidad["relacionados"];
}

const { relacionados } = Astro.props;
if (!relacionados || relacionados.length === 0) return null;
---

<section class="u-seccion u-relacionados" id="relacionados" aria-labelledby="relacionados-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Ruta de aprendizaje</p>
    <h2 id="relacionados-titulo" class="u-seccion-titulo">Sigue aprendiendo</h2>
    <p class="u-seccion-sub">
      Profundiza en la gramática francesa y conecta con lecciones afines:
    </p>
  </div>

  <div class="u-relacionados-grid">
    {
      relacionados.map((item) => {
        const esDisponible = item.estado === "disponible";
        return esDisponible ? (
          <a class="u-rel-card u-rel-disponible" href={withBase(item.url)}>
            <div class="u-rel-top">
              <span class="u-rel-badge u-rel-badge-ok">Disponible</span>
              <span class="u-rel-icono" aria-hidden="true">
                →
              </span>
            </div>
            <h3 class="u-rel-titulo">{item.titulo}</h3>
            <span class="u-rel-cta">Ir a la lección</span>
          </a>
        ) : (
          <div class="u-rel-card u-rel-proximamente" aria-disabled="true">
            <div class="u-rel-top">
              <span class="u-rel-badge u-rel-badge-soon">Próximamente</span>
            </div>
            <h3 class="u-rel-titulo">{item.titulo}</h3>
            <span class="u-rel-cta u-rel-cta-soon">En preparación</span>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.5rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.45rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 0.98rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.5;
  }

  .u-relacionados-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.15rem;
  }

  .u-rel-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    box-shadow: 0 2px 6px rgba(11, 47, 85, 0.03);
    text-decoration: none;
    transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }

  .u-rel-disponible:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(11, 47, 85, 0.08);
    border-color: var(--color-blue, #0055a4);
  }

  .u-rel-proximamente {
    opacity: 0.65;
    background: var(--color-surface-soft, #efede8);
    cursor: not-allowed;
  }

  .u-rel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .u-rel-badge {
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .u-rel-badge-ok {
    background: rgba(0, 85, 164, 0.1);
    color: var(--color-blue, #0055a4);
  }

  .u-rel-badge-soon {
    background: rgba(109, 104, 97, 0.15);
    color: var(--color-text-muted, #6d6861);
  }

  .u-rel-icono {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-blue, #0055a4);
    transition: transform 0.16s ease;
  }

  .u-rel-disponible:hover .u-rel-icono {
    transform: translateX(3px);
  }

  .u-rel-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1.08rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.35;
    margin: 0;
  }

  .u-rel-cta {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-blue, #0055a4);
  }

  .u-rel-cta-soon {
    color: var(--color-text-muted, #6d6861);
    font-weight: 500;
  }
</style>
