---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  resumen?: Unidad["resumen"];
}

const { resumen } = Astro.props;
if (!resumen || resumen.length === 0) return null;
---

<section class="u-seccion u-resumen" id="resumen" aria-labelledby="resumen-titulo">
  <div class="u-resumen-card">
    <div class="u-resumen-header">
      <span class="u-resumen-badge">Puntos clave</span>
      <h2 id="resumen-titulo" class="u-resumen-titulo">Para recordar</h2>
    </div>

    <ol class="u-resumen-lista">
      {
        resumen.map((punto, index) => (
          <li class="u-resumen-item">
            <span class="u-resumen-num">{index + 1}</span>
            <p class="u-resumen-texto">{punto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: var(--u-scroll-margin, 9.25rem);
  }

  .u-resumen-card {
    background: #ffffff;
    border: 1px solid rgba(11, 47, 85, 0.18);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1.15rem 1.35rem;
    box-shadow: 0 4px 14px rgba(11, 47, 85, 0.04);
  }

  .u-resumen-header {
    margin-bottom: 0.85rem;
  }

  .u-resumen-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.6rem;
    background: rgba(0, 85, 164, 0.1);
    color: var(--color-blue, #0055a4);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 0.35rem;
  }

  .u-resumen-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.2;
  }

  .u-resumen-lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .u-resumen-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    background: var(--color-surface-soft, #efede8);
    border-radius: var(--radius-sm, 0.5rem);
    border: 1px solid var(--color-border, #e2ded7);
  }

  .u-resumen-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-blue-dark, #0b2f55);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .u-resumen-texto {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--color-text, #2e2b27);
  }
</style>
