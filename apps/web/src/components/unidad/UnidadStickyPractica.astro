---
import type { Unidad } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  practica?: Unidad["practica"];
  variante?: "escritorio" | "movil";
}

const { practica, variante } = Astro.props;
if (!practica) return null;

const practicaUrl = withBase(practica.url);
const esMovil = !variante || variante === "movil";
const esEscritorio = !variante || variante === "escritorio";
---

{
  esMovil && (
    <div class="u-practica-movil-bar" aria-label="Acceso directo a la práctica">
      <div class="u-practica-movil-info">
        <span class="u-practica-movil-eyebrow">Práctica guiada</span>
        <strong class="u-practica-movil-titulo">{practica.titulo}</strong>
      </div>
      <a class="u-practica-movil-btn" href={practicaUrl}>
        <span>Practicar</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  )
}

{
  esEscritorio && (
    <aside class="u-practica-desktop-card" aria-label="Acceso a la práctica interactiva">
      <div class="u-pcard-header">
        <span class="u-pcard-badge">Práctica interactiva</span>
        <h3 class="u-pcard-titulo">{practica.titulo}</h3>
      </div>
      <p class="u-pcard-desc">{practica.texto}</p>
      <a class="u-pcard-btn" href={practicaUrl}>
        <span>Practicar ahora</span>
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  )
}

<style>
  /* Barra móvil fija abajo */
  .u-practica-movil-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: #ffffff;
    border-top: 1px solid var(--color-border, #e2ded7);
    box-shadow: 0 -4px 18px rgba(11, 47, 85, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1rem;
    gap: 0.75rem;
    backdrop-filter: blur(8px);
  }

  .u-practica-movil-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .u-practica-movil-eyebrow {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-blue, #0055a4);
  }

  .u-practica-movil-titulo {
    font-size: 0.92rem;
    color: var(--color-blue-dark, #0b2f55);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .u-practica-movil-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: var(--color-gold, #b8860b);
    color: #1a1608;
    font-weight: 700;
    font-size: 0.88rem;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(184, 134, 11, 0.3);
    flex-shrink: 0;
  }

  .u-practica-movil-btn:hover {
    background: #9c7108;
    color: #ffffff;
  }

  .u-practica-movil-btn:focus-visible {
    outline: 3px solid var(--color-blue, #0055a4);
    outline-offset: 2px;
  }

  /* Tarjeta de escritorio */
  .u-practica-desktop-card {
    display: none;
  }

  @media (min-width: 1024px) {
    .u-practica-movil-bar {
      display: none;
    }

    .u-practica-desktop-card {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      background: linear-gradient(145deg, var(--color-blue-dark, #0b2f55) 0%, #071f38 100%);
      color: #ffffff;
      border: 1px solid rgba(240, 212, 138, 0.3);
      border-radius: var(--radius-md, 0.875rem);
      padding: 1.25rem 1.15rem;
      box-shadow: 0 6px 20px rgba(11, 47, 85, 0.12);
    }

    .u-pcard-header {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .u-pcard-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: #f0d48a;
    }

    .u-pcard-titulo {
      font-family: var(--font-display, "Playfair Display", Georgia, serif);
      font-size: 1.2rem;
      color: #ffffff;
      margin: 0;
      line-height: 1.25;
    }

    .u-pcard-desc {
      font-size: 0.85rem;
      color: #d1dde9;
      margin: 0;
      line-height: 1.45;
    }

    .u-pcard-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      gap: 0.45rem;
      padding: 0.48rem 1.15rem;
      border-radius: 999px;
      background: var(--color-gold, #b8860b);
      color: #1a1608;
      font-weight: 700;
      font-size: 0.84rem;
      text-decoration: none;
      box-shadow: 0 3px 10px rgba(184, 134, 11, 0.3);
      transition: all 0.16s ease;
    }

    .u-pcard-btn:hover {
      background: #9c7108;
      color: #ffffff;
      transform: translateY(-1px);
    }

    .u-pcard-btn:focus-visible {
      outline: 3px solid #ffffff;
      outline-offset: 3px;
    }
  }
</style>
