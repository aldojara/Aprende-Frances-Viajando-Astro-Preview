---
import type { Unidad } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  errores?: Unidad["errores"];
  practicaUrl?: string;
}

const { errores, practicaUrl = "/practica/avoir-o-etre/" } = Astro.props;
if (!errores || errores.length === 0) return null;
---

<section class="u-seccion u-errores" id="errores" aria-labelledby="errores-titulo">
  <div class="u-seccion-header">
    <div class="u-errores-badge-header">
      <span class="u-badge-radar">
        <span class="u-radar-punto"></span>
        Especial para hispanohablantes
      </span>
    </div>
    <h2 id="errores-titulo" class="u-seccion-titulo">Errores típicos del hispanohablante</h2>
    <p class="u-seccion-sub">
      Toca en <strong>«¿Por qué ocurre?»</strong> para ver la explicación cognitiva y practicar cada caso.
    </p>
  </div>

  <div class="u-errores-grid">
    {
      errores.map((item, idx) => (
        <article class="u-error-card" id={`error-${idx + 1}`}>
          <div class="u-error-cabeza">
            <span class="u-error-indice">Caso #{String(idx + 1).padStart(2, "0")}</span>
            {item.tipoPractica && (
              <span class="u-error-tag-tipo">Tipo {item.tipoPractica}</span>
            )}
          </div>

          <div class="u-error-comparativa">
            <div class="u-fila-mal">
              <span class="u-signo-mal" aria-hidden="true">✕</span>
              <span class="u-frase-mal" lang="fr">{item.mal}</span>
            </div>
            <div class="u-fila-bien">
              <span class="u-signo-bien" aria-hidden="true">✓</span>
              <span class="u-frase-bien" lang="fr">{item.bien}</span>
            </div>
          </div>

          <details class="u-error-details" open>
            <summary class="u-error-summary">
              <span class="u-summary-texto">¿Por qué ocurre desde el español?</span>
              <span class="u-summary-icon" aria-hidden="true">▾</span>
            </summary>
            <div class="u-error-exp-body">
              <p class="u-exp-texto">{item.porque}</p>
              {item.tipoPractica && (
                <div class="u-error-accion">
                  <a
                    class="u-btn-error-practica"
                    href={`${withBase(practicaUrl)}#practica`}
                  >
                    <span>Practicar este error</span>
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              )}
            </div>
          </details>
        </article>
      ))
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 0.85rem;
  }

  .u-errores-badge-header {
    margin-bottom: 0.35rem;
  }

  .u-badge-radar {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: rgba(185, 64, 53, 0.1);
    color: #a32f25;
    border: 1px solid rgba(185, 64, 53, 0.25);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .u-radar-punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b94035;
    box-shadow: 0 0 4px rgba(185, 64, 53, 0.6);
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.25rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 0.9rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.45;
  }

  .u-errores-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.65rem;
  }

  @media (min-width: 768px) {
    .u-errores-grid {
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
  }

  .u-error-card {
    scroll-margin-top: 5rem;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.75rem 0.85rem;
    box-shadow: 0 2px 6px rgba(11, 47, 85, 0.03);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    transition: border-color 0.16s ease;
  }

  .u-error-card:hover {
    border-color: rgba(184, 134, 11, 0.35);
  }

  .u-error-cabeza {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.25rem;
  }

  .u-error-indice {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-error-tag-tipo {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    background: var(--color-surface-soft, #efede8);
    color: var(--color-text-muted, #6d6861);
    border: 1px solid var(--color-border, #e2ded7);
  }

  .u-error-comparativa {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .u-fila-mal,
  .u-fila-bien {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    padding: 0.45rem 0.65rem;
    border-radius: 4px;
    font-size: 0.88rem;
    line-height: 1.35;
  }

  .u-fila-mal {
    background: #fbf0ee;
    border: 1px solid #f3cbc6;
    color: #9a3329;
  }

  .u-fila-bien {
    background: #edf7f1;
    border: 1px solid #bde4cb;
    color: #1e5a37;
  }

  .u-signo-mal {
    font-weight: 900;
    color: #b94035;
    flex-shrink: 0;
  }

  .u-signo-bien {
    font-weight: 900;
    color: #2e7d32;
    flex-shrink: 0;
  }

  .u-frase-mal {
    text-decoration: line-through;
    text-decoration-color: rgba(185, 64, 53, 0.6);
    font-weight: 500;
  }

  .u-frase-bien {
    font-weight: 600;
  }

  .u-error-details {
    border-top: 1px solid var(--color-border, #e2ded7);
    padding-top: 0.35rem;
  }

  .u-error-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--color-blue, #0055a4);
    padding: 0.15rem 0;
    user-select: none;
  }

  .u-error-summary::-webkit-details-marker {
    display: none;
  }

  .u-summary-icon {
    font-size: 0.85rem;
    transition: transform 0.2s ease;
  }

  .u-error-details[open] .u-summary-icon {
    transform: rotate(180deg);
  }

  .u-error-exp-body {
    padding-top: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .u-exp-texto {
    font-size: 0.84rem;
    color: var(--color-text, #2e2b27);
    line-height: 1.45;
    margin: 0;
    background: var(--color-surface-soft, #efede8);
    padding: 0.5rem 0.65rem;
    border-radius: 4px;
    border-left: 3px solid var(--color-gold, #b8860b);
  }

  .u-error-accion {
    display: flex;
    justify-content: flex-end;
  }

  .u-btn-error-practica {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--color-blue, #0055a4);
    color: var(--color-blue, #0055a4);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.16s ease;
  }

  .u-btn-error-practica:hover {
    background: var(--color-blue, #0055a4);
    color: #ffffff;
  }

  @media (max-width: 640px) {
    .u-btn-error-practica {
      width: 100%;
      justify-content: center;
    }
  }
</style>
