---
import type { Unidad } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  errores?: Unidad["errores"];
  practicaUrl?: string;
}

const { errores, practicaUrl = "/practica/avoir-o-etre/" } = Astro.props;
if (!errores || errores.length === 0) return null;
---

<section class="u-seccion u-errores" id="errores" aria-labelledby="errores-titulo">
  <div class="u-seccion-header">
    <div class="u-errores-badge-header">
      <span class="u-badge-radar">
        <span class="u-radar-punto"></span>
        Especial para hispanohablantes
      </span>
    </div>
    <h2 id="errores-titulo" class="u-seccion-titulo">Errores típicos del hispanohablante</h2>
    <p class="u-seccion-sub">
      No son fallos aleatorios: son calcos directos de cómo funciona el español. Cuando entiendes <em>por qué</em> tu mente busca esa estructura, dejas de cometer el error para siempre.
    </p>
  </div>

  <div class="u-errores-grid">
    {
      errores.map((item, idx) => (
        <article class="u-error-card">
          <div class="u-error-topbar">
            <span class="u-error-indice">Caso #{String(idx + 1).padStart(2, "0")}</span>
            {item.tipoPractica && (
              <span class="u-error-tag-tipo">Tipo {item.tipoPractica}</span>
            )}
          </div>

          <div class="u-error-comparativa">
            <!-- Bloque de error -->
            <div class="u-bloque-mal">
              <div class="u-bloque-head">
                <span class="u-signo-mal" aria-hidden="true">✕</span>
                <span class="u-bloque-rotulo">Así se dice mal</span>
              </div>
              <p class="u-bloque-frase" lang="fr">{item.mal}</p>
            </div>

            <!-- Bloque de corrección -->
            <div class="u-bloque-bien">
              <div class="u-bloque-head">
                <span class="u-signo-bien" aria-hidden="true">✓</span>
                <span class="u-bloque-rotulo">Forma correcta</span>
              </div>
              <p class="u-bloque-frase" lang="fr">{item.bien}</p>
            </div>
          </div>

          <!-- Explicación lingüística desde el español -->
          <div class="u-error-explicacion">
            <div class="u-exp-icono" aria-hidden="true">🧠</div>
            <div class="u-exp-contenido">
              <h3 class="u-exp-titulo">Por qué ocurre (desde el español)</h3>
              <p class="u-exp-texto">{item.porque}</p>
            </div>
          </div>

          {item.tipoPractica && (
            <div class="u-error-accion">
              <a
                class="u-btn-error-practica"
                href={`${withBase(practicaUrl)}#practica`}
              >
                <span>Practicar este error</span>
                <span class="u-flecha-accion" aria-hidden="true">→</span>
              </a>
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.8rem;
  }

  .u-errores-badge-header {
    margin-bottom: 0.6rem;
  }

  .u-badge-radar {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: rgba(185, 64, 53, 0.1);
    color: #a32f25;
    border: 1px solid rgba(185, 64, 53, 0.25);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .u-radar-punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #b94035;
    box-shadow: 0 0 6px rgba(185, 64, 53, 0.6);
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.7rem, 3.5vw, 2.3rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.5rem;
    line-height: 1.18;
  }

  .u-seccion-sub {
    font-size: 1.02rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.55;
    max-width: 720px;
  }

  .u-errores-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .u-error-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-lg, 1.25rem);
    padding: 1.5rem 1.6rem;
    box-shadow: 0 4px 18px rgba(11, 47, 85, 0.05);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .u-error-card:hover {
    box-shadow: 0 8px 24px rgba(11, 47, 85, 0.09);
  }

  .u-error-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border, #e2ded7);
  }

  .u-error-indice {
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-error-tag-tipo {
    font-size: 0.74rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-surface-soft, #efede8);
    color: var(--color-text-muted, #6d6861);
    border: 1px solid var(--color-border, #e2ded7);
  }

  .u-error-comparativa {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .u-bloque-mal,
  .u-bloque-bien {
    padding: 1rem 1.15rem;
    border-radius: var(--radius-md, 0.875rem);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .u-bloque-mal {
    background: #fbf0ee;
    border: 1px solid #f3cbc6;
    color: #9a3329;
  }

  .u-bloque-bien {
    background: #edf7f1;
    border: 1px solid #bde4cb;
    color: #1e5a37;
  }

  .u-bloque-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .u-signo-mal {
    font-weight: 900;
    font-size: 1rem;
    line-height: 1;
    color: #b94035;
  }

  .u-signo-bien {
    font-weight: 900;
    font-size: 1.1rem;
    line-height: 1;
    color: #2e7d32;
  }

  .u-bloque-rotulo {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .u-bloque-mal .u-bloque-rotulo {
    color: #a32f25;
  }

  .u-bloque-bien .u-bloque-rotulo {
    color: #276749;
  }

  .u-bloque-frase {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .u-bloque-mal .u-bloque-frase {
    color: #7b241c;
    text-decoration: line-through;
    text-decoration-color: rgba(185, 64, 53, 0.5);
  }

  .u-bloque-bien .u-bloque-frase {
    color: #1e5a37;
  }

  /* Explicación */
  .u-error-explicacion {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: var(--color-surface-soft, #efede8);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1rem 1.15rem;
    border: 1px solid var(--color-border, #e2ded7);
  }

  .u-exp-icono {
    font-size: 1.25rem;
    flex-shrink: 0;
    line-height: 1.3;
  }

  .u-exp-contenido {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .u-exp-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
  }

  .u-exp-texto {
    font-size: 0.94rem;
    color: var(--color-text, #2e2b27);
    line-height: 1.55;
    margin: 0;
  }

  /* Acción */
  .u-error-accion {
    display: flex;
    justify-content: flex-end;
  }

  .u-btn-error-practica {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--color-blue, #0055a4);
    color: var(--color-blue, #0055a4);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.16s ease;
  }

  .u-btn-error-practica:hover {
    background: var(--color-blue, #0055a4);
    color: #ffffff;
    transform: translateX(2px);
  }

  .u-flecha-accion {
    font-size: 1.1rem;
    line-height: 1;
    transition: transform 0.16s ease;
  }

  .u-btn-error-practica:hover .u-flecha-accion {
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .u-error-card {
      padding: 1.15rem 1.1rem;
    }

    .u-error-comparativa {
      grid-template-columns: 1fr;
      gap: 0.65rem;
    }

    .u-btn-error-practica {
      width: 100%;
      justify-content: center;
    }
  }
</style>
