---
import type { Unidad } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  captacion?: Unidad["captacion"];
}

const { captacion } = Astro.props;
if (!captacion) return null;
---

<section class="u-seccion u-captacion" id="captacion" aria-labelledby="captacion-titulo">
  <div class="u-captacion-card">
    <div class="u-captacion-icono" aria-hidden="true">📬</div>
    <div class="u-captacion-cuerpo">
      <h2 id="captacion-titulo" class="u-captacion-titulo">{captacion.titulo}</h2>
      <p class="u-captacion-texto">{captacion.texto}</p>
      <div class="u-captacion-form-wrap">
        <form class="u-captacion-form" action={withBase(captacion.url)} method="GET">
          <input
            type="email"
            name="email"
            placeholder="Tu correo electrónico"
            required
            class="u-captacion-input"
          />
          <button type="submit" class="u-captacion-btn">
            {captacion.boton}
          </button>
        </form>
      </div>
      <p class="u-captacion-garantia">🔒 Sin spam. Puedes darte de baja cuando quieras.</p>
    </div>
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-captacion-card {
    background: linear-gradient(135deg, rgba(184, 134, 11, 0.12) 0%, rgba(0, 85, 164, 0.08) 100%);
    border: 1px solid rgba(184, 134, 11, 0.35);
    border-radius: var(--radius-lg, 1.25rem);
    padding: 2rem 2.2rem;
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    box-shadow: 0 4px 18px rgba(11, 47, 85, 0.04);
  }

  .u-captacion-icono {
    font-size: 2.2rem;
    flex-shrink: 0;
  }

  .u-captacion-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .u-captacion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.25;
  }

  .u-captacion-texto {
    font-size: 1rem;
    color: var(--color-text, #2e2b27);
    margin: 0;
    line-height: 1.5;
  }

  .u-captacion-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .u-captacion-input {
    flex: 1;
    min-width: 240px;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    font-size: 0.95rem;
    background: #ffffff;
  }

  .u-captacion-input:focus {
    outline: 2px solid var(--color-blue, #0055a4);
    border-color: transparent;
  }

  .u-captacion-btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: var(--radius-sm, 0.5rem);
    background: var(--color-blue-dark, #0b2f55);
    color: #ffffff;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.16s ease;
  }

  .u-captacion-btn:hover {
    background: var(--color-blue, #0055a4);
  }

  .u-captacion-garantia {
    font-size: 0.8rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
  }

  @media (max-width: 640px) {
    .u-captacion-card {
      flex-direction: column;
      padding: 1.4rem 1.2rem;
      gap: 1rem;
    }

    .u-captacion-form {
      flex-direction: column;
    }

    .u-captacion-input,
    .u-captacion-btn {
      width: 100%;
    }
  }
</style>
