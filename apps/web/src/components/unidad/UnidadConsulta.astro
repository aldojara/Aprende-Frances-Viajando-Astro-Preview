---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  consulta?: Unidad["consulta"];
}

const { consulta } = Astro.props;
if (!consulta || consulta.length === 0) return null;
---

<section class="u-seccion u-consulta" id="consulta" aria-labelledby="consulta-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Herramientas de apoyo</p>
    <h2 id="consulta-titulo" class="u-seccion-titulo">Tablas de consulta rápida</h2>
    <p class="u-seccion-sub">
      Guarda esta sección como referencia para tus dudas al escribir o preparar tus viajes.
    </p>
  </div>

  <div class="u-acordeones-wrap">
    {
      consulta.map((bloque) => (
        <details class="u-acordeon" open>
          <summary class="u-acordeon-summary">
            <span class="u-acordeon-icon-wrap" aria-hidden="true">
              <svg
                class="u-acordeon-chevron"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
            <span class="u-acordeon-titulo">{bloque.titulo}</span>
          </summary>

          <div class="u-acordeon-contenido">
            {bloque.tabla && (
              <div class="u-consulta-tabla-scroll" tabindex="0" role="region" aria-label={bloque.titulo}>
                <table class="u-consulta-tabla">
                  <thead>
                    <tr>
                      {bloque.tabla.cabeceras.map((cab) => (
                        <th scope="col">{cab}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {bloque.tabla.filas.map((fila) => (
                      <tr>
                        {fila.map((celda, cIdx) => (
                          <td class={cIdx === 0 ? "u-celda-fr" : "u-celda-es"}>
                            <span>{celda}</span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {bloque.puntos && bloque.puntos.length > 0 && (
              <ul class="u-consulta-puntos">
                {bloque.puntos.map((punto) => (
                  <li class="u-consulta-punto">{punto}</li>
                ))}
              </ul>
            )}
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.5rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 1rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.5;
  }

  .u-acordeones-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .u-acordeon {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    box-shadow: 0 3px 12px rgba(11, 47, 85, 0.04);
    overflow: hidden;
    transition: border-color 0.16s ease;
  }

  .u-acordeon[open] {
    border-color: rgba(184, 134, 11, 0.4);
  }

  .u-acordeon-summary {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    background: #ffffff;
    list-style: none;
    user-select: none;
    transition: background 0.15s ease;
  }

  .u-acordeon-summary::-webkit-details-marker {
    display: none;
  }

  .u-acordeon-summary:hover {
    background: var(--color-surface-soft, #efede8);
  }

  .u-acordeon-icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgba(11, 47, 85, 0.06);
    color: var(--color-blue-dark, #0b2f55);
    flex-shrink: 0;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .u-acordeon[open] .u-acordeon-icon-wrap {
    transform: rotate(180deg);
    background: rgba(184, 134, 11, 0.15);
    color: var(--color-gold, #b8860b);
  }

  .u-acordeon-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-heading, #0b2f55);
    margin: 0;
  }

  .u-acordeon-contenido {
    padding: 0 1.35rem 1.35rem;
    border-top: 1px solid var(--color-border, #e2ded7);
    background: #ffffff;
  }

  .u-consulta-tabla-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    margin-top: 1rem;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
  }

  .u-consulta-tabla {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
    text-align: left;
  }

  .u-consulta-tabla th {
    padding: 0.75rem 1rem;
    background: var(--color-surface-soft, #efede8);
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    border-bottom: 2px solid var(--color-border, #e2ded7);
  }

  .u-consulta-tabla td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--color-border, #e2ded7);
  }

  .u-consulta-tabla tbody tr:last-child td {
    border-bottom: 0;
  }

  .u-consulta-tabla tbody tr:nth-child(even) {
    background: rgba(247, 244, 237, 0.4);
  }

  .u-celda-fr {
    font-weight: 600;
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-celda-es {
    color: var(--color-text, #2e2b27);
  }

  .u-consulta-puntos {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .u-consulta-punto {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--color-text, #2e2b27);
  }

  .u-consulta-punto::before {
    content: "•";
    position: absolute;
    left: 0.3rem;
    color: var(--color-gold, #b8860b);
    font-size: 1.2rem;
    line-height: 1.2;
  }
</style>
