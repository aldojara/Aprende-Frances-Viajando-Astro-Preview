---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  unidad: Unidad;
  modo?: "ambos" | "movil" | "escritorio";
}

const { unidad, modo = "ambos" } = Astro.props;

interface ItemIndice {
  id: string;
  etiqueta: string;
}

const items: ItemIndice[] = [];

if (unidad.ideaClave) {
  items.push({ id: "idea-clave", etiqueta: "Idea clave" });
}
if (unidad.usos && unidad.usos.length > 0) {
  items.push({ id: "usos", etiqueta: "Cuándo se usa" });
}
if (unidad.formacion) {
  items.push({ id: "formacion", etiqueta: "Cómo se forma" });
}
if (unidad.consulta && unidad.consulta.length > 0) {
  items.push({ id: "consulta", etiqueta: "Consulta rápida" });
}
if (unidad.practica) {
  items.push({ id: "practica", etiqueta: "Práctica" });
}
if (unidad.errores && unidad.errores.length > 0) {
  items.push({ id: "errores", etiqueta: "Errores típicos" });
}
if (unidad.ejemplos && unidad.ejemplos.items && unidad.ejemplos.items.length > 0) {
  items.push({ id: "ejemplos", etiqueta: "En contexto" });
}
if (unidad.aplicacion) {
  items.push({ id: "aplicacion", etiqueta: "Tu turno" });
}
if (unidad.material && unidad.material.length > 0) {
  items.push({ id: "material", etiqueta: "Material" });
}
if (unidad.resumen && unidad.resumen.length > 0) {
  items.push({ id: "resumen", etiqueta: "Para recordar" });
}
if (unidad.relacionados && unidad.relacionados.length > 0) {
  items.push({ id: "relacionados", etiqueta: "Relacionados" });
}
---

{
  items.length > 0 && (
    <nav class={`u-indice-nav modo-${modo}`} aria-label="Índice de contenidos de la unidad">
      {/* Versión móvil */}
      {(modo === "ambos" || modo === "movil") && (
        <div class="u-indice-movil">
          <span class="u-indice-movil-tag">Índice:</span>
          <div class="u-indice-movil-scroll">
            {items.map((item) => (
              <a href={`#${item.id}`} class="u-indice-movil-link">
                {item.etiqueta}
              </a>
            ))}
          </div>
        </div>
      )}

      {/* Versión escritorio */}
      {(modo === "ambos" || modo === "escritorio") && (
        <div class="u-indice-escritorio">
          <div class="u-indice-header">
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="8" y1="6" x2="21" y2="6" />
              <line x1="8" y1="12" x2="21" y2="12" />
              <line x1="8" y1="18" x2="21" y2="18" />
              <line x1="3" y1="6" x2="3.01" y2="6" />
              <line x1="3" y1="12" x2="3.01" y2="12" />
              <line x1="3" y1="18" x2="3.01" y2="18" />
            </svg>
            <span class="u-indice-titulo">Contenido del tema</span>
          </div>
          <ol class="u-indice-lista">
            {items.map((item, index) => (
              <li class="u-indice-item">
                <a href={`#${item.id}`} class="u-indice-link">
                  <span class="u-indice-num">{String(index + 1).padStart(2, "0")}</span>
                  <span class="u-indice-texto">{item.etiqueta}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}
    </nav>
  )
}

<style>
  .u-indice-nav {
    position: relative;
    z-index: 10;
  }

  /* Versión móvil */
  .u-indice-movil {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 1rem;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border, #e2ded7);
    box-shadow: 0 2px 8px rgba(11, 47, 85, 0.04);
    position: sticky;
    top: 0;
    z-index: 20;
    width: 100%;
    backdrop-filter: blur(8px);
  }

  .u-indice-movil-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-blue-dark, #0b2f55);
    flex-shrink: 0;
  }

  .u-indice-movil-scroll {
    display: flex;
    gap: 0.45rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-right: 1rem;
  }

  .u-indice-movil-scroll::-webkit-scrollbar {
    display: none;
  }

  .u-indice-movil-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.8rem;
    border-radius: 999px;
    background: var(--color-surface-soft, #efede8);
    color: var(--color-text, #2e2b27);
    font-size: 0.82rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    border: 1px solid transparent;
    transition: all 0.15s ease;
  }

  .u-indice-movil-link:hover,
  .u-indice-movil-link:focus-visible {
    background: #ffffff;
    border-color: var(--color-gold, #b8860b);
    color: var(--color-blue-dark, #0b2f55);
  }

  /* Versión escritorio */
  .u-indice-escritorio {
    display: none;
  }

  @media (min-width: 1024px) {
    .modo-movil {
      display: none !important;
    }

    .u-indice-movil {
      display: none;
    }

    .u-indice-escritorio {
      display: block;
      background: #ffffff;
      border: 1px solid var(--color-border, #e2ded7);
      border-radius: var(--radius-md, 0.875rem);
      padding: 1.25rem 1.1rem;
      box-shadow: 0 4px 16px rgba(11, 47, 85, 0.05);
      position: sticky;
      top: 5.5rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
    }

    .u-indice-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.85rem;
      padding-bottom: 0.65rem;
      border-bottom: 1px solid var(--color-border, #e2ded7);
      color: var(--color-blue-dark, #0b2f55);
    }

    .u-indice-titulo {
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .u-indice-lista {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .u-indice-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.45rem 0.6rem;
      border-radius: var(--radius-sm, 0.5rem);
      text-decoration: none;
      color: var(--color-text-muted, #6d6861);
      font-size: 0.88rem;
      font-weight: 500;
      transition: all 0.15s ease;
    }

    .u-indice-num {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-gold, #b8860b);
      width: 1.4rem;
      flex-shrink: 0;
    }

    .u-indice-link:hover,
    .u-indice-link:focus-visible {
      background: var(--color-surface-soft, #efede8);
      color: var(--color-blue-dark, #0b2f55);
    }
  }

  @media (max-width: 1023px) {
    .modo-escritorio {
      display: none !important;
    }
  }
</style>
