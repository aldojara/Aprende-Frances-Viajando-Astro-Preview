---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  ideaClave?: Unidad["ideaClave"];
}

const { ideaClave } = Astro.props;
if (!ideaClave) return null;
---

<section class="u-seccion u-idea-clave" id="idea-clave" aria-labelledby="idea-clave-titulo">
  <div class="u-idea-card">
    <div class="u-idea-header">
      <span class="u-idea-badge">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          stroke="currentColor"
          stroke-width="1"
          aria-hidden="true"
        >
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
        </svg>
        <span>La idea clave para hispanohablantes</span>
      </span>
      <h2 id="idea-clave-titulo" class="u-idea-titulo">
        {ideaClave.titulo || "La idea clave"}
      </h2>
    </div>

    <p class="u-idea-texto">{ideaClave.texto}</p>

    {
      ideaClave.tabla && ideaClave.tabla.length > 0 && (
        <div class="u-idea-comparativa">
          <div class="u-comparativa-grid">
            {ideaClave.tabla.map((fila) => (
              <div class="u-comparativa-item">
                <div class="u-comp-col u-comp-es">
                  <span class="u-comp-tag">En español</span>
                  <p class="u-comp-frase">{fila.es}</p>
                </div>
                <div class="u-comp-flecha" aria-hidden="true">
                  →
                </div>
                <div class="u-comp-col u-comp-fr">
                  <span class="u-comp-tag">En francés (passé composé)</span>
                  <p class="u-comp-frase" lang="fr">
                    {fila.fr}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {
      ideaClave.nota && (
        <div class="u-idea-nota">
          <span class="u-idea-nota-icono" aria-hidden="true">
            💡
          </span>
          <p class="u-idea-nota-texto">{ideaClave.nota}</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-idea-card {
    background: #ffffff;
    border: 2px solid rgba(184, 134, 11, 0.35);
    border-radius: var(--radius-lg, 1.25rem);
    padding: 1.85rem;
    box-shadow: 0 8px 24px rgba(184, 134, 11, 0.08);
    position: relative;
    overflow: hidden;
  }

  .u-idea-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 5px;
    background: linear-gradient(90deg, var(--color-gold, #b8860b), var(--color-blue, #0055a4));
  }

  .u-idea-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .u-idea-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.85rem;
    background: rgba(184, 134, 11, 0.12);
    color: #8b6508;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .u-idea-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.2;
    margin: 0;
  }

  .u-idea-texto {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text, #2e2b27);
    margin: 0 0 1.35rem;
  }

  /* Comparativa */
  .u-idea-comparativa {
    margin-bottom: 1.35rem;
  }

  .u-comparativa-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .u-comparativa-item {
    display: grid;
    grid-template-columns: 1fr auto 1.15fr;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.2rem;
    background: var(--color-surface-soft, #efede8);
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
  }

  .u-comp-col {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .u-comp-tag {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #6d6861);
  }

  .u-comp-fr .u-comp-tag {
    color: var(--color-blue, #0055a4);
  }

  .u-comp-frase {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text, #2e2b27);
  }

  .u-comp-fr .u-comp-frase {
    color: var(--color-blue-dark, #0b2f55);
    font-size: 1.05rem;
  }

  .u-comp-flecha {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-gold, #b8860b);
    user-select: none;
  }

  /* Nota explicativa */
  .u-idea-nota {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    background: rgba(184, 134, 11, 0.07);
    border-left: 3px solid var(--color-gold, #b8860b);
    border-radius: 0 var(--radius-sm, 0.5rem) var(--radius-sm, 0.5rem) 0;
  }

  .u-idea-nota-icono {
    font-size: 1.15rem;
    flex-shrink: 0;
    line-height: 1.4;
  }

  .u-idea-nota-texto {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: #4a453e;
  }

  @media (max-width: 640px) {
    .u-idea-card {
      padding: 1.25rem;
    }

    .u-comparativa-item {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 0.85rem 1rem;
    }

    .u-comp-flecha {
      transform: rotate(90deg);
      align-self: center;
      line-height: 1;
      margin-block: -0.2rem;
    }
  }
</style>
