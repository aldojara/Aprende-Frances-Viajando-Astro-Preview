---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  audio?: Unidad["audioResumen"];
  invitacion?: string;
}

const { audio, invitacion } = Astro.props;
if (!audio) return null;

const esDrive = audio.url.includes("drive.google.com");
let driveEmbedUrl = audio.url;
if (esDrive) {
  driveEmbedUrl = audio.url.replace(/\/view(\?.*)?$/, "/preview");
  if (!driveEmbedUrl.includes("/preview")) {
    driveEmbedUrl = driveEmbedUrl.endsWith("/") ? `${driveEmbedUrl}preview` : `${driveEmbedUrl}/preview`;
  }
}
---

<section class="u-seccion u-audio-bloque" id="audio-resumen" aria-labelledby="audio-resumen-titulo">
  {
    invitacion && (
      <div class="u-audio-invitacion-box">
        <span class="u-audio-invitacion-icon" aria-hidden="true">🎙️</span>
        <span class="u-audio-invitacion-texto">{invitacion}</span>
      </div>
    )
  }
  <div class="u-audio-card">
    <div class="u-audio-header">
      <div class="u-audio-icono" aria-hidden="true">🎧</div>
      <div class="u-audio-info">
        <span class="u-audio-tag">Resumen en audio</span>
        <h3 id="audio-resumen-titulo" class="u-audio-titulo">{audio.titulo}</h3>
        {audio.duracion && <span class="u-audio-duracion">{audio.duracion}</span>}
      </div>
    </div>

    <div class="u-audio-player-wrap">
      {
        esDrive ? (
          <iframe
            src={driveEmbedUrl}
            class="u-audio-drive-frame"
            title={`Audio: ${audio.titulo}`}
            loading="lazy"
          />
        ) : (
          <audio controls preload="none" class="u-audio-player">
            <source src={audio.url} />
            Tu navegador no soporta el reproductor de audio.
          </audio>
        )
      }
    </div>
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-audio-invitacion-box {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.5rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-audio-invitacion-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .u-audio-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    padding: 0.95rem 1.15rem;
    box-shadow: 0 2px 8px rgba(11, 47, 85, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .u-audio-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .u-audio-icono {
    font-size: 1.6rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .u-audio-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .u-audio-tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-blue, #0055a4);
  }

  .u-audio-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.3;
  }

  .u-audio-duracion {
    font-size: 0.76rem;
    color: var(--color-text-muted, #6d6861);
  }

  .u-audio-player-wrap {
    width: 100%;
  }

  .u-audio-player {
    width: 100%;
    height: 38px;
    outline: none;
  }

  .u-audio-drive-frame {
    width: 100%;
    height: 56px;
    border: 0;
    border-radius: var(--radius-sm, 0.5rem);
  }
</style>
