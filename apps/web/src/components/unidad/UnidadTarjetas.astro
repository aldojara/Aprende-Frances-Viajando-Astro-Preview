---
import type { TarjetaDidactica } from "../../data/unidades/tipos";

interface Props {
  tarjetas?: TarjetaDidactica[];
}

const { tarjetas } = Astro.props;
if (!tarjetas || tarjetas.length === 0) return null;
---

<section class="u-seccion u-tarjetas-bloque" id="tarjetas-didacticas" aria-labelledby="tarjetas-titulo">
  <div class="u-tarjetas-card">
    <div class="u-tarjetas-header">
      <span class="u-tarjetas-badge">🃏 Tarjetas didácticas de repaso</span>
      <h3 id="tarjetas-titulo" class="u-tarjetas-titulo">Entrena tu memoria activa</h3>
      <p class="u-tarjetas-sub">Toca la tarjeta para girarla y comprobar tu respuesta.</p>
    </div>

    <!-- Carrusel interactivo de flashcards -->
    <div class="u-flashcard-carrusel" data-flashcards>
      <div class="u-flashcard-viewport">
        {
          tarjetas.map((t, idx) => (
            <div
              class={`u-flashcard-item ${idx === 0 ? "u-card-visible" : ""}`}
              data-card-index={idx}
              hidden={idx !== 0}
            >
              <div class="u-card-inner" data-card-inner role="button" tabindex="0" aria-label={`Tarjeta ${idx + 1}: ${t.frente}. Toca para girar.`}>
                <!-- Cara Frontal -->
                <div class="u-card-cara u-card-frente">
                  <span class="u-cara-etiqueta">Pregunta / Español</span>
                  <p class="u-cara-texto">{t.frente}</p>
                  {t.pista && <span class="u-cara-pista">💡 Pista: {t.pista}</span>}
                  <span class="u-cara-girar-hint">Toca para voltear ↺</span>
                </div>

                <!-- Cara Posterior -->
                <div class="u-card-cara u-card-reverso">
                  <span class="u-cara-etiqueta u-etiqueta-bien">Respuesta / Francés</span>
                  <p class="u-cara-texto u-texto-fr" lang="fr">{t.reverso}</p>
                  <span class="u-cara-girar-hint">Toca para voltear ↺</span>
                </div>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Barra de controles -->
      <div class="u-card-controles">
        <button
          type="button"
          class="u-btn-card-nav"
          data-card-prev
          aria-label="Tarjeta anterior"
        >
          ← Anterior
        </button>

        <span class="u-card-contador">
          Tarjeta <strong data-card-current>1</strong> de <strong>{tarjetas.length}</strong>
        </span>

        <button
          type="button"
          class="u-btn-card-nav"
          data-card-next
          aria-label="Tarjeta siguiente"
        >
          Siguiente →
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Fallback sin JS: todas las tarjetas visibles en lista -->
<noscript>
  <style>
    .u-flashcard-item[hidden] {
      display: block !important;
      margin-bottom: 1rem;
    }
    .u-card-inner {
      transform: none !important;
    }
    .u-card-reverso {
      display: block !important;
      position: static !important;
      transform: none !important;
      margin-top: 0.5rem;
    }
    .u-card-controles {
      display: none !important;
    }
  </style>
</noscript>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-flashcards]");
    if (!root) return;

    const cards = Array.from(root.querySelectorAll(".u-flashcard-item"));
    const btnPrev = root.querySelector("[data-card-prev]");
    const btnNext = root.querySelector("[data-card-next]");
    const lblCurrent = root.querySelector("[data-card-current]");
    let currentIndex = 0;

    function mostrarTarjeta(index) {
      if (index < 0) index = cards.length - 1;
      if (index >= cards.length) index = 0;
      currentIndex = index;

      cards.forEach(function (c, idx) {
        const coincide = idx === currentIndex;
        if (coincide) {
          c.removeAttribute("hidden");
          c.classList.add("u-card-visible");
        } else {
          c.setAttribute("hidden", "");
          c.classList.remove("u-card-visible");
        }
        // Desvoltear al cambiar
        const inner = c.querySelector("[data-card-inner]");
        if (inner) inner.classList.remove("u-flipped");
      });

      if (lblCurrent) lblCurrent.textContent = String(currentIndex + 1);
    }

    if (btnPrev) {
      btnPrev.addEventListener("click", function () {
        mostrarTarjeta(currentIndex - 1);
      });
    }

    if (btnNext) {
      btnNext.addEventListener("click", function () {
        mostrarTarjeta(currentIndex + 1);
      });
    }

    // Volteo al hacer clic o presionar Enter / Espacio
    cards.forEach(function (c) {
      const inner = c.querySelector("[data-card-inner]");
      if (!inner) return;

      function toggleFlip() {
        inner.classList.toggle("u-flipped");
      }

      inner.addEventListener("click", toggleFlip);
      inner.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggleFlip();
        }
      });
    });
  })();
</script>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-tarjetas-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1.15rem 1.35rem;
    box-shadow: 0 4px 14px rgba(11, 47, 85, 0.04);
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .u-tarjetas-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .u-tarjetas-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(184, 134, 11, 0.12);
    color: #8b6508;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .u-tarjetas-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: 1.15rem;
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.25;
  }

  .u-tarjetas-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
  }

  /* Flashcard 3D flip */
  .u-flashcard-carrusel {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .u-flashcard-viewport {
    perspective: 1000px;
    width: 100%;
    min-height: 170px;
  }

  .u-flashcard-item {
    width: 100%;
    height: 100%;
  }

  .u-card-inner {
    position: relative;
    width: 100%;
    min-height: 170px;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    transform-style: preserve-3d;
    cursor: pointer;
    border-radius: var(--radius-sm, 0.5rem);
    outline: none;
  }

  .u-card-inner:focus-visible {
    outline: 2px solid var(--color-blue, #0055a4);
  }

  .u-card-inner.u-flipped {
    transform: rotateY(180deg);
  }

  .u-card-cara {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: var(--radius-sm, 0.5rem);
    padding: 1.2rem 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    box-shadow: 0 4px 12px rgba(11, 47, 85, 0.06);
  }

  .u-card-frente {
    background: var(--color-surface-soft, #efede8);
    border: 2px solid var(--color-border, #e2ded7);
    color: var(--color-text, #2e2b27);
  }

  .u-card-reverso {
    background: linear-gradient(145deg, #ffffff 0%, #edf7f1 100%);
    border: 2px solid #bde4cb;
    color: #1e5a37;
    transform: rotateY(180deg);
  }

  .u-cara-etiqueta {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #6d6861);
  }

  .u-etiqueta-bien {
    color: #276749;
  }

  .u-cara-texto {
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 0.4rem 0;
  }

  .u-texto-fr {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-cara-pista {
    font-size: 0.8rem;
    color: var(--color-gold, #b8860b);
    font-weight: 500;
  }

  .u-cara-girar-hint {
    align-self: flex-end;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--color-blue, #0055a4);
    opacity: 0.8;
  }

  /* Controles */
  .u-card-controles {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }

  .u-btn-card-nav {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    color: var(--color-blue-dark, #0b2f55);
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .u-btn-card-nav:hover {
    background: var(--color-surface-soft, #efede8);
    border-color: var(--color-blue, #0055a4);
  }

  .u-card-contador {
    font-size: 0.82rem;
    color: var(--color-text-muted, #6d6861);
  }
</style>
