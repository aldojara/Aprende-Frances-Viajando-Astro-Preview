---
import type { Unidad } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  material?: Unidad["material"];
}

const { material } = Astro.props;
if (!material || material.length === 0) return null;

const iconosPorTipo: Record<string, string> = {
  video: "🎬",
  audio: "🎧",
  infografia: "📊",
  presentacion: "📽️",
};

const nombresPorTipo: Record<string, string> = {
  video: "Lección en vídeo",
  audio: "Podcast / Audio",
  infografia: "Ficha infográfica",
  presentacion: "Presentación guiada",
};
---

<section class="u-seccion u-material" id="material" aria-labelledby="material-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Material complementario</p>
    <h2 id="material-titulo" class="u-seccion-titulo">Material del tema</h2>
    <p class="u-seccion-sub">
      Recursos multimedia para profundizar y entrenar tu comprensión oral y visual.
    </p>
  </div>

  <div class="u-material-grid">
    {
      material.map((item) => (
        <article class="u-material-card">
          <div class="u-material-thumb">
            {item.miniatura ? (
              <img src={withBase(item.miniatura)} alt={item.titulo} loading="lazy" />
            ) : (
              <div class="u-thumb-placeholder">
                <span class="u-thumb-icon">{iconosPorTipo[item.tipo] || "📁"}</span>
              </div>
            )}
            <span class="u-material-badge">{nombresPorTipo[item.tipo] || item.tipo}</span>
          </div>

          <div class="u-material-cuerpo">
            <h3 class="u-material-card-titulo">{item.titulo}</h3>
            {item.url && (
              <a class="u-material-link" href={withBase(item.url)}>
                <span>Acceder al material</span>
                <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.5rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.45rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 0.98rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.5;
  }

  .u-material-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .u-material-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(11, 47, 85, 0.04);
    display: flex;
    flex-direction: column;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .u-material-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 22px rgba(11, 47, 85, 0.08);
  }

  .u-material-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-soft, #efede8);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .u-material-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .u-thumb-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.2rem;
  }

  .u-material-badge {
    position: absolute;
    bottom: 0.6rem;
    left: 0.6rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(11, 47, 85, 0.85);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    backdrop-filter: blur(4px);
  }

  .u-material-cuerpo {
    padding: 1.1rem 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.85rem;
    flex: 1;
  }

  .u-material-card-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.4;
    margin: 0;
  }

  .u-material-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-blue, #0055a4);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .u-material-link:hover {
    color: var(--color-blue-dark, #0b2f55);
    text-decoration: underline;
  }
</style>
