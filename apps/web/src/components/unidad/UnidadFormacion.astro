---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  formacion?: Unidad["formacion"];
}

const { formacion } = Astro.props;
if (!formacion) return null;
---

<section class="u-seccion u-formacion" id="formacion" aria-labelledby="formacion-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Estructura y conjugación</p>
    <h2 id="formacion-titulo" class="u-seccion-titulo">Cómo se forma</h2>
  </div>

  <!-- Fórmula visual de la regla -->
  <div class="u-formula-box">
    <span class="u-formula-etiqueta">Fórmula general:</span>
    <div class="u-formula-elementos">
      <div class="u-formula-bloque">
        <span class="u-formula-nombre">Sujeto</span>
      </div>
      <span class="u-formula-operador">+</span>
      <div class="u-formula-bloque u-formula-aux">
        <span class="u-formula-nombre">Auxiliar en presente</span>
        <span class="u-formula-sub">(avoir o être)</span>
      </div>
      <span class="u-formula-operador">+</span>
      <div class="u-formula-bloque u-formula-part">
        <span class="u-formula-nombre">Participio pasado</span>
      </div>
    </div>
  </div>

  <!-- Tabla de conjugación comparativa -->
  {
    formacion.tabla && (
      <div class="u-tabla-bloque">
        <h3 class="u-subtitulo">Tabla de conjugación: avoir vs. être</h3>
        <p class="u-tabla-instruccion">
          Compara cómo se conjuga un verbo con <em>avoir</em> (visiter) frente a un verbo de movimiento con <em>être</em> (partir):
        </p>
        <div class="u-tabla-scroll" tabindex="0" role="region" aria-label="Tabla de conjugación de avoir y être">
          <table class="u-tabla">
            <thead>
              <tr>
                {formacion.tabla.cabeceras.map((cab, idx) => (
                  <th scope="col" class={idx === 0 ? "u-col-sujeto" : idx === 1 ? "u-col-avoir" : "u-col-etre"}>
                    {cab}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {formacion.tabla.filas.map((fila) => (
                <tr>
                  {fila.map((celda, cIdx) => (
                    <td class={cIdx === 0 ? "u-celda-sujeto" : cIdx === 1 ? "u-celda-avoir" : "u-celda-etre"}>
                      <span lang="fr">{celda}</span>
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )
  }

  <!-- Las 3 preguntas para elegir entre avoir y être -->
  {
    formacion.pasos && formacion.pasos.length > 0 && (
      <div class="u-pasos-bloque">
        <h3 class="u-subtitulo">¿Avoir o être? En 3 preguntas clave</h3>
        <p class="u-pasos-desc">
          Para saber qué auxiliar usar, sigue siempre este orden mental de tres preguntas:
        </p>

        <div class="u-pasos-grid">
          {formacion.pasos.map((paso, idx) => (
            <div class="u-paso-card">
              <div class="u-paso-top">
                <span class="u-paso-num">Paso {idx + 1}</span>
                <span class={`u-paso-badge ${paso.respuesta.toLowerCase() === "être" ? "u-badge-etre" : "u-badge-avoir"}`}>
                  → Usa {paso.respuesta}
                </span>
              </div>
              <h4 class="u-paso-pregunta">{paso.pregunta}</h4>
              {paso.detalle && <p class="u-paso-detalle">{paso.detalle}</p>}
            </div>
          ))}
        </div>
      </div>
    )
  }

  <!-- Notas sobre concordancia y excepciones -->
  {
    formacion.notas && formacion.notas.length > 0 && (
      <div class="u-notas-bloque">
        <h3 class="u-subtitulo">Puntos clave sobre la concordancia</h3>
        <div class="u-notas-lista">
          {formacion.notas.map((nota) => (
            <div class="u-nota-item">
              <span class="u-nota-bullet" aria-hidden="true">
                ✓
              </span>
              <p class="u-nota-texto">{nota}</p>
            </div>
          ))}
        </div>
      </div>
    )
  }
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.5rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.2;
  }

  .u-subtitulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: 1.25rem;
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.45rem;
  }

  /* Fórmula visual */
  .u-formula-box {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1.25rem 1.4rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 14px rgba(11, 47, 85, 0.04);
  }

  .u-formula-etiqueta {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #6d6861);
    margin-bottom: 0.75rem;
  }

  .u-formula-elementos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .u-formula-bloque {
    padding: 0.65rem 1.1rem;
    background: var(--color-surface-soft, #efede8);
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .u-formula-aux {
    background: rgba(184, 134, 11, 0.1);
    border-color: rgba(184, 134, 11, 0.3);
  }

  .u-formula-part {
    background: rgba(0, 85, 164, 0.08);
    border-color: rgba(0, 85, 164, 0.25);
  }

  .u-formula-nombre {
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    font-size: 0.95rem;
  }

  .u-formula-sub {
    font-size: 0.78rem;
    color: var(--color-text-muted, #6d6861);
    font-weight: 500;
  }

  .u-formula-operador {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-gold, #b8860b);
  }

  /* Tabla de conjugación */
  .u-tabla-bloque {
    margin-bottom: 2.25rem;
  }

  .u-tabla-instruccion {
    font-size: 0.95rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .u-tabla-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    background: #ffffff;
    box-shadow: 0 4px 14px rgba(11, 47, 85, 0.04);
  }

  .u-tabla {
    width: 100%;
    min-width: 540px;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.92rem;
  }

  .u-tabla th {
    padding: 0.85rem 1rem;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.03em;
    border-bottom: 2px solid var(--color-border, #e2ded7);
    background: var(--color-surface-soft, #efede8);
  }

  .u-col-sujeto {
    color: var(--color-text-muted, #6d6861);
    width: 22%;
  }

  .u-col-avoir {
    color: var(--color-gold, #b8860b);
    width: 39%;
  }

  .u-col-etre {
    color: var(--color-blue, #0055a4);
    width: 39%;
  }

  .u-tabla td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border, #e2ded7);
    color: var(--color-text, #2e2b27);
  }

  .u-tabla tbody tr:last-child td {
    border-bottom: 0;
  }

  .u-tabla tbody tr:nth-child(even) {
    background: rgba(247, 244, 237, 0.5);
  }

  .u-celda-sujeto {
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-celda-avoir,
  .u-celda-etre {
    font-weight: 500;
  }

  /* Las 3 preguntas */
  .u-pasos-bloque {
    margin-bottom: 2.25rem;
  }

  .u-pasos-desc {
    font-size: 0.95rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0 0 1rem;
    line-height: 1.5;
  }

  .u-pasos-grid {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .u-paso-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1.15rem 1.3rem;
    box-shadow: 0 3px 10px rgba(11, 47, 85, 0.03);
  }

  .u-paso-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.45rem;
  }

  .u-paso-num {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #6d6861);
  }

  .u-paso-badge {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .u-badge-etre {
    background: rgba(0, 85, 164, 0.12);
    color: var(--color-blue, #0055a4);
  }

  .u-badge-avoir {
    background: rgba(184, 134, 11, 0.15);
    color: #8b6508;
  }

  .u-paso-pregunta {
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-heading, #0b2f55);
    margin: 0 0 0.35rem;
    line-height: 1.4;
  }

  .u-paso-detalle {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
  }

  /* Notas de concordancia */
  .u-notas-bloque {
    margin-bottom: 1rem;
  }

  .u-notas-lista {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .u-nota-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.85rem 1.1rem;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
  }

  .u-nota-bullet {
    color: var(--color-blue, #0055a4);
    font-weight: 800;
    line-height: 1.4;
    flex-shrink: 0;
  }

  .u-nota-texto {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text, #2e2b27);
  }

  @media (max-width: 640px) {
    .u-formula-elementos {
      flex-direction: column;
      align-items: stretch;
    }

    .u-formula-operador {
      text-align: center;
      line-height: 1;
    }
  }
</style>
