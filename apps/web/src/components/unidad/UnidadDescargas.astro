---
import type { RecursoDescarga } from "../../data/unidades/tipos";
import { withBase } from "../../utils/paths";

interface Props {
  descargas?: RecursoDescarga[];
  modo?: "desktop" | "mobile" | "ambos";
}

const { descargas, modo = "ambos" } = Astro.props;
if (!descargas || descargas.length === 0) return null;
---

<div class={`u-descargas-wrap modo-${modo}`} aria-label="Descargas y materiales de apoyo">
  <div class="u-descargas-linea">
    <span class="u-descargas-etiqueta">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
        <polyline points="7 10 12 15 17 10" />
        <line x1="12" y1="15" x2="12" y2="3" />
      </svg>
      <span>Materiales descargables:</span>
    </span>

    <div class="u-descargas-items">
      {
        descargas.map((d) => (
          <a
            href={withBase(d.url)}
            download
            class="u-descarga-pill"
            title={`Descargar ${d.titulo}`}
          >
            <span class="u-descarga-tipo">{d.tipo.toUpperCase()}</span>
            <span class="u-descarga-titulo">{d.titulo}</span>
            {d.peso && <span class="u-descarga-peso">({d.peso})</span>}
            <span class="u-descarga-flecha" aria-hidden="true">↓</span>
          </a>
        ))
      }
    </div>
  </div>
</div>

<style>
  .u-descargas-wrap {
    width: 100%;
  }

  .u-descargas-linea {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    background: #ffffff;
    border: 1px dashed var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.65rem 0.85rem;
    font-size: 0.82rem;
  }

  .u-descargas-etiqueta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-blue-dark, #0b2f55);
    flex-shrink: 0;
  }

  .u-descargas-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .u-descarga-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--color-surface-soft, #efede8);
    border: 1px solid var(--color-border, #e2ded7);
    color: var(--color-text, #2e2b27);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    transition: all 0.16s ease;
  }

  .u-descarga-pill:hover {
    background: #ffffff;
    border-color: var(--color-gold, #b8860b);
    color: var(--color-blue-dark, #0b2f55);
    transform: translateY(-1px);
  }

  .u-descarga-tipo {
    font-size: 0.65rem;
    font-weight: 800;
    padding: 0.05rem 0.3rem;
    border-radius: 3px;
    background: rgba(184, 134, 11, 0.15);
    color: #8b6508;
  }

  .u-descarga-titulo {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 220px;
  }

  .u-descarga-peso {
    font-size: 0.7rem;
    color: var(--color-text-muted, #6d6861);
    font-weight: 400;
  }

  .u-descarga-flecha {
    font-weight: 800;
    color: var(--color-gold, #b8860b);
  }

  @media (min-width: 1024px) {
    .modo-mobile {
      display: none !important;
    }
  }

  @media (max-width: 1023px) {
    .modo-desktop {
      display: none !important;
    }
  }
</style>
