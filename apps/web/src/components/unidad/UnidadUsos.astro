---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  usos?: Unidad["usos"];
  usosNota?: Unidad["usosNota"];
}

const { usos, usosNota } = Astro.props;
if (!usos || usos.length === 0) return null;
---

<section class="u-seccion u-usos" id="usos" aria-labelledby="usos-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Contextos de uso</p>
    <h2 id="usos-titulo" class="u-seccion-titulo">Cuándo se usa</h2>
    <p class="u-seccion-sub">
      A diferencia de otros tiempos, el passé composé se reserva para hechos puntuales, terminados o experiencias concretas.
    </p>
  </div>

  <div class="u-usos-grid">
    {
      usos.map((uso, index) => (
        <article class="u-uso-card">
          <div class="u-uso-header">
            <span class="u-uso-num">{String(index + 1).padStart(2, "0")}</span>
            <h3 class="u-uso-titulo">{uso.titulo}</h3>
          </div>
          <div class="u-uso-ejemplo-box">
            <span class="u-uso-ejemplo-label">Ejemplo:</span>
            <p class="u-uso-ejemplo" lang="fr">
              {uso.ejemplo}
            </p>
            {uso.nota && <p class="u-uso-nota">({uso.nota})</p>}
          </div>
        </article>
      ))
    }
  </div>

  {
    usosNota && (
      <div class="u-usos-alerta">
        <div class="u-alerta-icono" aria-hidden="true">
          ℹ️
        </div>
        <div class="u-alerta-cuerpo">
          <p class="u-alerta-texto">{usosNota}</p>
        </div>
      </div>
    )
  }
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.5rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 1rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.5;
  }

  .u-usos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.15rem;
    margin-bottom: 1.35rem;
  }

  .u-uso-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    box-shadow: 0 3px 12px rgba(11, 47, 85, 0.04);
    transition: transform 0.16s ease, box-shadow 0.16s ease;
  }

  .u-uso-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(11, 47, 85, 0.08);
  }

  .u-uso-header {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .u-uso-num {
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--color-gold, #b8860b);
    background: rgba(184, 134, 11, 0.12);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-sm, 0.5rem);
    flex-shrink: 0;
  }

  .u-uso-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--color-heading, #0b2f55);
    line-height: 1.35;
    margin: 0;
  }

  .u-uso-ejemplo-box {
    background: var(--color-surface-soft, #efede8);
    border-left: 3px solid var(--color-blue, #0055a4);
    border-radius: 0 var(--radius-sm, 0.5rem) var(--radius-sm, 0.5rem) 0;
    padding: 0.75rem 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .u-uso-ejemplo-label {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted, #6d6861);
  }

  .u-uso-ejemplo {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.45;
  }

  .u-uso-nota {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-text-muted, #6d6861);
    font-style: italic;
  }

  .u-usos-alerta {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-left: 4px solid var(--color-blue, #0055a4);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1.1rem 1.25rem;
    box-shadow: 0 2px 10px rgba(11, 47, 85, 0.04);
  }

  .u-alerta-icono {
    font-size: 1.2rem;
    flex-shrink: 0;
    line-height: 1.3;
  }

  .u-alerta-texto {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text, #2e2b27);
    line-height: 1.5;
  }
</style>
