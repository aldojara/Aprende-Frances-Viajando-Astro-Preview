---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  usos?: Unidad["usos"];
  usosNota?: Unidad["usosNota"];
}

const { usos, usosNota } = Astro.props;
if (!usos || usos.length === 0) return null;
---

<section class="u-seccion u-usos" id="usos" aria-labelledby="usos-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Contextos de uso</p>
    <h2 id="usos-titulo" class="u-seccion-titulo">Cuándo se usa</h2>
  </div>

  <div class="u-usos-grid">
    {
      usos.map((uso, index) => (
        <article class="u-uso-card">
          <div class="u-uso-top">
            <span class="u-uso-num">{index + 1}</span>
            <h3 class="u-uso-titulo">{uso.titulo}</h3>
          </div>
          <div class="u-uso-ejemplo-box">
            <p class="u-uso-ejemplo" lang="fr">{uso.ejemplo}</p>
            {uso.nota && <span class="u-uso-nota">({uso.nota})</span>}
          </div>
        </article>
      ))
    }
  </div>

  {
    usosNota && (
      <div class="u-usos-alerta">
        <span class="u-alerta-icono" aria-hidden="true">ℹ️</span>
        <p class="u-alerta-texto">{usosNota}</p>
      </div>
    )
  }
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 0.85rem;
  }

  .u-eyebrow {
    margin: 0 0 0.25rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.35rem, 2.5vw, 1.7rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.2;
  }

  .u-usos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 0.75rem;
    margin-bottom: 0.85rem;
  }

  .u-uso-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.5rem;
    box-shadow: 0 2px 6px rgba(11, 47, 85, 0.03);
  }

  .u-uso-top {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .u-uso-num {
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--color-gold, #b8860b);
    background: rgba(184, 134, 11, 0.12);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .u-uso-titulo {
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--color-heading, #0b2f55);
    line-height: 1.35;
    margin: 0;
  }

  .u-uso-ejemplo-box {
    background: var(--color-surface-soft, #efede8);
    border-left: 2px solid var(--color-blue, #0055a4);
    border-radius: 0 4px 4px 0;
    padding: 0.45rem 0.65rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .u-uso-ejemplo {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.35;
  }

  .u-uso-nota {
    font-size: 0.78rem;
    color: var(--color-text-muted, #6d6861);
    font-style: italic;
  }

  .u-usos-alerta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-left: 3px solid var(--color-blue, #0055a4);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.65rem 0.95rem;
  }

  .u-alerta-icono {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .u-alerta-texto {
    margin: 0;
    font-size: 0.86rem;
    color: var(--color-text, #2e2b27);
    line-height: 1.45;
  }
</style>
