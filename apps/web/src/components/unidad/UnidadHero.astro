---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  unidad: Unidad;
}

const { unidad } = Astro.props;
const tienePractica = Boolean(unidad.practica);
---

<header class="u-hero">
  <div class="u-hero-inner">
    <div class="u-hero-meta">
      <span class="u-pill u-pill-tema">Gramática francesa</span>
      {
        unidad.nivel && unidad.nivel.length > 0 && (
          <span class="u-pill u-pill-nivel">Nivel {unidad.nivel.join(" · ")}</span>
        )
      }
      {
        unidad.minutos && (
          <span class="u-pill u-pill-tiempo">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>{unidad.minutos} min de lectura</span>
          </span>
        )
      }
    </div>

    <h1 class="u-hero-titulo">{unidad.titulo}</h1>

    {unidad.objetivo && <p class="u-hero-objetivo">{unidad.objetivo}</p>}

    <div class="u-hero-acciones">
      {
        tienePractica && (
          <a class="u-btn-hero-primary" href="#practica">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polygon points="5 3 19 12 5 21 5 3" />
            </svg>
            <span>Practicar ahora</span>
          </a>
        )
      }
      <a class="u-btn-hero-ghost" href="#idea-clave">
        <span>Ver explicación ↓</span>
      </a>
    </div>
  </div>
</header>

<style>
  .u-hero {
    background: linear-gradient(180deg, var(--color-blue-dark, #0b2f55) 0%, #071f38 100%);
    color: #ffffff;
    padding-block: 2.75rem 3.25rem;
    border-radius: 0 0 28px 28px;
    box-shadow: 0 10px 30px rgba(11, 47, 85, 0.15);
  }

  .u-hero-inner {
    width: min(100% - 2rem, 900px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .u-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .u-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .u-pill-tema {
    background: rgba(255, 255, 255, 0.14);
    color: #f7f4ed;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .u-pill-nivel {
    background: rgba(184, 134, 11, 0.25);
    color: #f0d48a;
    border: 1px solid rgba(240, 212, 138, 0.45);
  }

  .u-pill-tiempo {
    background: rgba(255, 255, 255, 0.08);
    color: #d2dbe5;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .u-hero-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.12;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.015em;
  }

  .u-hero-objetivo {
    font-size: clamp(1.05rem, 2.2vw, 1.25rem);
    line-height: 1.5;
    color: #cdd8e6;
    margin: 0;
    max-width: 680px;
  }

  .u-hero-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding-top: 0.5rem;
  }

  .u-btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 3.1rem;
    padding: 0.65rem 1.6rem;
    background: var(--color-gold, #b8860b);
    color: #1a1608;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(184, 134, 11, 0.35);
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .u-btn-hero-primary:hover {
    background: #9c7108;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(184, 134, 11, 0.45);
  }

  .u-btn-hero-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.1rem;
    padding: 0.65rem 1.4rem;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.18s ease;
  }

  .u-btn-hero-ghost:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: #ffffff;
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .u-hero {
      padding-block: 2rem 2.5rem;
      border-radius: 0 0 20px 20px;
    }

    .u-hero-acciones {
      flex-direction: column;
      align-items: stretch;
    }

    .u-btn-hero-primary,
    .u-btn-hero-ghost {
      width: 100%;
      text-align: center;
    }
  }
</style>
