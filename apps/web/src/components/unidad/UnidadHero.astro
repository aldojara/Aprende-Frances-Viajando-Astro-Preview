---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  unidad: Unidad;
}

const { unidad } = Astro.props;
const tienePractica = Boolean(unidad.practica);
---

<header class="u-hero">
  <div class="u-hero-inner">
    <div class="u-hero-meta">
      <span class="u-pill u-pill-tema">Gramática francesa</span>
      {
        unidad.nivel && unidad.nivel.length > 0 && (
          <span class="u-pill u-pill-nivel">Nivel {unidad.nivel.join(" · ")}</span>
        )
      }
      {
        unidad.minutos && (
          <span class="u-pill u-pill-tiempo">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10" />
              <polyline points="12 6 12 12 16 14" />
            </svg>
            <span>{unidad.minutos} min</span>
          </span>
        )
      }
    </div>

    <div class="u-hero-main-row">
      <div class="u-hero-texto-wrap">
        <h1 class="u-hero-titulo">{unidad.titulo}</h1>
        {unidad.objetivo && <p class="u-hero-objetivo">{unidad.objetivo}</p>}
      </div>

      {
        tienePractica && (
          <div class="u-hero-btn-wrap">
            <a class="u-btn-hero-primary" href="#practica">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="5 3 19 12 5 21 5 3" />
              </svg>
              <span>Practicar ahora</span>
            </a>
          </div>
        )
      }
    </div>
  </div>
</header>

<style>
  .u-hero {
    background: linear-gradient(180deg, var(--color-blue-dark, #0b2f55) 0%, #071f38 100%);
    color: #ffffff;
    padding-block: 1.6rem 1.8rem;
    border-radius: 0 0 20px 20px;
    box-shadow: 0 8px 24px rgba(11, 47, 85, 0.12);
  }

  .u-hero-inner {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .u-hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  .u-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.65rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .u-pill-tema {
    background: rgba(255, 255, 255, 0.14);
    color: #f7f4ed;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .u-pill-nivel {
    background: rgba(184, 134, 11, 0.25);
    color: #f0d48a;
    border: 1px solid rgba(240, 212, 138, 0.45);
  }

  .u-pill-tiempo {
    background: rgba(255, 255, 255, 0.08);
    color: #d2dbe5;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .u-hero-main-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .u-hero-texto-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    max-width: 720px;
  }

  .u-hero-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.8rem, 3.8vw, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    color: #ffffff;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .u-hero-objetivo {
    font-size: clamp(0.95rem, 1.8vw, 1.08rem);
    line-height: 1.45;
    color: #cdd8e6;
    margin: 0;
  }

  .u-hero-btn-wrap {
    flex-shrink: 0;
  }

  .u-btn-hero-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.65rem;
    padding: 0.5rem 1.35rem;
    background: var(--color-gold, #b8860b);
    color: #1a1608;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
    box-shadow: 0 4px 12px rgba(184, 134, 11, 0.35);
    transition: all 0.16s ease;
  }

  .u-btn-hero-primary:hover {
    background: #9c7108;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .u-btn-hero-primary:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 640px) {
    .u-hero {
      padding-block: 1.25rem 1.45rem;
      border-radius: 0 0 16px 16px;
    }

    .u-hero-main-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }

    .u-hero-btn-wrap {
      width: 100%;
    }

    .u-btn-hero-primary {
      width: 100%;
    }
  }
</style>
