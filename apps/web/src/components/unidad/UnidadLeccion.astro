---
import type { Unidad } from "../../data/unidades/tipos";
import UnidadHero from "./UnidadHero.astro";
import UnidadIdeaClave from "./UnidadIdeaClave.astro";
import UnidadVideo from "./UnidadVideo.astro";
import UnidadAudio from "./UnidadAudio.astro";
import UnidadUsos from "./UnidadUsos.astro";
import UnidadFormacion from "./UnidadFormacion.astro";
import UnidadConsulta from "./UnidadConsulta.astro";
import UnidadPractica from "./UnidadPractica.astro";
import UnidadErrores from "./UnidadErrores.astro";
import UnidadEjemplos from "./UnidadEjemplos.astro";
import UnidadAplicacion from "./UnidadAplicacion.astro";
import UnidadMaterial from "./UnidadMaterial.astro";
import UnidadCaptacion from "./UnidadCaptacion.astro";
import UnidadResumen from "./UnidadResumen.astro";
import UnidadRelacionados from "./UnidadRelacionados.astro";
import UnidadStickyPractica from "./UnidadStickyPractica.astro";
import UnidadMaterialAdicional from "./UnidadMaterialAdicional.astro";
import UnidadIndiceContextual from "./UnidadIndiceContextual.astro";

interface Props {
  unidad: Unidad;
}

const { unidad } = Astro.props;

// Ronda 4: Condiciones de pestañas
const tieneTeoria = Boolean(unidad.videoTeoria);
const tieneMaterial = Boolean(
  unidad.infografia ||
  unidad.mapaMental ||
  (unidad.tarjetasDidacticas && unidad.tarjetasDidacticas.length > 0) ||
  (unidad.descargas && unidad.descargas.length > 0)
);

interface TabDef {
  id: string;
  icon: string;
  nombreDesktop: string;
  nombreMobile: string;
  badge?: number;
}

const tabs: TabDef[] = [];
if (tieneTeoria) {
  tabs.push({ id: "teoria", icon: "▶", nombreDesktop: "Teoría", nombreMobile: "Teoría" });
}
tabs.push({ id: "regla", icon: "📘", nombreDesktop: "Aprende la regla", nombreMobile: "Regla" });
tabs.push({ id: "errores", icon: "⚠️", nombreDesktop: "Errores típicos", nombreMobile: "Errores", badge: unidad.errores?.length });
tabs.push({ id: "contexto", icon: "🧳", nombreDesktop: "En contexto y práctica", nombreMobile: "Práctica" });
if (tieneMaterial) {
  tabs.push({ id: "material", icon: "📦", nombreDesktop: "Material adicional", nombreMobile: "Material" });
}

const defaultTab = tieneTeoria ? "teoria" : "regla";
---

<article
  class="u-unidad-page"
  data-unidad-page
  data-tiene-teoria={tieneTeoria ? "true" : "false"}
  data-tiene-material={tieneMaterial ? "true" : "false"}
  data-default-tab={defaultTab}
>
  <!-- Bloque 1: Cabecera Hero -->
  <UnidadHero unidad={unidad} />

  <!-- Barra de pestañas principal (Móvil y Escritorio) -->
  <div class="u-tabs-bar-wrap">
    <div class="u-tabs-container">
      <div
        class="u-tablist"
        role="tablist"
        aria-label="Secciones de la unidad"
      >
        {
          tabs.map((tab) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              class={`u-tab-btn ${tab.id === defaultTab ? "u-tab-active" : ""}`}
              aria-selected={tab.id === defaultTab ? "true" : "false"}
              aria-controls={`panel-${tab.id}`}
              tabindex={tab.id === defaultTab ? "0" : "-1"}
              data-tab={tab.id}
            >
              <span class="u-tab-icon" aria-hidden="true">{tab.icon}</span>
              <span class="u-tab-texto">
                <span class="u-tab-nom-desktop">{tab.nombreDesktop}</span>
                <span class="u-tab-nom-mobile">{tab.nombreMobile}</span>
              </span>
              {tab.badge && tab.badge > 0 && (
                <span class="u-tab-badge">{tab.badge}</span>
              )}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Contenedor central de contenidos -->
  <div class="u-cuerpo-layout">
    <div class="u-cuerpo-grid">
      <!-- Columna lateral para escritorio -->
      <aside class="u-cuerpo-sidebar" aria-label="Navegación contextual y práctica">
        <div class="u-sidebar-sticky">
          <!-- Índice contextual «En esta pestaña» (Ronda 5) -->
          <UnidadIndiceContextual
            unidad={unidad}
            tieneTeoria={tieneTeoria}
            tieneMaterial={tieneMaterial}
            defaultTab={defaultTab}
          />

          <!-- Tarjeta fija de práctica en escritorio (como en la v1) -->
          <UnidadStickyPractica practica={unidad.practica} />
        </div>
      </aside>

      <!-- Paneles principales -->
      <main class="u-cuerpo-contenido" id="contenido-unidad">
        <!-- ============================================== -->
        <!-- PANEL 1 (OPCIONAL): TEORÍA (VÍDEO + AUDIO)      -->
        <!-- ============================================== -->
        {
          tieneTeoria && (
            <section
              id="panel-teoria"
              role="tabpanel"
              aria-labelledby="tab-teoria"
              class={`u-tabpanel ${defaultTab === "teoria" ? "u-panel-active" : ""}`}
              data-panel="teoria"
              hidden={defaultTab !== "teoria"}
            >
              <div class="u-panel-flujo">
                {/* 1. Idea clave compacta */}
                {unidad.ideaClave && <UnidadIdeaClave ideaClave={unidad.ideaClave} />}

                {/* 2. Vídeo de teoría en YouTube */}
                {unidad.videoTeoria && <UnidadVideo video={unidad.videoTeoria} />}

                {/* 3. Resumen en audio si existe */}
                {unidad.audioResumen && (
                  <UnidadAudio
                    audio={unidad.audioResumen}
                    invitacion="¿Prefieres escucharlo?"
                  />
                )}
              </div>
            </section>
          )
        }

        <!-- ============================================== -->
        <!-- PANEL 2: APRENDE LA REGLA                       -->
        <!-- ============================================== -->
        <section
          id="panel-regla"
          role="tabpanel"
          aria-labelledby="tab-regla"
          class={`u-tabpanel ${defaultTab === "regla" ? "u-panel-active" : ""}`}
          data-panel="regla"
          hidden={defaultTab !== "regla"}
        >
          <div class="u-panel-flujo">
            {/* Si no hay pestaña Teoría, empieza con la idea clave como en la v1. Si existe Teoría, no se repite */}
            {!tieneTeoria && unidad.ideaClave && <UnidadIdeaClave ideaClave={unidad.ideaClave} />}

            {unidad.usos && unidad.usos.length > 0 && (
              <UnidadUsos usos={unidad.usos} usosNota={unidad.usosNota} />
            )}

            {unidad.formacion && <UnidadFormacion formacion={unidad.formacion} />}

            {unidad.consulta && unidad.consulta.length > 0 && (
              <UnidadConsulta consulta={unidad.consulta} />
            )}
          </div>
        </section>

        <!-- ============================================== -->
        <!-- PANEL 3: ERRORES TÍPICOS                        -->
        <!-- ============================================== -->
        <section
          id="panel-errores"
          role="tabpanel"
          aria-labelledby="tab-errores"
          class="u-tabpanel"
          data-panel="errores"
          hidden
        >
          <div class="u-panel-flujo">
            {unidad.errores && unidad.errores.length > 0 && (
              <UnidadErrores errores={unidad.errores} practicaUrl={unidad.practica?.url} />
            )}

            {unidad.resumen && unidad.resumen.length > 0 && (
              <UnidadResumen resumen={unidad.resumen} />
            )}
          </div>
        </section>

        <!-- ============================================== -->
        <!-- PANEL 4: EN CONTEXTO Y PRÁCTICA                 -->
        <!-- ============================================== -->
        <section
          id="panel-contexto"
          role="tabpanel"
          aria-labelledby="tab-contexto"
          class="u-tabpanel"
          data-panel="contexto"
          hidden
        >
          <div class="u-panel-flujo">
            {unidad.ejemplos && unidad.ejemplos.items && unidad.ejemplos.items.length > 0 && (
              <UnidadEjemplos ejemplos={unidad.ejemplos} />
            )}

            {unidad.aplicacion && <UnidadAplicacion aplicacion={unidad.aplicacion} />}

            {unidad.practica && <UnidadPractica practica={unidad.practica} />}

            {unidad.material && unidad.material.length > 0 && (
              <UnidadMaterial material={unidad.material} />
            )}

            {unidad.captacion && <UnidadCaptacion captacion={unidad.captacion} />}

            {unidad.relacionados && unidad.relacionados.length > 0 && (
              <UnidadRelacionados relacionados={unidad.relacionados} />
            )}
          </div>
        </section>

        <!-- ============================================== -->
        <!-- PANEL 5 (OPCIONAL): MATERIAL ADICIONAL          -->
        <!-- ============================================== -->
        {
          tieneMaterial && (
            <section
              id="panel-material"
              role="tabpanel"
              aria-labelledby="tab-material"
              class="u-tabpanel"
              data-panel="material"
              hidden
            >
              <div class="u-panel-flujo">
                <UnidadMaterialAdicional
                  infografia={unidad.infografia}
                  mapaMental={unidad.mapaMental}
                  tarjetasDidacticas={unidad.tarjetasDidacticas}
                  descargas={unidad.descargas}
                />
              </div>
            </section>
          )
        }
      </main>
    </div>
  </div>

  <!-- Barra fija inferior para móvil (como en la v1) -->
  <UnidadStickyPractica practica={unidad.practica} />
</article>

<!-- Fallback sin JavaScript: todo abierto y apilado -->
<noscript>
  <style>
    .u-tabpanel[hidden] {
      display: block !important;
      margin-bottom: 3rem;
    }
    .u-tabs-bar-wrap {
      display: none !important;
    }
    .u-sidebar-nav {
      display: none !important;
    }
  </style>
</noscript>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-unidad-page]");
    if (!root) return;

    const tabsTop = Array.from(root.querySelectorAll(".u-tablist button[role='tab']"));
    const panels = Array.from(root.querySelectorAll("main > section[role='tabpanel']"));

    const tieneTeoria = root.dataset.tieneTeoria === "true";
    const tieneMaterial = root.dataset.tieneMaterial === "true";
    const defaultTab = root.dataset.defaultTab || "regla";

    // Cerrar acordeones y detalles por defecto al cargar si hay JS
    document.querySelectorAll(".u-acordeon").forEach(function (el) {
      el.removeAttribute("open");
    });
    document.querySelectorAll(".u-error-details").forEach(function (el) {
      el.removeAttribute("open");
    });
    document.querySelectorAll(".u-ejemplo-nota-details").forEach(function (el) {
      el.removeAttribute("open");
    });

    function activarTab(nombreTab, actualizarHash) {
      if (!nombreTab) return;

      // Si intentan abrir teoria pero no hay video, redirige a regla
      if (nombreTab === "teoria" && !tieneTeoria) {
        nombreTab = "regla";
      }

      // Si intentan abrir material pero no hay materiales, redirige a default
      if (nombreTab === "material" && !tieneMaterial) {
        nombreTab = defaultTab;
      }

      tabsTop.forEach(function (t) {
        const coincide = t.dataset.tab === nombreTab;
        t.setAttribute("aria-selected", coincide ? "true" : "false");
        t.setAttribute("tabindex", coincide ? "0" : "-1");
        if (coincide) {
          t.classList.add("u-tab-active");
          try {
            t.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
          } catch (_) {}
        } else {
          t.classList.remove("u-tab-active");
        }
      });

      panels.forEach(function (p) {
        const coincide = p.dataset.panel === nombreTab;
        if (coincide) {
          p.removeAttribute("hidden");
          p.classList.add("u-panel-active");
        } else {
          p.setAttribute("hidden", "");
          p.classList.remove("u-panel-active");
        }
      });

      // Notificar al índice contextual de la columna lateral
      if (typeof window.__actualizarIndiceContextual === "function") {
        window.__actualizarIndiceContextual(nombreTab);
      }

      if (actualizarHash && window.history && window.history.replaceState) {
        window.history.replaceState(null, "", "#" + nombreTab);
      }
    }

    tabsTop.forEach(function (btn) {
      btn.addEventListener("click", function () {
        activarTab(btn.dataset.tab, true);
      });
    });

    tabsTop.forEach(function (tab, idx) {
      tab.addEventListener("keydown", function (e) {
        let siguiente = null;
        if (e.key === "ArrowRight") {
          siguiente = tabsTop[(idx + 1) % tabsTop.length];
        } else if (e.key === "ArrowLeft") {
          siguiente = tabsTop[(idx - 1 + tabsTop.length) % tabsTop.length];
        } else if (e.key === "Home") {
          siguiente = tabsTop[0];
        } else if (e.key === "End") {
          siguiente = tabsTop[tabsTop.length - 1];
        }
        if (siguiente) {
          e.preventDefault();
          siguiente.focus();
          activarTab(siguiente.dataset.tab, true);
        }
      });
    });

    function resolverHash() {
      const rawHash = window.location.hash.replace("#", "").toLowerCase();
      if (!rawHash) {
        activarTab(defaultTab, false);
        return;
      }

      let tabDestino = null;
      if (rawHash === "teoria" || rawHash === "video" || rawHash === "video-teoria" || rawHash === "audio-resumen") {
        tabDestino = tieneTeoria ? "teoria" : "regla";
      } else if (rawHash === "regla" || rawHash === "aprende" || rawHash === "usos" || rawHash === "formacion" || rawHash === "consulta") {
        tabDestino = "regla";
      } else if (rawHash === "idea-clave") {
        tabDestino = tieneTeoria ? "teoria" : "regla";
      } else if (rawHash === "errores" || rawHash === "resumen" || rawHash.startsWith("error-")) {
        tabDestino = "errores";
      } else if (rawHash === "contexto" || rawHash === "practica" || rawHash === "ejemplos" || rawHash === "aplicacion" || rawHash === "relacionados") {
        tabDestino = "contexto";
      } else if (rawHash === "material" || rawHash === "materiales" || rawHash === "recursos" || rawHash.startsWith("subpanel-")) {
        tabDestino = tieneMaterial ? "material" : defaultTab;
      }

      if (tabDestino) {
        activarTab(tabDestino, false);
        // Si el hash apunta a una sección específica, desplazarse hacia ella
        setTimeout(() => {
          if (rawHash.startsWith("subpanel-")) {
            const matSub = rawHash.replace("subpanel-", "");
            const subBtn = document.querySelector(`[data-mat-subtab="${matSub}"]`);
            if (subBtn) subBtn.click();
          }
          const targetEl = document.getElementById(rawHash);
          if (targetEl) {
            targetEl.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }, 120);
      } else {
        activarTab(defaultTab, false);
      }
    }

    resolverHash();
    window.addEventListener("hashchange", resolverHash);
  })();
</script>

<style>
  .u-unidad-page {
    position: relative;
    padding-bottom: 5.5rem; /* Espacio para barra móvil flotante */
  }

  /* Barra de pestañas sticky superior */
  .u-tabs-bar-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #ffffff;
    border-bottom: 2px solid var(--color-border, #e2ded7);
    box-shadow: 0 4px 12px rgba(11, 47, 85, 0.05);
    margin-bottom: 1.5rem;
  }

  .u-tabs-container {
    width: min(100% - 1rem, 1180px);
    margin-inline: auto;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .u-tabs-container::-webkit-scrollbar {
    display: none;
  }

  .u-tablist {
    display: flex;
    gap: 0.35rem;
    padding-top: 0.5rem;
    width: max-content;
    min-width: 100%;
  }

  @media (min-width: 768px) {
    .u-tabs-container {
      width: min(100% - 2rem, 1180px);
    }

    .u-tablist {
      width: 100%;
      justify-content: flex-start;
    }
  }

  .u-tab-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--color-border, #e2ded7);
    border-bottom: 0;
    border-radius: var(--radius-sm, 0.5rem) var(--radius-sm, 0.5rem) 0 0;
    background: var(--color-surface, #fcfbf9);
    color: var(--color-text-muted, #6d6861);
    font-family: var(--font-body, "Inter", sans-serif);
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    position: relative;
    flex-shrink: 0;
  }

  .u-tab-nom-desktop {
    display: inline;
  }

  .u-tab-nom-mobile {
    display: none;
  }

  @media (max-width: 640px) {
    .u-tab-btn {
      padding: 0.55rem 0.65rem;
      font-size: 0.8rem;
      gap: 0.3rem;
    }

    .u-tab-nom-desktop {
      display: none;
    }

    .u-tab-nom-mobile {
      display: inline;
    }
  }

  .u-tab-btn:hover {
    background: #ffffff;
    color: var(--color-blue, #0055a4);
  }

  .u-tab-btn:focus-visible {
    outline: 2px solid var(--color-blue, #0055a4);
    outline-offset: -2px;
  }

  .u-tab-active {
    background: var(--color-blue-dark, #0b2f55) !important;
    border-color: var(--color-blue-dark, #0b2f55) !important;
    color: #ffffff !important;
    font-weight: 700;
  }

  .u-tab-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  .u-tab-badge {
    background: rgba(185, 64, 53, 0.15);
    color: #9a3329;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .u-tab-active .u-tab-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Layout principal */
  .u-cuerpo-layout {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    padding-block: 1rem 2.5rem;
  }

  .u-cuerpo-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .u-cuerpo-sidebar {
    display: none;
  }

  .u-cuerpo-contenido {
    min-width: 0;
  }

  .u-panel-flujo {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  /* Escritorio */
  @media (min-width: 1024px) {
    .u-unidad-page {
      padding-bottom: 2.5rem;
    }

    .u-cuerpo-grid {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }

    .u-cuerpo-sidebar {
      display: block;
    }

    .u-sidebar-sticky {
      position: sticky;
      top: 5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  /* Paneles */
  .u-tabpanel {
    display: none;
  }

  .u-tabpanel.u-panel-active,
  .u-tabpanel:not([hidden]) {
    display: block;
    animation: uFadeIn 0.2s ease-in-out;
  }

  @keyframes uFadeIn {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
