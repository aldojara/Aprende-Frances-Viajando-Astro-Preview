---
import type { Unidad } from "../../data/unidades/tipos";
import UnidadHero from "./UnidadHero.astro";
import UnidadIdeaClave from "./UnidadIdeaClave.astro";
import UnidadVideo from "./UnidadVideo.astro";
import UnidadAudio from "./UnidadAudio.astro";
import UnidadUsos from "./UnidadUsos.astro";
import UnidadFormacion from "./UnidadFormacion.astro";
import UnidadConsulta from "./UnidadConsulta.astro";
import UnidadInfografia from "./UnidadInfografia.astro";
import UnidadMapaMental from "./UnidadMapaMental.astro";
import UnidadPractica from "./UnidadPractica.astro";
import UnidadErrores from "./UnidadErrores.astro";
import UnidadTarjetas from "./UnidadTarjetas.astro";
import UnidadEjemplos from "./UnidadEjemplos.astro";
import UnidadAplicacion from "./UnidadAplicacion.astro";
import UnidadMaterial from "./UnidadMaterial.astro";
import UnidadCaptacion from "./UnidadCaptacion.astro";
import UnidadResumen from "./UnidadResumen.astro";
import UnidadRelacionados from "./UnidadRelacionados.astro";
import UnidadStickyPractica from "./UnidadStickyPractica.astro";
import UnidadDescargas from "./UnidadDescargas.astro";

interface Props {
  unidad: Unidad;
}

const { unidad } = Astro.props;
---

<article class="u-unidad-page" data-unidad-page>
  <!-- Bloque 1: Cabecera Hero -->
  <UnidadHero unidad={unidad} />

  <!-- Barra de pestañas principal (Móvil y Escritorio) -->
  <div class="u-tabs-bar-wrap">
    <div class="u-tabs-container">
      <div
        class="u-tablist"
        role="tablist"
        aria-label="Secciones de la unidad"
      >
        <button
          type="button"
          role="tab"
          id="tab-regla"
          class="u-tab-btn u-tab-active"
          aria-selected="true"
          aria-controls="panel-regla"
          tabindex="0"
          data-tab="regla"
        >
          <span class="u-tab-icon" aria-hidden="true">📘</span>
          <span class="u-tab-texto">Aprende la regla</span>
        </button>

        <button
          type="button"
          role="tab"
          id="tab-errores"
          class="u-tab-btn"
          aria-selected="false"
          aria-controls="panel-errores"
          tabindex="-1"
          data-tab="errores"
        >
          <span class="u-tab-icon" aria-hidden="true">⚠️</span>
          <span class="u-tab-texto">Errores típicos</span>
          {unidad.errores && unidad.errores.length > 0 && (
            <span class="u-tab-badge">{unidad.errores.length}</span>
          )}
        </button>

        <button
          type="button"
          role="tab"
          id="tab-contexto"
          class="u-tab-btn"
          aria-selected="false"
          aria-controls="panel-contexto"
          tabindex="-1"
          data-tab="contexto"
        >
          <span class="u-tab-icon" aria-hidden="true">🧳</span>
          <span class="u-tab-texto">En contexto y práctica</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Contenedor central de contenidos -->
  <div class="u-cuerpo-layout">
    <div class="u-cuerpo-grid">
      <!-- Columna lateral para escritorio -->
      <aside class="u-cuerpo-sidebar" aria-label="Navegación y práctica">
        <div class="u-sidebar-sticky">
          <!-- Menú de pestañas vertical en escritorio -->
          <nav class="u-sidebar-nav" aria-label="Pestañas de la lección">
            <span class="u-sidebar-nav-titulo">Contenido de la unidad</span>
            <div class="u-sidebar-tablist" role="tablist" aria-orientation="vertical">
              <button
                type="button"
                role="tab"
                id="side-tab-regla"
                class="u-side-tab u-side-active"
                aria-selected="true"
                aria-controls="panel-regla"
                data-tab="regla"
              >
                <span class="u-side-num">01</span>
                <span class="u-side-texto">Aprende la regla</span>
              </button>

              <button
                type="button"
                role="tab"
                id="side-tab-errores"
                class="u-side-tab"
                aria-selected="false"
                aria-controls="panel-errores"
                data-tab="errores"
              >
                <span class="u-side-num">02</span>
                <span class="u-side-texto">Errores típicos</span>
              </button>

              <button
                type="button"
                role="tab"
                id="side-tab-contexto"
                class="u-side-tab"
                aria-selected="false"
                aria-controls="panel-contexto"
                data-tab="contexto"
              >
                <span class="u-side-num">03</span>
                <span class="u-side-texto">En contexto y práctica</span>
              </button>
            </div>
          </nav>

          <!-- Tarjeta fija de práctica en escritorio -->
          <UnidadStickyPractica practica={unidad.practica} />

          <!-- Descargas en columna lateral en escritorio -->
          {unidad.descargas && unidad.descargas.length > 0 && (
            <UnidadDescargas descargas={unidad.descargas} modo="desktop" />
          )}
        </div>
      </aside>

      <!-- Paneles principales -->
      <main class="u-cuerpo-contenido" id="contenido-unidad">
        <!-- ============================================== -->
        <!-- PANEL 1: APRENDE LA REGLA                       -->
        <!-- ============================================== -->
        <section
          id="panel-regla"
          role="tabpanel"
          aria-labelledby="tab-regla"
          class="u-tabpanel u-panel-active"
          data-panel="regla"
        >
          <div class="u-panel-flujo">
            {unidad.ideaClave && <UnidadIdeaClave ideaClave={unidad.ideaClave} />}

            {/* Vídeo de teoría opcional (YouTube facade) */}
            {unidad.videoTeoria && <UnidadVideo video={unidad.videoTeoria} />}

            {/* Resumen en audio opcional */}
            {unidad.audioResumen && <UnidadAudio audio={unidad.audioResumen} />}

            {unidad.usos && unidad.usos.length > 0 && (
              <UnidadUsos usos={unidad.usos} usosNota={unidad.usosNota} />
            )}

            {unidad.formacion && <UnidadFormacion formacion={unidad.formacion} />}

            {unidad.consulta && unidad.consulta.length > 0 && (
              <UnidadConsulta consulta={unidad.consulta} />
            )}

            {/* Infografía visual opcional */}
            {unidad.infografia && <UnidadInfografia infografia={unidad.infografia} />}

            {/* Mapa mental NotebookLM opcional */}
            {unidad.mapaMental && <UnidadMapaMental mapa={unidad.mapaMental} />}

            {/* Descargas al final de pestaña 1 en móvil */}
            {unidad.descargas && unidad.descargas.length > 0 && (
              <UnidadDescargas descargas={unidad.descargas} modo="mobile" />
            )}
          </div>
        </section>

        <!-- ============================================== -->
        <!-- PANEL 2: ERRORES TÍPICOS                        -->
        <!-- ============================================== -->
        <section
          id="panel-errores"
          role="tabpanel"
          aria-labelledby="tab-errores"
          class="u-tabpanel"
          data-panel="errores"
          hidden
        >
          <div class="u-panel-flujo">
            {unidad.errores && unidad.errores.length > 0 && (
              <UnidadErrores errores={unidad.errores} practicaUrl={unidad.practica?.url} />
            )}

            {unidad.resumen && unidad.resumen.length > 0 && (
              <UnidadResumen resumen={unidad.resumen} />
            )}
          </div>
        </section>

        <!-- ============================================== -->
        <!-- PANEL 3: EN CONTEXTO Y PRÁCTICA                 -->
        <!-- ============================================== -->
        <section
          id="panel-contexto"
          role="tabpanel"
          aria-labelledby="tab-contexto"
          class="u-tabpanel"
          data-panel="contexto"
          hidden
        >
          <div class="u-panel-flujo">
            {/* Tarjetas didácticas opcionales */}
            {unidad.tarjetasDidacticas && unidad.tarjetasDidacticas.length > 0 && (
              <UnidadTarjetas tarjetas={unidad.tarjetasDidacticas} />
            )}

            {unidad.ejemplos && unidad.ejemplos.items && unidad.ejemplos.items.length > 0 && (
              <UnidadEjemplos ejemplos={unidad.ejemplos} />
            )}

            {unidad.aplicacion && <UnidadAplicacion aplicacion={unidad.aplicacion} />}

            {unidad.practica && <UnidadPractica practica={unidad.practica} />}

            {unidad.material && unidad.material.length > 0 && (
              <UnidadMaterial material={unidad.material} />
            )}

            {unidad.captacion && <UnidadCaptacion captacion={unidad.captacion} />}

            {unidad.relacionados && unidad.relacionados.length > 0 && (
              <UnidadRelacionados relacionados={unidad.relacionados} />
            )}
          </div>
        </section>
      </main>
    </div>
  </div>

  <!-- Barra fija inferior para móvil -->
  <UnidadStickyPractica practica={unidad.practica} />
</article>

<!-- Fallback sin JavaScript: todo abierto y apilado -->
<noscript>
  <style>
    .u-tabpanel[hidden] {
      display: block !important;
      margin-bottom: 3rem;
    }
    .u-tabs-bar-wrap {
      display: none !important;
    }
    .u-sidebar-nav {
      display: none !important;
    }
  </style>
</noscript>

<script is:inline>
  (function () {
    const root = document.querySelector("[data-unidad-page]");
    if (!root) return;

    const tabsTop = Array.from(root.querySelectorAll(".u-tablist button[role='tab']"));
    const tabsSide = Array.from(root.querySelectorAll(".u-sidebar-tablist button[role='tab']"));
    const panels = Array.from(root.querySelectorAll("section[role='tabpanel']"));

    // Cerrar acordeones y detalles por defecto al cargar si hay JS
    document.querySelectorAll(".u-acordeon").forEach(function (el) {
      el.removeAttribute("open");
    });
    document.querySelectorAll(".u-error-details").forEach(function (el) {
      el.removeAttribute("open");
    });
    document.querySelectorAll(".u-ejemplo-nota-details").forEach(function (el) {
      el.removeAttribute("open");
    });

    function activarTab(nombreTab, actualizarHash) {
      if (!nombreTab) return;

      tabsTop.forEach(function (t) {
        const coincide = t.dataset.tab === nombreTab;
        t.setAttribute("aria-selected", coincide ? "true" : "false");
        t.setAttribute("tabindex", coincide ? "0" : "-1");
        if (coincide) {
          t.classList.add("u-tab-active");
        } else {
          t.classList.remove("u-tab-active");
        }
      });

      tabsSide.forEach(function (t) {
        const coincide = t.dataset.tab === nombreTab;
        t.setAttribute("aria-selected", coincide ? "true" : "false");
        t.setAttribute("tabindex", coincide ? "0" : "-1");
        if (coincide) {
          t.classList.add("u-side-active");
        } else {
          t.classList.remove("u-side-active");
        }
      });

      panels.forEach(function (p) {
        const coincide = p.dataset.panel === nombreTab;
        if (coincide) {
          p.removeAttribute("hidden");
          p.classList.add("u-panel-active");
        } else {
          p.setAttribute("hidden", "");
          p.classList.remove("u-panel-active");
        }
      });

      if (actualizarHash && window.history && window.history.replaceState) {
        window.history.replaceState(null, "", "#" + nombreTab);
      }
    }

    [...tabsTop, ...tabsSide].forEach(function (btn) {
      btn.addEventListener("click", function () {
        activarTab(btn.dataset.tab, true);
      });
    });

    tabsTop.forEach(function (tab, idx) {
      tab.addEventListener("keydown", function (e) {
        let siguiente = null;
        if (e.key === "ArrowRight") {
          siguiente = tabsTop[(idx + 1) % tabsTop.length];
        } else if (e.key === "ArrowLeft") {
          siguiente = tabsTop[(idx - 1 + tabsTop.length) % tabsTop.length];
        } else if (e.key === "Home") {
          siguiente = tabsTop[0];
        } else if (e.key === "End") {
          siguiente = tabsTop[tabsTop.length - 1];
        }
        if (siguiente) {
          e.preventDefault();
          siguiente.focus();
          activarTab(siguiente.dataset.tab, true);
        }
      });
    });

    function resolverHash() {
      const hash = window.location.hash.replace("#", "").toLowerCase();
      if (hash === "errores") {
        activarTab("errores", false);
      } else if (hash === "contexto" || hash === "practica" || hash === "ejemplos") {
        activarTab("contexto", false);
      } else if (hash === "regla" || hash === "aprende" || hash === "idea-clave") {
        activarTab("regla", false);
      }
    }

    resolverHash();
    window.addEventListener("hashchange", resolverHash);
  })();
</script>

<style>
  .u-unidad-page {
    background-color: var(--color-bg, #f7f4ed);
    color: var(--color-text, #2e2b27);
    font-family: var(--font-body, "Inter", Arial, sans-serif);
    line-height: 1.6;
    min-height: 100vh;
    padding-bottom: 5rem;
  }

  /* Barra de pestañas */
  .u-tabs-bar-wrap {
    position: sticky;
    top: 0;
    z-index: 40;
    background: #ffffff;
    border-bottom: 1px solid var(--color-border, #e2ded7);
    box-shadow: 0 4px 16px rgba(11, 47, 85, 0.05);
    backdrop-filter: blur(10px);
  }

  .u-tabs-container {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
  }

  .u-tablist {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 0.55rem 0;
  }

  .u-tablist::-webkit-scrollbar {
    display: none;
  }

  .u-tab-btn {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    background: var(--color-surface-soft, #efede8);
    border: 1px solid transparent;
    color: var(--color-text, #2e2b27);
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.16s ease;
  }

  .u-tab-btn:hover {
    background: #ffffff;
    border-color: var(--color-border, #e2ded7);
    color: var(--color-blue-dark, #0b2f55);
  }

  .u-tab-active {
    background: var(--color-blue-dark, #0b2f55) !important;
    color: #ffffff !important;
    box-shadow: 0 4px 12px rgba(11, 47, 85, 0.2);
  }

  .u-tab-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  .u-tab-badge {
    background: rgba(185, 64, 53, 0.15);
    color: #9a3329;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .u-tab-active .u-tab-badge {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* Layout principal */
  .u-cuerpo-layout {
    width: min(100% - 2rem, 1180px);
    margin-inline: auto;
    padding-block: 1.5rem 2.5rem;
  }

  .u-cuerpo-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .u-cuerpo-sidebar {
    display: none;
  }

  .u-cuerpo-contenido {
    min-width: 0;
  }

  .u-panel-flujo {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  /* Escritorio */
  @media (min-width: 1024px) {
    .u-unidad-page {
      padding-bottom: 2.5rem;
    }

    .u-cuerpo-grid {
      display: grid;
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 3.5rem;
      align-items: start;
    }

    .u-cuerpo-sidebar {
      display: block;
    }

    .u-sidebar-sticky {
      position: sticky;
      top: 5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .u-sidebar-nav {
      background: #ffffff;
      border: 1px solid var(--color-border, #e2ded7);
      border-radius: var(--radius-md, 0.875rem);
      padding: 1.15rem 1rem;
      box-shadow: 0 4px 16px rgba(11, 47, 85, 0.04);
    }

    .u-sidebar-nav-titulo {
      display: block;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-muted, #6d6861);
      margin-bottom: 0.75rem;
      padding-bottom: 0.45rem;
      border-bottom: 1px solid var(--color-border, #e2ded7);
    }

    .u-sidebar-tablist {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }

    .u-side-tab {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      padding: 0.6rem 0.75rem;
      border-radius: var(--radius-sm, 0.5rem);
      background: transparent;
      border: 1px solid transparent;
      color: var(--color-text-muted, #6d6861);
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
      transition: all 0.16s ease;
    }

    .u-side-num {
      font-size: 0.74rem;
      font-weight: 800;
      color: var(--color-gold, #b8860b);
      width: 1.4rem;
      flex-shrink: 0;
    }

    .u-side-tab:hover {
      background: var(--color-surface-soft, #efede8);
      color: var(--color-blue-dark, #0b2f55);
    }

    .u-side-active {
      background: rgba(0, 85, 164, 0.08) !important;
      border-color: rgba(0, 85, 164, 0.25) !important;
      color: var(--color-blue-dark, #0b2f55) !important;
      font-weight: 700;
    }

    .u-cuerpo-contenido {
      max-width: 840px;
    }
  }

  @media (max-width: 640px) {
    .u-cuerpo-layout {
      width: min(100% - 1.5rem, 640px);
      padding-block: 1rem 1.8rem;
    }

    .u-panel-flujo {
      gap: 0.85rem;
    }

    .u-tab-btn {
      padding: 0.42rem 0.85rem;
      font-size: 0.84rem;
    }
  }
</style>
