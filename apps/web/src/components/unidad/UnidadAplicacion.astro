---
import type { Unidad } from "../../data/unidades/tipos";

interface Props {
  aplicacion?: Unidad["aplicacion"];
}

const { aplicacion } = Astro.props;
if (!aplicacion) return null;
---

<section class="u-seccion u-aplicacion" id="aplicacion" aria-labelledby="aplicacion-titulo">
  <div class="u-seccion-header">
    <p class="u-eyebrow">Práctica de producción activa</p>
    <h2 id="aplicacion-titulo" class="u-seccion-titulo">Tu turno: cuenta tu viaje</h2>
    <p class="u-seccion-sub">
      La mejor forma de fijar la gramática es escribir sobre tus propias vivencias.
    </p>
  </div>

  <div class="u-aplicacion-card">
    <div class="u-app-consigna-box">
      <div class="u-app-icono" aria-hidden="true">✍️</div>
      <div class="u-app-consigna-cuerpo">
        <span class="u-app-tag">Tu reto de escritura</span>
        <p class="u-app-consigna-texto">{aplicacion.consigna}</p>
      </div>
    </div>

    {
      aplicacion.requisitos && aplicacion.requisitos.length > 0 && (
        <div class="u-app-requisitos">
          <p class="u-req-titulo">Incluye en tus frases:</p>
          <ul class="u-req-chips">
            {aplicacion.requisitos.map((req) => (
              <li class="u-req-chip">
                <span class="u-req-check" aria-hidden="true">✓</span>
                <span>{req}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      aplicacion.modelo && (
        <div class="u-app-modelo-box">
          <div class="u-modelo-head">
            <span class="u-modelo-tag">Ejemplo modelo</span>
            <span class="u-modelo-pista">Puedes inspirarte en esta estructura:</span>
          </div>
          <blockquote class="u-modelo-cita" lang="fr">
            «{aplicacion.modelo}»
          </blockquote>
        </div>
      )
    }
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: 5rem;
  }

  .u-seccion-header {
    margin-bottom: 1.5rem;
  }

  .u-eyebrow {
    margin: 0 0 0.35rem;
    color: var(--color-blue, #0055a4);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .u-seccion-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: clamp(1.6rem, 3.2vw, 2.1rem);
    color: var(--color-blue-dark, #0b2f55);
    margin: 0 0 0.45rem;
    line-height: 1.2;
  }

  .u-seccion-sub {
    font-size: 0.98rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
    line-height: 1.5;
  }

  .u-aplicacion-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-lg, 1.25rem);
    padding: 1.75rem;
    box-shadow: 0 4px 18px rgba(11, 47, 85, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .u-app-consigna-box {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-border, #e2ded7);
  }

  .u-app-icono {
    font-size: 1.7rem;
    flex-shrink: 0;
    line-height: 1.2;
  }

  .u-app-consigna-cuerpo {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .u-app-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-gold, #b8860b);
  }

  .u-app-consigna-texto {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.45;
  }

  /* Requisitos */
  .u-app-requisitos {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .u-req-titulo {
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
  }

  .u-req-chips {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .u-req-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-surface-soft, #efede8);
    border: 1px solid var(--color-border, #e2ded7);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text, #2e2b27);
  }

  .u-req-check {
    color: #276749;
    font-weight: 800;
  }

  /* Modelo */
  .u-app-modelo-box {
    background: rgba(247, 244, 237, 0.7);
    border-left: 4px solid var(--color-gold, #b8860b);
    border-radius: 0 var(--radius-md, 0.875rem) var(--radius-md, 0.875rem) 0;
    padding: 1.1rem 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .u-modelo-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .u-modelo-tag {
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-gold, #b8860b);
  }

  .u-modelo-pista {
    font-size: 0.85rem;
    color: var(--color-text-muted, #6d6861);
  }

  .u-modelo-cita {
    margin: 0;
    font-size: 1rem;
    font-style: italic;
    color: var(--color-blue-dark, #0b2f55);
    line-height: 1.55;
  }

  @media (max-width: 640px) {
    .u-aplicacion-card {
      padding: 1.25rem;
    }
  }
</style>
