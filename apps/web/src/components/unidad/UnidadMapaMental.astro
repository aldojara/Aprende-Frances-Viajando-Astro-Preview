---
import type { NodoMapaMental } from "../../data/unidades/tipos";

interface Props {
  mapa?: NodoMapaMental;
}

const { mapa } = Astro.props;
if (!mapa) return null;
---

<section class="u-seccion u-mapa-bloque" id="mapa-mental" aria-labelledby="mapa-mental-titulo">
  <div class="u-mapa-card">
    <div class="u-mapa-header">
      <span class="u-mapa-badge">🧠 Mapa mental conceptual</span>
      <h3 id="mapa-mental-titulo" class="u-mapa-titulo">Estructura del tema</h3>
      <p class="u-mapa-sub">Explora las ramas para ver las conexiones lógicas.</p>
    </div>

    <div class="u-arbol-wrap">
      <!-- Nodo raíz -->
      <details class="u-arbol-nodo u-nodo-raiz" open>
        <summary class="u-arbol-summary">
          <span class="u-arbol-caret" aria-hidden="true">▾</span>
          <strong class="u-arbol-texto-raiz">{mapa.titulo}</strong>
          {mapa.nota && <span class="u-arbol-nota">{mapa.nota}</span>}
        </summary>

        {
          mapa.hijos && mapa.hijos.length > 0 && (
            <div class="u-arbol-ramas">
              {mapa.hijos.map((hijo1) => (
                <div class="u-rama-item">
                  {hijo1.hijos && hijo1.hijos.length > 0 ? (
                    <details class="u-arbol-nodo" open>
                      <summary class="u-arbol-summary">
                        <span class="u-arbol-caret" aria-hidden="true">▾</span>
                        <span class="u-arbol-texto-h1">{hijo1.titulo}</span>
                        {hijo1.nota && <span class="u-arbol-nota">{hijo1.nota}</span>}
                      </summary>
                      <div class="u-arbol-ramas">
                        {hijo1.hijos.map((hijo2) => (
                          <div class="u-rama-item">
                            {hijo2.hijos && hijo2.hijos.length > 0 ? (
                              <details class="u-arbol-nodo" open>
                                <summary class="u-arbol-summary">
                                  <span class="u-arbol-caret" aria-hidden="true">▾</span>
                                  <span class="u-arbol-texto-h2">{hijo2.titulo}</span>
                                  {hijo2.nota && <span class="u-arbol-nota">{hijo2.nota}</span>}
                                </summary>
                                <ul class="u-arbol-hojas">
                                  {hijo2.hijos.map((hijo3) => (
                                    <li class="u-arbol-hoja">
                                      <span class="u-hoja-bullet" aria-hidden="true">•</span>
                                      <span class="u-arbol-texto-h3">{hijo3.titulo}</span>
                                      {hijo3.nota && <span class="u-arbol-nota">{hijo3.nota}</span>}
                                    </li>
                                  ))}
                                </ul>
                              </details>
                            ) : (
                              <div class="u-arbol-hoja">
                                <span class="u-hoja-bullet" aria-hidden="true">•</span>
                                <span class="u-arbol-texto-h2">{hijo2.titulo}</span>
                                {hijo2.nota && <span class="u-arbol-nota">{hijo2.nota}</span>}
                              </div>
                            )}
                          </div>
                        ))}
                      </div>
                    </details>
                  ) : (
                    <div class="u-arbol-hoja">
                      <span class="u-hoja-bullet" aria-hidden="true">•</span>
                      <span class="u-arbol-texto-h1">{hijo1.titulo}</span>
                      {hijo1.nota && <span class="u-arbol-nota">{hijo1.nota}</span>}
                    </div>
                  )}
                </div>
              ))}
            </div>
          )
        }
      </details>
    </div>
  </div>
</section>

<style>
  .u-seccion {
    scroll-margin-top: var(--u-scroll-margin, 9.25rem);
  }

  .u-mapa-card {
    background: #ffffff;
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-md, 0.875rem);
    padding: 1rem 1.25rem;
    box-shadow: 0 2px 8px rgba(11, 47, 85, 0.03);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .u-mapa-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .u-mapa-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: rgba(184, 134, 11, 0.12);
    color: #8b6508;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .u-mapa-titulo {
    font-family: var(--font-display, "Playfair Display", Georgia, serif);
    font-size: 1.15rem;
    color: var(--color-blue-dark, #0b2f55);
    margin: 0;
    line-height: 1.25;
  }

  .u-mapa-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted, #6d6861);
    margin: 0;
  }

  /* Estructura del árbol */
  .u-arbol-wrap {
    background: var(--color-surface-soft, #efede8);
    border: 1px solid var(--color-border, #e2ded7);
    border-radius: var(--radius-sm, 0.5rem);
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
  }

  .u-arbol-nodo {
    display: flex;
    flex-direction: column;
  }

  .u-arbol-summary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    list-style: none;
    padding: 0.25rem 0.45rem;
    border-radius: 4px;
    user-select: none;
    transition: background 0.15s ease;
  }

  .u-arbol-summary::-webkit-details-marker {
    display: none;
  }

  .u-arbol-summary:hover {
    background: rgba(11, 47, 85, 0.06);
  }

  .u-arbol-summary:focus-visible {
    outline: 2px solid var(--color-blue, #0055a4);
    outline-offset: 1px;
    border-radius: 4px;
  }

  .u-arbol-caret {
    font-size: 0.8rem;
    color: var(--color-gold-text, #855d00);
    transition: transform 0.18s ease;
    display: inline-block;
    width: 12px;
  }

  .u-arbol-nodo:not([open]) > .u-arbol-summary .u-arbol-caret {
    transform: rotate(-90deg);
  }

  .u-arbol-texto-raiz {
    color: var(--color-blue-dark, #0b2f55);
    font-size: 0.98rem;
  }

  .u-arbol-texto-h1 {
    font-weight: 700;
    color: var(--color-heading, #0b2f55);
  }

  .u-arbol-texto-h2 {
    font-weight: 600;
    color: var(--color-text, #2e2b27);
  }

  .u-arbol-texto-h3 {
    color: var(--color-text, #2e2b27);
  }

  .u-arbol-nota {
    font-size: 0.76rem;
    color: var(--color-text-muted, #6d6861);
    background: rgba(255, 255, 255, 0.6);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    border: 1px solid var(--color-border, #e2ded7);
  }

  .u-arbol-ramas {
    padding-left: 1.25rem;
    border-left: 1.5px dashed rgba(11, 47, 85, 0.2);
    margin-left: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.25rem;
  }

  .u-rama-item {
    display: flex;
    flex-direction: column;
  }

  .u-arbol-hojas {
    list-style: none;
    padding: 0 0 0 1.25rem;
    border-left: 1.5px dashed rgba(11, 47, 85, 0.2);
    margin: 0.25rem 0 0 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .u-arbol-hoja {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.45rem;
  }

  .u-hoja-bullet {
    color: var(--color-gold-text, #855d00);
    font-size: 1rem;
    line-height: 1;
  }
</style>
