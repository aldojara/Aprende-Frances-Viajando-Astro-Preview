---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" focusable="false">
  {
    name === "target" && (
      <>
        <circle cx="12" cy="12" r="8" />
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v3M22 12h-3M12 22v-3M2 12h3" />
      </>
    )
  }
  {
    name === "trophy" && (
      <>
        <path d="M8 4h8v5a4 4 0 0 1-8 0z" />
        <path d="M8 6H5a3 3 0 0 0 3 4" />
        <path d="M16 6h3a3 3 0 0 1-3 4" />
        <path d="M12 13v4" />
        <path d="M9 21h6" />
        <path d="M10 17h4" />
      </>
    )
  }
  {name === "star" && <path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" />}
  {name === "check" && <><circle cx="12" cy="12" r="9" /><path d="m8 12 2.5 2.5L16.5 8" /></>}
  {name === "shield" && <><path d="M12 3 19 6v5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V6z" /><path d="m9 12 2 2 4-5" /></>}
  {name === "headphones" && <><path d="M4 13a8 8 0 0 1 16 0" /><path d="M6 13v5a2 2 0 0 0 2 2h1v-7z" /><path d="M18 13v5a2 2 0 0 1-2 2h-1v-7z" /></>}
  {name === "book" && <><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H7a3 3 0 0 0-3 3z" /><path d="M4 5.5V21" /><path d="M8 7h8M8 11h8" /></>}
  {name === "pen" && <><path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10z" /><path d="m14 7 3 3" /></>}
  {name === "chat" && <><path d="M5 6h14v9H9l-4 4z" /><path d="M9 10h6" /></>}
  {name === "id" && <><path d="M4 6h16v12H4z" /><path d="M8 10h3" /><path d="M8 14h8" /><circle cx="15.5" cy="10" r="1.5" /></>}
  {name === "group" && <><path d="M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6" /><path d="M17 12a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5" /><path d="M4 20a5 5 0 0 1 10 0" /><path d="M14 20a4 4 0 0 1 6 0" /></>}
  {name === "clock" && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === "mic" && <><path d="M12 14a3 3 0 0 0 3-3V6a3 3 0 0 0-6 0v5a3 3 0 0 0 3 3" /><path d="M5 11a7 7 0 0 0 14 0" /><path d="M12 18v3" /></>}
  {name === "clipboard" && <><path d="M8 4h8l1 3H7z" /><path d="M6 6h12v15H6z" /><path d="M9 12h6M9 16h4" /></>}
</svg>

<style>
  svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }
</style>
