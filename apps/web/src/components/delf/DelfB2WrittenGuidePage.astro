---
import { withBase } from "../../utils/paths";
import {
  readingErrors,
  readingEvaluation,
  readingParts,
  readingPracticeLinks,
  readingRoute,
  readingStrategies,
  readingTextTypes,
  readingTips,
  writingBuildSteps,
  writingErrors,
  writingEvaluation,
  writingResources,
  writingRoute,
  writingStrategies,
  writingTasks,
  type WrittenGuide,
  type WrittenIcon,
} from "../../data/delfB2WrittenGuides";

interface Props {
  guide: WrittenGuide;
}

const { guide } = Astro.props;
const isWriting = guide.kind === "writing";
const levelHref = withBase("/delf/b2/");
const structureHref = withBase("/delf/b2/estructura-del-examen/");
const speakingHref = withBase("/delf/b2/production-orale/");

const icons: Record<WrittenIcon, string> = {
  audio: '<path d="M4 13a8 8 0 0 1 16 0"/><path d="M6 13v5a2 2 0 0 0 2 2h1v-7z"/><path d="M18 13v5a2 2 0 0 1-2 2h-1v-7z"/>',
  award: '<circle cx="12" cy="8" r="5"/><path d="m8.5 12-1.5 8 5-3 5 3-1.5-8"/><path d="m10 8 1.5 1.5L15 6"/>',
  book: '<path d="M5 4c2.7-.8 5-.4 7 1.2 2-1.6 4.3-2 7-1.2v15c-2.7-.8-5-.4-7 1.2-2-1.6-4.3-2-7-1.2z"/><path d="M12 5.2v15"/>',
  chart: '<path d="M4 20V6"/><path d="M4 20h16"/><path d="M8 16v-5"/><path d="M12 16V8"/><path d="M16 16v-8"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16.5 8"/>',
  clipboard: '<path d="M8 5h8"/><path d="M9 3h6v4H9z"/><path d="M6 5H5v16h14V5h-1"/><path d="M8 12h8M8 16h6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2.2 5-4.8 2 2.2-5z"/>',
  document: '<path d="M6 3h10l3 3v15H6z"/><path d="M16 3v4h4"/><path d="M9 12h6M9 16h5"/>',
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  edit: '<path d="m4 20 4.5-1 10-10a2.1 2.1 0 0 0-3-3l-10 10z"/><path d="m14 7 3 3"/>',
  eye: '<path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6z"/><circle cx="12" cy="12" r="3"/>',
  link: '<path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7-7.1l-1.2 1.2"/><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2a5 5 0 0 0 7 7.1l1.2-1.2"/>',
  list: '<path d="M8 6h12M8 12h12M8 18h12"/><path d="M4 6h.01M4 12h.01M4 18h.01"/>',
  pen: '<path d="m14 4 6 6-9.5 9.5-6.8 1.3 1.3-6.8z"/><path d="m12 6 6 6"/>',
  quote: '<path d="M8 7H5v5h3v5l4-8V7H8z"/><path d="M17 7h-3v5h3v5l4-8V7h-4z"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/>',
  shield: '<path d="M12 3 19 6v5c0 4.5-2.8 8-7 10-4.2-2-7-5.5-7-10V6z"/><path d="m9 12 2 2 4-5"/>',
  spark: '<path d="m12 3 1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M5 19h.01M19 5h.01"/>',
  star: '<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  target: '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="4"/><path d="M12 2v3M22 12h-3M12 22v-3M2 12h3"/>',
};
---

<main class:list={["b2-written-page", `b2-written-${guide.kind}`]}>
  <div class="container page-wrap">
    <nav class="breadcrumb" aria-label="Miga de pan">
      <a href={withBase("/")}>Inicio</a>
      <span aria-hidden="true">›</span>
      <a href={withBase("/delf/")}>DELF</a>
      <span aria-hidden="true">›</span>
      <a href={levelHref}>B2</a>
      <span aria-hidden="true">›</span>
      <span>{guide.breadcrumb}</span>
    </nav>

    <div class="guide-layout">
      <aside class="page-index" aria-label="Índice de la página">
        <div class="index-head">
          <span aria-hidden="true">B2</span>
          <h2>DELF B2</h2>
        </div>
        <nav>
          <p>Índice de la página</p>
          <ol>
            {guide.toc.map((item) => (
              <li>
                <a href={`#${item.id}`}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[item.icon]} />
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
        <a class="download-card" href={structureHref}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.download} />
          <strong>Guía completa DELF B2</strong>
          <small>Todo lo que necesitas saber para aprobar.</small>
          <span>Ver guía del examen</span>
        </a>
      </aside>

      <div class="guide-main">
        <details class="mobile-index">
          <summary>Índice de la página</summary>
          <ol>
            {guide.toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
          </ol>
        </details>

        <section id={isWriting ? "resumen-seccion" : "resumen"} class="hero-section" aria-labelledby="page-title">
          <div class="hero-copy">
            <div class="hero-badges" aria-label="Metadatos de la guía">
              <span class="badge badge-level">B2</span>
              <span class="badge">Guía del examen</span>
              <span class="badge badge-time">{guide.durationBadge}</span>
              <span class="badge badge-ready">Disponible</span>
            </div>
            <h1 id="page-title">{guide.title}</h1>
            {guide.subtitle && <p class="hero-subtitle">{guide.subtitle}</p>}
            {guide.intro.split("\n\n").map((paragraph) => <p>{paragraph}</p>)}
            <a class="button hero-action" href={guide.ctaHref}>
              {guide.ctaLabel}
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <figure class="paris-visual" aria-label="Ilustración de París con la Torre Eiffel">
            <svg viewBox="0 0 720 330" role="img" aria-labelledby={`${guide.kind}-paris-title`} focusable="false">
              <title id={`${guide.kind}-paris-title`}>Paisaje parisino con la Torre Eiffel y arquitectura francesa</title>
              <path class="wash wash-blue" d="M392 145c56-65 149-73 213-16 51 46 48 118-1 154-63 46-164 19-220-41-38-41-35-70 8-97z" />
              <path class="wash wash-gold" d="M58 251c68-65 159-72 238-21 95 61 202 65 325 7 23 34-11 66-98 80H78c-45-8-52-30-20-66z" />
              <path class="bird" d="M418 64c8-7 17-7 25 0M454 86c8-7 17-7 25 0M504 73c6-5 13-5 19 0" />
              <path class="tower" d="M462 298 523 48l61 250" />
              <path class="tower" d="M493 148h60M480 196h86M468 246h112M523 48V27M512 70h22M506 96h34" />
              <path class="tower" d="M495 298c16-48 35-72 58-72s42 24 58 72" />
              <path class="city" d="M72 298v-95h78v95M92 239h18M120 239h18M177 298v-126h105v126M196 213h20M234 213h20M196 250h20M234 250h20M610 298v-116h70v116M627 220h17M656 220h17M627 254h17M656 254h17" />
              <path class="bridge" d="M22 297c80-48 154-54 224-18 65-34 131-34 198 0 77-42 154-37 232 16" />
              <path class="bridge" d="M88 284h505M130 284c34-44 75-44 124 0M290 284c38-46 82-46 134 0M463 284c35-40 72-40 111 0" />
            </svg>
          </figure>
        </section>

        <section class="stats-section" aria-label="Resumen rápido">
          <ul class="stats-grid">
            {guide.stats.map((item) => (
              <li class={`tone-${item.tone}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[item.icon]} />
                <strong>{item.value}</strong>
                <span>{item.label}</span>
              </li>
            ))}
          </ul>
        </section>

        {isWriting ? (
          <>
            <div class="writing-hero-grid">
              <section id="tareas-produccion-escrita" class="panel tasks-panel" aria-labelledby="tasks-title">
                <header class="section-title">
                  <span>1</span>
                  <h2 id="tasks-title">Las 2 tareas de la Producción escrita</h2>
                </header>
                <ul class="task-grid">
                  {writingTasks.map((task) => (
                    <li>
                      <article class={`task-card tone-${task.tone}`}>
                        <div class="task-head">
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[task.icon]} />
                          <h3>{task.number}: {task.title}</h3>
                        </div>
                        <dl>
                          <div><dt>Objetivo</dt><dd>{task.objective}</dd></div>
                          <div><dt>Extensión aprox.</dt><dd>{task.length}</dd></div>
                          <div><dt>Duración</dt><dd>{task.duration}</dd></div>
                          <div><dt>Habilidades clave</dt><dd>{task.skills}</dd></div>
                        </dl>
                      </article>
                    </li>
                  ))}
                </ul>
                <p class="time-note">
                  La gestión del tiempo es clave: te recomendamos dedicar unos 40 min a la Tarea 1 y 20 min a la Tarea 2.
                </p>
              </section>

              <section id="que-se-evalua" class="panel evaluate-card" aria-labelledby="writing-eval-title">
                <h2 id="writing-eval-title">¿Qué se evalúa?</h2>
                <ul class="rich-list">
                  {writingEvaluation.map((item) => (
                    <li>
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.check} />
                      <span><strong>{item.title}</strong><small>{item.text}</small></span>
                    </li>
                  ))}
                </ul>
                <a class="rail-action" href={structureHref}>Ver criterios completos <span aria-hidden="true">→</span></a>
              </section>
            </div>

            <div class="split-grid">
              <section id="construir-respuesta" class="panel prep-panel" aria-labelledby="build-title">
                <header class="section-title">
                  <span>2</span>
                  <h2 id="build-title">Cómo construir una buena respuesta</h2>
                </header>
                <ol class="prep-steps">
                  {writingBuildSteps.map((step, index) => (
                    <li>
                      <span class="round-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false" set:html={icons[step.icon as WrittenIcon]} />
                      </span>
                      <strong>{index + 1}. {step.title}</strong>
                      <p>{step.text}</p>
                    </li>
                  ))}
                </ol>
              </section>

              <section id="estrategias-clave" class="panel strategy-card" aria-labelledby="writing-strategy-title">
                <header class="section-title">
                  <span>3</span>
                  <h2 id="writing-strategy-title">Estrategias clave para escribir mejor</h2>
                </header>
                <ul class="strategy-list">
                  {writingStrategies.map((item) => <li><strong>{item.title}</strong><span>{item.text}</span></li>)}
                </ul>
              </section>
            </div>

            <div class="split-grid resources-split">
              <section id="practica-recursos" class="panel resources-panel" aria-labelledby="writing-resources-title">
                <header class="section-title">
                  <span>4</span>
                  <h2 id="writing-resources-title">Práctica y recursos</h2>
                </header>
                <ul class="resource-grid writing-resources">
                  {writingResources.map((item) => (
                    <li>
                      <article>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[item.icon]} />
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        <a href={item.href}>{item.action} <span aria-hidden="true">→</span></a>
                      </article>
                    </li>
                  ))}
                </ul>
              </section>

              <section id="errores-frecuentes" class="panel errors-panel" aria-labelledby="writing-errors-title">
                <h2 id="writing-errors-title">Errores frecuentes</h2>
                <ul class="error-list">{writingErrors.map((item) => <li><span aria-hidden="true">×</span>{item}</li>)}</ul>
              </section>
            </div>

            <div class="bottom-grid">
              <section id="ruta-preparacion" class="panel route-panel" aria-labelledby="writing-route-title">
                <header class="section-title">
                  <span>5</span>
                  <h2 id="writing-route-title">Tu ruta de preparación DELF B2</h2>
                </header>
                <ol class="route-track writing-route">
                  {writingRoute.map((item) => (
                    <li class:list={[{ done: "done" in item && item.done, active: "active" in item && item.active }]}>
                      <a href={withBase(item.href)}>
                        <span class="round-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" focusable="false" set:html={icons[item.icon as WrittenIcon]} />
                        </span>
                        <strong>{item.title}</strong>
                        <small>{item.status}</small>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>

              <section id="siguiente-paso" class="next-card" aria-labelledby="writing-next-title">
                <div>
                  <h2 id="writing-next-title">Tu siguiente paso</h2>
                  <p>Sigue avanzando para completar las 4 competencias y llegar preparado al examen.</p>
                  <a class="next-link primary" href={speakingHref}>Practicar Producción oral <span aria-hidden="true">→</span></a>
                  <a class="next-link" href={structureHref}>Revisar criterios de evaluación <span aria-hidden="true">→</span></a>
                </div>
                <svg class="compass-art" viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.compass} />
              </section>
            </div>

            <p class="source-note">
              Consejo: escribe regularmente y pide retroalimentación. La práctica constante es la clave para alcanzar el nivel B2.
            </p>
          </>
        ) : (
          <>
            <div class="reading-layout">
              <section id="partes-comprension-escrita" class="panel documents-panel" aria-labelledby="reading-structure-title">
                <h2 id="reading-structure-title">Las partes de la Comprensión escrita</h2>
                <p>La prueba se divide en 4 partes con textos de diferente longitud y propósito.</p>
                <ul class="document-grid reading-parts">
                  {readingParts.map((part) => (
                    <li>
                      <article class={`document-card tone-${part.tone}`}>
                        <div class="doc-head">
                          <span>{part.number}</span>
                          <h3>{part.title}</h3>
                        </div>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[part.icon]} />
                        <dl>
                          <div><dt>Objetivo</dt><dd>{part.objective}</dd></div>
                        </dl>
                        <ul>{part.facts.map((fact) => <li>{fact}</li>)}</ul>
                        <p>{part.duration}</p>
                      </article>
                    </li>
                  ))}
                </ul>
              </section>

              <aside class="info-rail" aria-label="Información de la comprensión escrita">
                <section id="que-se-evalua" class="panel rail-panel">
                  <h2>¿Qué se evalúa?</h2>
                  <ul class="check-list">{readingEvaluation.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
                </section>
                <section class="panel rail-panel">
                  <h2>Tipos de textos</h2>
                  <ul class="icon-list">{readingTextTypes.map((item) => <li><span aria-hidden="true">▣</span>{item}</li>)}</ul>
                </section>
                <section id="errores-frecuentes" class="panel rail-panel">
                  <h2>Errores frecuentes</h2>
                  <ul class="error-list">{readingErrors.map((item) => <li><span aria-hidden="true">×</span>{item}</li>)}</ul>
                </section>
              </aside>
            </div>

            <section id="abordar-un-texto" class="panel reading-strategy" aria-labelledby="reading-success-title">
              <h2 id="reading-success-title">Cómo abordar un texto</h2>
              <ol>
                {readingStrategies.map((item) => (
                  <li>
                    <span class="round-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false" set:html={icons[item.icon as WrittenIcon]} />
                    </span>
                    <strong>{item.title}</strong>
                    <p>{item.text}</p>
                  </li>
                ))}
              </ol>
              <svg class="dome-art" viewBox="0 0 170 120" aria-hidden="true" focusable="false">
                <path d="M22 104h126M38 104V58h96v46M54 104V79h18v25M98 104V79h18v25" />
                <path d="M48 58c8-27 20-41 37-41s29 14 37 41M58 58h54M85 17V4M78 9h14" />
              </svg>
            </section>

            <div class="practice-grid">
              <section id="practica-recursos" class="panel practice-list" aria-labelledby="reading-practice-title">
                <h2 id="reading-practice-title">Práctica y recursos</h2>
                <p>Mejora tu velocidad y precisión con actividades guiadas.</p>
                <ul>
                  {readingPracticeLinks.map((item) => (
                    <li>
                      <a href={item.href}>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons[item.icon as WrittenIcon]} />
                        <span><strong>{item.title}</strong><small>{item.text}</small></span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>

              <section id="estrategias-clave" class="panel tips-panel" aria-labelledby="reading-tips-title">
                <h2 id="reading-tips-title">Estrategias clave</h2>
                <ul class="check-list">{readingTips.map((item) => <li><span aria-hidden="true">✓</span>{item}</li>)}</ul>
              </section>

              <section class="quote-card" aria-labelledby="quote-title">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.quote} />
                <h2 id="quote-title">Ejemplo de texto</h2>
                <blockquote>
                  <p>"La lecture, c'est voyager sans bouger. Elle ouvre l'esprit, enrichit le vocabulaire et permet de mieux comprendre le monde. Lire régulièrement, c'est se donner des clés pour réussir."</p>
                  <footer>Texto ficticio de ejemplo</footer>
                </blockquote>
              </section>
            </div>

            <section id="ruta-preparacion" class="panel reading-route-panel" aria-labelledby="reading-route-title">
              <div class="route-copy">
                <h2 id="reading-route-title">Tu ruta de preparación DELF B2</h2>
                <p>Sigue este orden recomendado para dominar cada competencia.</p>
                <ol class="route-track reading-route">
                  {readingRoute.map((item, index) => (
                    <li class:list={[{ active: "active" in item && item.active }]}>
                      <a href={withBase(item.href)}>
                        <span class="round-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" focusable="false" set:html={icons[item.icon as WrittenIcon]} />
                        </span>
                        <strong>{index + 1}. {item.title}</strong>
                        <small>{item.text}</small>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
              <article class="goal-card">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" set:html={icons.award} />
                <h3>Tu meta: DELF B2</h3>
                <p>Demuestra tu dominio del francés y obtén tu diploma oficial.</p>
                <a href={structureHref}>Ver cómo se obtiene el diploma <span aria-hidden="true">→</span></a>
              </article>
            </section>

            <section id="siguiente-paso" class="final-band" aria-labelledby="final-title">
              <svg viewBox="0 0 120 72" aria-hidden="true" focusable="false">
                <path d="M8 44 72 12l-18 48-12-20-20 8z" />
              </svg>
              <div>
                <h2 id="final-title">Cada texto que comprendes te acerca más a tu diploma. ¡Sigue practicando y creyendo en ti!</h2>
              </div>
              <a href={levelHref}>Ir al plan de estudio completo <span aria-hidden="true">→</span></a>
            </section>
          </>
        )}
      </div>
    </div>
  </div>
</main>

<style>
  .b2-written-page {
    background:
      radial-gradient(circle at 92% 14%, rgba(91, 54, 214, 0.07), transparent 22rem),
      radial-gradient(circle at 10% 44%, rgba(240, 118, 0, 0.07), transparent 22rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.97), rgba(250, 248, 244, 0.86)),
      var(--color-bg);
  }

  .page-wrap {
    padding-block: 1rem 2rem;
  }

  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    color: #1d2672;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .breadcrumb a {
    color: #071a68;
  }

  .guide-layout {
    display: grid;
    grid-template-columns: minmax(13rem, 0.23fr) minmax(0, 1fr);
    gap: 1.2rem;
    align-items: start;
    margin-top: 1.2rem;
  }

  .page-index,
  .panel,
  .stats-grid li,
  .next-card,
  .goal-card,
  .quote-card,
  .final-band,
  .source-note {
    border: 1px solid rgba(34, 23, 160, 0.13);
    border-radius: 0.62rem;
    background: rgba(255, 255, 255, 0.9);
    box-shadow: var(--shadow-sm);
  }

  .page-index {
    position: sticky;
    top: 6rem;
    overflow: hidden;
  }

  .index-head {
    display: grid;
    grid-template-columns: 2.45rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    padding: 1rem;
    background: linear-gradient(135deg, #f5f0ff, #ffffff);
  }

  .index-head span,
  .section-title > span {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.55rem;
    background: linear-gradient(135deg, #5b28cd, #2d0b8a);
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 900;
  }

  .index-head h2 {
    font-size: 1.25rem;
  }

  .page-index nav {
    padding: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .page-index p {
    margin: 0 0 0.7rem;
    color: #071a68;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
  }

  .page-index ol,
  .mobile-index ol,
  .stats-grid,
  .task-grid,
  .document-grid,
  .check-list,
  .icon-list,
  .error-list,
  .rich-list,
  .strategy-list,
  .resource-grid,
  .route-track,
  .reading-strategy ol,
  .practice-list ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .page-index ol {
    display: grid;
    gap: 0.18rem;
  }

  .page-index a {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.55rem;
    min-height: 2.15rem;
    align-items: center;
    padding: 0.42rem 0.5rem;
    border-radius: 0.44rem;
    color: #101760;
    font-size: 0.74rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .page-index nav a:hover,
  .page-index nav a:focus-visible {
    background: #efe9ff;
    color: #3515a4;
  }

  svg {
    overflow: visible;
  }

  .page-index svg,
  .stats-grid svg,
  .round-icon svg,
  .document-card svg,
  .task-head svg,
  .resource-grid svg,
  .practice-list svg,
  .quote-card > svg,
  .goal-card > svg,
  .compass-art {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .page-index .download-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.35rem;
    margin: 0 1rem 1rem;
    padding: 0.85rem;
    background: #f4f0ff;
  }

  .download-card svg {
    width: 1.65rem;
    height: 1.65rem;
    color: #4420bb;
  }

  .download-card strong,
  .download-card small,
  .download-card span {
    display: block;
  }

  .download-card strong {
    color: #071a68;
    font-size: 0.82rem;
  }

  .download-card small,
  .download-card span {
    color: #1d2672;
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .guide-main {
    display: grid;
    gap: 1rem;
  }

  .mobile-index {
    display: none;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(34, 23, 160, 0.13);
    border-radius: 0.62rem;
    background: #ffffff;
  }

  .mobile-index summary {
    cursor: pointer;
    color: #071a68;
    font-weight: 900;
  }

  .mobile-index ol {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.8rem;
  }

  .hero-section {
    display: grid;
    grid-template-columns: minmax(0, 0.48fr) minmax(19rem, 0.52fr);
    gap: clamp(1rem, 2.8vw, 2.2rem);
    align-items: center;
    min-height: 18.5rem;
  }

  .hero-copy {
    padding-block: 0.7rem;
  }

  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.2rem;
  }

  .badge {
    display: inline-flex;
    min-height: 1.9rem;
    align-items: center;
    padding: 0.25rem 0.78rem;
    border-radius: 999px;
    background: #f0ebff;
    color: #3715a4;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .badge-level {
    background: linear-gradient(135deg, #5b28cd, #2d0b8a);
    color: #ffffff;
  }

  .badge-time {
    background: #fff0dc;
    color: #a44900;
  }

  .badge-ready {
    background: #e4f5e9;
    color: #13713b;
  }

  .hero-copy h1 {
    max-width: 17ch;
    color: #071a68;
    font-size: clamp(2.35rem, 4.3vw, 3.45rem);
    line-height: 1.04;
  }

  .hero-copy p {
    max-width: 41rem;
    margin: 0.85rem 0 0;
    color: #101760;
    font-size: 0.98rem;
    font-weight: 500;
  }

  .hero-subtitle {
    color: #071a68;
    font-size: 1.12rem;
    font-weight: 800;
  }

  .hero-action {
    gap: 0.6rem;
    margin-top: 1.2rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #5b28cd, #2d0b8a);
    color: #ffffff;
  }

  .paris-visual {
    margin: 0;
    color: #071a68;
  }

  .paris-visual svg {
    width: 100%;
    min-height: 18rem;
  }

  .wash {
    stroke: none;
    opacity: 0.36;
  }

  .wash-blue {
    fill: #bfe4ff;
  }

  .wash-gold {
    fill: #f5c272;
  }

  .bird,
  .tower,
  .city,
  .bridge,
  .dome-art path,
  .final-band path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tower {
    stroke-width: 3;
  }

  .city,
  .bridge {
    stroke-width: 2.1;
    opacity: 0.72;
  }

  .bird {
    stroke-width: 2;
    color: #19399f;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .stats-grid li {
    display: grid;
    min-height: 8.7rem;
    justify-items: center;
    align-content: center;
    gap: 0.45rem;
    padding: 1rem;
    text-align: center;
  }

  .stats-grid svg {
    width: 2.35rem;
    height: 2.35rem;
  }

  .stats-grid strong {
    color: #071a68;
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .stats-grid span {
    color: #1d2672;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tone-violet { color: #5124ca; }
  .tone-blue { color: #1343b5; }
  .tone-green { color: #168447; }
  .tone-orange { color: #f07600; }
  .tone-red { color: #d22e2e; }

  .panel {
    padding: 1rem;
    scroll-margin-top: 6.5rem;
  }

  .section-title {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 0.9rem;
  }

  .section-title > span {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
  }

  .section-title h2,
  .panel h2,
  .next-card h2,
  .quote-card h2,
  .goal-card h3,
  .final-band h2 {
    color: #071a68;
    font-size: clamp(1.2rem, 2vw, 1.55rem);
  }

  .reading-layout,
  .writing-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.74fr) minmax(14rem, 0.26fr);
    gap: 1rem;
    align-items: start;
  }

  .documents-panel > p,
  .practice-list > p,
  .reading-route-panel p,
  .quote-card p,
  .goal-card p,
  .final-band p {
    margin: 0.35rem 0 0;
    color: #101760;
    font-size: 0.78rem;
    font-weight: 700;
  }

  .document-grid,
  .task-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  .reading-parts {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .task-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .document-card,
  .task-card {
    overflow: hidden;
    min-height: 100%;
    border: 1px solid rgba(34, 23, 160, 0.13);
    border-radius: 0.56rem;
    background: #ffffff;
  }

  .doc-head,
  .task-head {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    min-height: 3.8rem;
    padding: 0.85rem;
    background: color-mix(in srgb, currentColor 12%, #ffffff);
  }

  .doc-head > span {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: currentColor;
    color: #ffffff;
    font-weight: 900;
  }

  .task-head svg {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
  }

  .doc-head h3,
  .task-head h3,
  .resource-grid h3 {
    font-family: var(--font-body);
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1.22;
  }

  .document-card > svg {
    width: 3rem;
    height: 3rem;
    margin: 0.9rem auto 0;
  }

  .document-card dl,
  .task-card dl {
    display: grid;
    gap: 0.55rem;
    padding: 0.8rem 1rem 1rem;
    margin: 0;
  }

  .document-card dt,
  .task-card dt {
    color: #071a68;
    font-size: 0.68rem;
    font-weight: 900;
  }

  .document-card dd,
  .task-card dd {
    margin: 0.1rem 0 0;
    color: #101760;
    font-size: 0.7rem;
    line-height: 1.35;
  }

  .document-card ul {
    display: grid;
    gap: 0.42rem;
    padding: 0 1rem;
    margin: 0;
    list-style: none;
  }

  .document-card li {
    color: #101760;
    font-size: 0.72rem;
    font-weight: 700;
  }

  .document-card li::before {
    margin-right: 0.45rem;
    color: currentColor;
    content: "▧";
  }

  .document-card > p,
  .time-note {
    margin: 0.85rem 1rem 1rem;
    padding: 0.65rem;
    border-radius: 0.45rem;
    background: color-mix(in srgb, currentColor 10%, #ffffff);
    color: #101760;
    font-size: 0.7rem;
    font-weight: 800;
    text-align: center;
  }

  .time-note {
    margin: 0.85rem 0 0;
    color: #1d2672;
  }

  .info-rail {
    display: grid;
    gap: 0.7rem;
  }

  .rail-panel {
    padding: 0.85rem;
  }

  .rail-panel h2,
  .evaluate-card h2,
  .errors-panel h2 {
    margin-bottom: 0.7rem;
    font-family: var(--font-body);
    font-size: 0.92rem;
    font-weight: 900;
  }

  .check-list,
  .icon-list,
  .error-list,
  .rich-list {
    display: grid;
    gap: 0.62rem;
  }

  .check-list li,
  .icon-list li,
  .error-list li {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
    color: #101760;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .check-list span {
    color: #168447;
  }

  .icon-list span {
    color: #5124ca;
  }

  .error-list span {
    color: #d22e2e;
  }

  .rich-list li {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.55rem;
    align-items: start;
  }

  .rich-list svg {
    width: 1.15rem;
    height: 1.15rem;
    color: #5124ca;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
  }

  .rich-list strong,
  .rich-list small {
    display: block;
  }

  .rich-list strong {
    color: #071a68;
    font-size: 0.76rem;
  }

  .rich-list small {
    color: #101760;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .rail-action {
    display: flex;
    min-height: 2.35rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.8rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid rgba(81, 36, 202, 0.28);
    border-radius: 0.48rem;
    color: #5124ca;
    font-size: 0.72rem;
    font-weight: 900;
  }

  .reading-strategy {
    position: relative;
    overflow: hidden;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.94), rgba(243, 239, 255, 0.86));
  }

  .reading-strategy ol,
  .prep-steps,
  .route-track {
    position: relative;
    display: grid;
  }

  .reading-strategy ol,
  .prep-steps {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .reading-strategy ol {
    padding-right: 12rem;
  }

  .prep-steps::before,
  .route-track::before {
    position: absolute;
    right: 8%;
    left: 8%;
    top: 2rem;
    border-top: 2px dashed rgba(81, 36, 202, 0.34);
    content: "";
  }

  .reading-strategy li,
  .prep-steps li,
  .route-track li {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.42rem;
    text-align: center;
  }

  .route-track a {
    display: contents;
  }

  .round-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    padding: 1rem;
    border: 1px solid rgba(81, 36, 202, 0.23);
    border-radius: 50%;
    background: #ffffff;
    color: #5124ca;
  }

  .reading-strategy strong,
  .prep-steps strong,
  .route-track strong {
    color: #071a68;
    font-size: 0.72rem;
    font-weight: 900;
    line-height: 1.25;
  }

  .reading-strategy p,
  .prep-steps p,
  .route-track small {
    margin: 0;
    color: #1d2672;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .dome-art {
    position: absolute;
    right: 1rem;
    bottom: 0.7rem;
    width: 11rem;
    color: rgba(81, 36, 202, 0.26);
  }

  .practice-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 0.28fr) minmax(0, 0.38fr);
    gap: 1rem;
  }

  .practice-list ul {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.8rem;
  }

  .practice-list a {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) auto;
    gap: 0.6rem;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.55rem 0.7rem;
    border: 1px solid rgba(34, 23, 160, 0.12);
    border-radius: 0.52rem;
  }

  .practice-list svg {
    width: 1.65rem;
    height: 1.65rem;
    color: #5124ca;
  }

  .practice-list strong,
  .practice-list small {
    display: block;
  }

  .practice-list strong {
    color: #071a68;
    font-size: 0.74rem;
  }

  .practice-list small {
    color: #1d2672;
    font-size: 0.68rem;
    font-weight: 700;
  }

  .quote-card {
    position: relative;
    padding: 1rem;
    background: linear-gradient(135deg, #fff8ec, #fff0d7);
  }

  .quote-card > svg {
    position: absolute;
    right: 1rem;
    top: 1rem;
    width: 2.8rem;
    height: 2.8rem;
    padding: 0.6rem;
    border-radius: 50%;
    background: #ffe1a8;
    color: #f07600;
  }

  .quote-card blockquote {
    margin: 0.8rem 0 0;
  }

  .quote-card footer {
    margin-top: 0.7rem;
    color: #1d2672;
    font-size: 0.72rem;
    font-weight: 800;
  }

  .reading-route-panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.32fr);
    gap: 1rem;
    align-items: center;
  }

  .reading-route,
  .writing-route {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .route-track .done .round-icon {
    border-color: rgba(22, 132, 71, 0.28);
    background: #eaf8ef;
    color: #168447;
  }

  .route-track .active .round-icon {
    border-color: rgba(240, 118, 0, 0.5);
    box-shadow: 0 0 0 5px rgba(240, 118, 0, 0.1);
    color: #f07600;
  }

  .goal-card {
    padding: 1rem;
    background: linear-gradient(135deg, #f3eeff, #ffffff);
  }

  .goal-card > svg {
    width: 3.2rem;
    height: 3.2rem;
    margin-left: auto;
    color: #f07600;
  }

  .goal-card h3 {
    margin-top: -1.8rem;
  }

  .goal-card a,
  .final-band a,
  .next-link {
    display: flex;
    min-height: 2.45rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(81, 36, 202, 0.28);
    border-radius: 0.55rem;
    color: #5124ca;
    font-size: 0.75rem;
    font-weight: 900;
  }

  .goal-card a,
  .final-band a,
  .next-link.primary {
    border-color: transparent;
    background: linear-gradient(135deg, #5b28cd, #2d0b8a);
    color: #ffffff;
  }

  .goal-card a {
    margin-top: 0.85rem;
  }

  .final-band {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 1rem 1.3rem;
    overflow: hidden;
    background: linear-gradient(135deg, #f2edff, #ffffff);
  }

  .final-band > svg {
    width: 5.5rem;
    color: #5124ca;
  }

  .final-band h2 {
    font-size: 1.18rem;
  }

  .split-grid,
  .resources-split,
  .bottom-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(18rem, 0.38fr);
    gap: 1rem;
    align-items: stretch;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .resource-grid article {
    display: grid;
    min-height: 100%;
    justify-items: center;
    gap: 0.45rem;
    padding: 0.85rem 0.65rem;
    border: 1px solid rgba(34, 23, 160, 0.13);
    border-radius: 0.56rem;
    background: #ffffff;
    text-align: center;
  }

  .resource-grid svg {
    width: 2.25rem;
    height: 2.25rem;
    color: #5124ca;
  }

  .writing-resources li:nth-child(2) svg,
  .b2-written-writing .hero-subtitle,
  .b2-written-writing .task-card.tone-orange {
    color: #f07600;
  }

  .resource-grid p {
    margin: 0;
    color: #1d2672;
    font-size: 0.66rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .resource-grid a {
    align-self: end;
    min-height: 1.9rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid rgba(81, 36, 202, 0.24);
    border-radius: 0.42rem;
    color: #5124ca;
    font-size: 0.68rem;
    font-weight: 900;
  }

  .strategy-list {
    display: grid;
    gap: 0.58rem;
  }

  .strategy-list li {
    color: #101760;
    font-size: 0.78rem;
    line-height: 1.35;
  }

  .strategy-list li::before {
    margin-right: 0.5rem;
    color: #5124ca;
    content: "✦";
  }

  .strategy-list strong,
  .strategy-list span {
    display: block;
  }

  .next-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    gap: 1rem;
    align-items: center;
    overflow: hidden;
    padding: 1rem;
    background: linear-gradient(135deg, #f5f1ff, #ffffff);
  }

  .next-card p {
    margin: 0.45rem 0 0.85rem;
    color: #101760;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .next-link + .next-link {
    margin-top: 0.55rem;
  }

  .compass-art {
    width: 8rem;
    height: 8rem;
    padding: 1.5rem;
    border-radius: 50%;
    background: #fff7e8;
    color: #5124ca;
  }

  .source-note {
    margin: 0;
    padding: 0.85rem 1rem;
    background: #f1edff;
    color: #101760;
    font-size: 0.75rem;
    font-weight: 700;
  }

  @media (max-width: 1120px) {
    .guide-layout {
      grid-template-columns: 1fr;
    }

    .page-index {
      display: none;
    }

    .mobile-index {
      display: block;
    }
  }

  @media (max-width: 980px) {
    .hero-section,
    .reading-layout,
    .writing-hero-grid,
    .practice-grid,
    .reading-route-panel,
    .split-grid,
    .resources-split,
    .bottom-grid {
      grid-template-columns: 1fr;
    }

    .stats-grid,
    .reading-parts,
    .resource-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .reading-strategy ol {
      padding-right: 0;
    }

    .dome-art {
      display: none;
    }

    .final-band {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .final-band a {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 760px) {
    .hero-section {
      min-height: 0;
    }

    .hero-copy h1 {
      max-width: 100%;
      font-size: clamp(2rem, 11vw, 2.75rem);
    }

    .paris-visual svg {
      min-height: 12rem;
    }

    .reading-strategy ol,
    .prep-steps,
    .route-track {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }

    .prep-steps::before,
    .route-track::before {
      top: 0;
      bottom: 0;
      left: 2rem;
      right: auto;
      border-top: 0;
      border-left: 2px dashed rgba(81, 36, 202, 0.34);
    }

    .reading-strategy li,
    .prep-steps li,
    .route-track li {
      grid-template-columns: 4rem minmax(0, 1fr);
      justify-items: start;
      column-gap: 0.8rem;
      text-align: left;
    }

    .reading-strategy strong,
    .reading-strategy p,
    .prep-steps strong,
    .prep-steps p,
    .route-track strong,
