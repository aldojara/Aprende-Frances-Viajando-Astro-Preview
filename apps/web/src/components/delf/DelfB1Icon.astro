---
import type { DelfB1Icon } from "../../data/delfB1Landing";

interface Props {
  name: DelfB1Icon;
}

const { name } = Astro.props;
---

<svg
  class="b1-icon"
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-linecap="round"
  stroke-linejoin="round"
  stroke-width="1.65"
>
  {
    name === "book" && (
      <>
        <path d="M4 5.5c2.8-.9 5-.45 7 1.35v11.1c-2-1.8-4.2-2.25-7-1.35z" />
        <path d="M20 5.5c-2.8-.9-5-.45-7 1.35v11.1c2-1.8 4.2-2.25 7-1.35z" />
        <path d="M12 6.85v11.1" />
      </>
    )
  }
  {
    name === "chart" && (
      <>
        <path d="M4 19h16" />
        <path d="M7 16v-4" />
        <path d="M12 16V8" />
        <path d="M17 16v-7" />
        <path d="m17 5 2 2-2 2" />
      </>
    )
  }
  {
    name === "check" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <path d="m8.5 12.2 2.4 2.4 4.9-5.2" />
      </>
    )
  }
  {
    name === "clipboard" && (
      <>
        <path d="M8 4h8l1 2h2v14H5V6h2z" />
        <path d="M9 4v3h6V4" />
        <path d="M8.5 11h7" />
        <path d="M8.5 15h4.5" />
      </>
    )
  }
  {
    name === "download" && (
      <>
        <path d="M12 4v10" />
        <path d="m8 10 4 4 4-4" />
        <path d="M5 19h14" />
      </>
    )
  }
  {
    name === "file" && (
      <>
        <path d="M6 3h9l3 3v15H6z" />
        <path d="M14 3v4h4" />
        <path d="M9 12h6" />
        <path d="M9 16h5" />
      </>
    )
  }
  {
    name === "headphones" && (
      <>
        <path d="M4 13a8 8 0 0 1 16 0" />
        <path d="M6 13v5a2 2 0 0 0 2 2h1v-7z" />
        <path d="M18 13v5a2 2 0 0 1-2 2h-1v-7z" />
      </>
    )
  }
  {
    name === "medal" && (
      <>
        <path d="m8 3 4 5 4-5" />
        <circle cx="12" cy="14" r="5" />
        <path d="m10.5 14 1 1 2-2" />
      </>
    )
  }
  {
    name === "message" && (
      <>
        <path d="M5 6h14v9H9l-4 4z" />
        <path d="M9 10h6" />
      </>
    )
  }
  {
    name === "microphone" && (
      <>
        <rect x="9" y="3" width="6" height="11" rx="3" />
        <path d="M5 11a7 7 0 0 0 14 0" />
        <path d="M12 18v3" />
        <path d="M9 21h6" />
      </>
    )
  }
  {
    name === "pencil" && (
      <>
        <path d="m4 17-.5 3.5L7 20l10.6-10.6-3-3z" />
        <path d="m13.4 7.6 3 3" />
        <path d="M15 6 17 4l3 3-2 2" />
      </>
    )
  }
  {
    name === "route" && (
      <>
        <path d="M4 6h6v5H4z" />
        <path d="M14 13h6v5h-6z" />
        <path d="M10 8.5h2.5a3.5 3.5 0 0 1 0 7H14" />
      </>
    )
  }
  {
    name === "star" && (
      <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2L12 17.2 6.4 20.2 7.5 14 3 9.6l6.2-.9z" />
    )
  }
  {
    name === "target" && (
      <>
        <circle cx="12" cy="12" r="8.5" />
        <circle cx="12" cy="12" r="4.5" />
        <path d="M12 12 19 5" />
        <path d="M17 5h2v2" />
      </>
    )
  }
  {
    name === "users" && (
      <>
        <circle cx="9" cy="8" r="3" />
        <circle cx="16" cy="9" r="2.5" />
        <path d="M3.5 19a5.5 5.5 0 0 1 11 0" />
        <path d="M14.5 14.5A4.5 4.5 0 0 1 21 19" />
      </>
    )
  }
  {
    name === "volume" && (
      <>
        <path d="M4 10v4h3l5 4V6l-5 4z" />
        <path d="M16 9.5a4 4 0 0 1 0 5" />
        <path d="M18.5 7a7.5 7.5 0 0 1 0 10" />
      </>
    )
  }
</svg>

<style>
  .b1-icon {
    display: block;
    width: var(--b1-icon-size, 1.25rem);
    height: var(--b1-icon-size, 1.25rem);
  }
</style>
