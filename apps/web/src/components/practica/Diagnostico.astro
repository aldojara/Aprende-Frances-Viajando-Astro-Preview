---
import { diagnostico } from "../../data/practicaAvoirEtre";
import PreguntaOpciones from "./PreguntaOpciones.astro";
---

<form class="diagnostico" data-diagnostico novalidate>
  <ol class="diagnostico-lista">
    {
      diagnostico.map((pregunta, indice) => (
        <PreguntaOpciones
          pregunta={pregunta}
          numero={indice + 1}
          grupo="diagnostico"
          conExplicacion={false}
        />
      ))
    }
  </ol>

  <div class="diagnostico-acciones">
    <button class="button button-primary" type="submit">Ver mi orientación</button>
    <p class="diagnostico-nota">Puedes dejar preguntas sin responder si no estás seguro.</p>
  </div>

  <div class="diagnostico-resultado card" data-resultado hidden tabindex="-1" aria-live="polite"></div>
</form>

<style>
  .diagnostico-resultado[hidden] {
    display: none;
  }

  .diagnostico-lista {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .diagnostico-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    align-items: center;
    margin-top: 1.25rem;
  }

  .diagnostico-nota {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .diagnostico-resultado {
    margin-top: 1.25rem;
    padding: 1.25rem;
    border-left: 4px solid var(--color-gold);
  }

  .diagnostico-resultado :global(h3) {
    margin-bottom: 0.5rem;
    font-size: 1.4rem;
  }

  .diagnostico-resultado :global(ul) {
    margin: 0.5rem 0 1rem;
    padding-left: 1.2rem;
  }

  .diagnostico-resultado :global(.diagnostico-aviso) {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>

<script>
  import { diagnostico, ordenEstandar, tipos } from "../../data/practicaAvoirEtre";
  import { evaluarDiagnostico, MINIMO_RESPONDIDAS } from "../../utils/diagnostico";
  import { guardarProgreso, leerProgreso, track } from "../../utils/track";

  const form = document.querySelector<HTMLFormElement>("[data-diagnostico]");
  const salida = form?.querySelector<HTMLElement>("[data-resultado]");
  const nombre = (id: string) => tipos.find((tipo) => tipo.id === id)?.nombre ?? id;

  const crear = (etiqueta: string, texto: string, clase?: string) => {
    const elemento = document.createElement(etiqueta);
    elemento.textContent = texto;
    if (clase) elemento.className = clase;
    return elemento;
  };

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!salida) return;

    const respuestas: Record<string, number | undefined> = {};
    diagnostico.forEach((pregunta) => {
      const elegida = form.querySelector<HTMLInputElement>(
        `input[name="diagnostico-${pregunta.id}"]:checked`,
      );
      respuestas[pregunta.id] = elegida ? Number(elegida.value) : undefined;
    });

    const resultado = evaluarDiagnostico(diagnostico, respuestas, ordenEstandar);
    salida.replaceChildren();

    if (!resultado.suficiente) {
      salida.append(
        crear("h3", "Faltan respuestas"),
        crear(
          "p",
          `Respondiste ${resultado.respondidas} de ${resultado.total}. Responde al menos ${MINIMO_RESPONDIDAS} preguntas para ver una orientación.`,
        ),
      );
      salida.hidden = false;
      salida.focus();
      return;
    }

    const sinDatos = resultado.porTipo.filter((t) => t.estado === "sin-datos");
    const conFallos = resultado.recomendados.length > 0;

    if (conFallos) {
      salida.append(
        crear("h3", "Tu orientación"),
        crear(
          "p",
          `Respondiste ${resultado.respondidas} de ${resultado.total} y acertaste ${resultado.aciertos}. Te recomendamos empezar a practicar por:`,
        ),
      );
      const lista = document.createElement("ul");
      resultado.recomendados.forEach((id) => lista.append(crear("li", nombre(id))));
      salida.append(lista);
    } else if (resultado.respondidas === resultado.total) {
      salida.append(
        crear("h3", "Sin errores en las 15 preguntas"),
        crear("p", "Si quieres consolidar, puedes hacer el reto en el orden estándar."),
      );
    } else {
      salida.append(
        crear("h3", "Sin errores en las preguntas respondidas"),
        crear("p", `Respondiste ${resultado.respondidas} de ${resultado.total}.`),
      );
    }

    if (sinDatos.length) {
      salida.append(
        crear(
          "p",
          `En ${sinDatos.map((t) => nombre(t.tipo)).join(", ")} respondiste muy pocas preguntas: no sabemos si te cuesta.`,
        ),
      );
    }

    salida.append(
      crear(
        "p",
        "Es una orientación a partir de pocas preguntas, no una evaluación de tu nivel.",
        "diagnostico-aviso",
      ),
    );

    const orden = resultado.orden.join("-");
    const progreso = leerProgreso();
    guardarProgreso({ ...progreso, orden });
    document.dispatchEvent(new CustomEvent("afv:orden", { detail: { orden } }));

    const enlace = document.createElement("a");
    enlace.className = "button button-secondary";
    enlace.href = "#reto";
    enlace.textContent = "Practicarlo en el reto de 5 sesiones";
    salida.append(enlace);

    salida.hidden = false;
    salida.focus();
    track("diagnostico_fin", {
      respondidas: resultado.respondidas,
      recomendado: resultado.recomendados[0] ?? "ninguno",
    });
  });
</script>
