---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DownloadResourcesBanner from "../../components/resources/DownloadResourcesBanner.astro";
import ResourceFormatGrid from "../../components/resources/ResourceFormatGrid.astro";
import ResourceTopicGrid from "../../components/resources/ResourceTopicGrid.astro";
import ResourcesCatalog from "../../components/resources/ResourcesCatalog.astro";
import ResourcesHero from "../../components/resources/ResourcesHero.astro";
import {
  domainToTopic,
  formatLabels,
  normalizeText,
  resourceFormatCategoryIds,
  topicFilters,
  type ResourceCompetencyId,
  type ResourceFormatCategoryId,
  type ResourceItem,
  type ResourceTopicId,
} from "../../data/resourcesCatalog";
import {
  coverageStatuses,
  levels,
  type CoverageStatus,
  type FormatId,
} from "../../data/taxonomies";
import { getContentRoute, getFinalContentSlug } from "../../utils/contentRoutes";
import { withBase } from "../../utils/paths";
import { ordenLecciones } from "../../data/modulosGramatica";

type ContentEntry = CollectionEntry<"content">;
type ResourceEntry = CollectionEntry<"resources">;

const contentItems = await getCollection("content");
const resourceItems = await getCollection("resources");

const competencyMap: Record<string, ResourceCompetencyId> = {
  "comprension oral": "comprension-oral",
  "comprensión oral": "comprension-oral",
  listening: "comprension-oral",
  escucha: "comprension-oral",
  "comprension escrita": "comprension-escrita",
  "comprensión escrita": "comprension-escrita",
  lectura: "comprension-escrita",
  "produccion oral": "produccion-oral",
  "producción oral": "produccion-oral",
  "interaccion oral": "produccion-oral",
  "interacción oral": "produccion-oral",
  speaking: "produccion-oral",
  "produccion escrita": "produccion-escrita",
  "producción escrita": "produccion-escrita",
  writing: "produccion-escrita",
};

const examSkillCompetencies: Record<string, ResourceCompetencyId[]> = {
  listening: ["comprension-oral"],
  reading: ["comprension-escrita"],
  writing: ["produccion-escrita"],
  speaking: ["produccion-oral"],
  overview: ["comprension-escrita"],
};

const addIf = <T,>(set: Set<T>, condition: boolean, value: T) => {
  if (condition) set.add(value);
};

const getContentCompetencies = (item: ContentEntry): ResourceCompetencyId[] => {
  const result = new Set<ResourceCompetencyId>();
  const searchableCompetencies = item.data.competencies.map(normalizeText);

  searchableCompetencies.forEach((competency) => {
    const mapped = competencyMap[competency];
    if (mapped) result.add(mapped);
  });

  if (item.data.examSkill) {
    examSkillCompetencies[item.data.examSkill]?.forEach((competency) =>
      result.add(competency),
    );
  }

  addIf(result, item.data.domain === "listening" || item.data.format === "audio", "comprension-oral");
  addIf(result, item.data.format === "article" || item.data.contentKind === "lesson", "comprension-escrita");
  addIf(result, item.data.contentKind === "guide", "comprension-escrita");

  if (result.size === 0) result.add("comprension-escrita");
  return Array.from(result);
};

const getResourceCompetencies = (item: ResourceEntry): ResourceCompetencyId[] => {
  const result = new Set<ResourceCompetencyId>();
  const searchable = [
    item.data.title,
    item.data.description,
    ...item.data.tags,
    item.data.resourceType,
  ].map(normalizeText);

  searchable.forEach((value) => {
    Object.entries(competencyMap).forEach(([key, competency]) => {
      if (value.includes(key)) result.add(competency);
    });
  });

  result.add("comprension-escrita");
  return Array.from(result);
};

const getContentTopics = (item: ContentEntry): ResourceTopicId[] => {
  const result = new Set<ResourceTopicId>();
  const baseTopic = domainToTopic[item.data.domain];
  const searchText = normalizeText(
    [
      item.data.title,
      item.data.description,
      item.data.domain,
      item.data.moduleId ?? "",
      ...item.data.tags,
      ...item.data.objectives,
      ...item.data.grammarTopics,
      ...item.data.communicativeNeeds,
      ...item.data.competencies,
    ].join(" "),
  );

  if (baseTopic) result.add(baseTopic);
  addIf(result, searchText.includes("viaje") || searchText.includes("estacion"), "viajes-cultura");
  addIf(result, searchText.includes("vocab"), "vocabulario");
  addIf(result, searchText.includes("pronunci"), "pronunciacion");
  addIf(result, searchText.includes("conector") || searchText.includes("expresion"), "conectores-expresiones");
  addIf(result, item.data.domain === "grammar", "gramatica");
  addIf(result, item.data.domain === "delf", "delf");

  if (result.size === 0) result.add("vida-cotidiana");
  return Array.from(result);
};

const getResourceTopics = (item: ResourceEntry): ResourceTopicId[] => {
  const result = new Set<ResourceTopicId>();
  const searchText = normalizeText(
    [item.data.title, item.data.description, item.data.resourceType, ...item.data.tags].join(" "),
  );

  addIf(result, searchText.includes("viaje"), "viajes-cultura");
  addIf(result, searchText.includes("frase") || searchText.includes("vocab"), "vocabulario");
  addIf(result, item.data.resourceType === "map", "viajes-cultura");

  if (result.size === 0) result.add("vida-cotidiana");
  return Array.from(result);
};

const getContentFormatCategories = (item: ContentEntry): ResourceFormatCategoryId[] => {
  const result = new Set<ResourceFormatCategoryId>();

  addIf(result, item.data.format === "article", "articulos");
  addIf(result, item.data.format === "audio", "audios");
  addIf(result, item.data.format === "podcast", "podcasts");
  addIf(result, item.data.format === "video", "videos");
  addIf(result, item.data.format === "downloadable", "guias-pdf");
  addIf(result, item.data.contentKind === "guide", "guias-pdf");
  addIf(result, item.data.contentKind === "practice", "fichas-practica");
  addIf(result, item.data.examContentType === "evaluation", "rubricas-criterios");
  addIf(result, item.data.examContentType === "mock-exam", "simulacros");

  if (result.size === 0) result.add("articulos");
  return Array.from(result);
};

const getResourceFormatCategories = (item: ResourceEntry): ResourceFormatCategoryId[] => {
  const result = new Set<ResourceFormatCategoryId>();

  addIf(result, item.data.resourceType === "map", "mapas-visuales");
  addIf(result, item.data.resourceType === "worksheet", "fichas-practica");
  addIf(result, item.data.resourceType === "transcript", "transcripciones");
  addIf(result, item.data.resourceType === "audio-pack", "audios");
  addIf(result, item.data.resourceType === "guide" || item.data.format === "downloadable", "guias-pdf");

  if (result.size === 0) result.add("guias-pdf");
  return Array.from(result);
};

const getVisual = (
  formatCategories: ResourceFormatCategoryId[],
  format: FormatId,
  domain?: string,
): ResourceItem["visual"] => {
  if (format === "audio" || format === "podcast") return "audio";
  if (formatCategories.includes("fichas-practica")) return "worksheet";
  if (formatCategories.includes("mapas-visuales")) return "map";
  if (domain === "delf" || formatCategories.includes("rubricas-criterios")) return "delf";
  if (formatCategories.includes("guias-pdf")) return "guide";
  return "article";
};

const toContentResource = (item: ContentEntry): ResourceItem => {
  const formatCategories = getContentFormatCategories(item);
  const href = getContentRoute(item);

  return {
    id: `content:${item.id}`,
    slug: getFinalContentSlug(item.id),
    title: item.data.title,
    summary: item.data.description,
    href,
    levels: item.data.levels,
    competencies: getContentCompetencies(item),
    format: item.data.format,
    formatLabel: formatLabels[item.data.format],
    formatCategories,
    topics: getContentTopics(item),
    availability: item.data.coverageStatus,
    duration: item.data.duration,
    downloadable: item.data.format === "downloadable",
    featured: Boolean(href),
    visual: getVisual(formatCategories, item.data.format, item.data.domain),
    imageAlt: `Ilustración de recurso: ${item.data.title}`,
    tags: item.data.tags,
    source: "content",
  };
};

const toResourceItem = (item: ResourceEntry): ResourceItem => {
  const formatCategories = getResourceFormatCategories(item);
  const hasFile = Boolean(item.data.fileHref?.trim());
  const href = hasFile ? withBase(item.data.fileHref ?? "") : undefined;

  return {
    id: `resource:${item.id}`,
    slug: getFinalContentSlug(item.id),
    title: item.data.title,
    summary: item.data.description,
    href,
    levels: item.data.levels,
    competencies: getResourceCompetencies(item),
    format: item.data.format,
    formatLabel: formatLabels[item.data.format],
    formatCategories,
    topics: getResourceTopics(item),
    availability: hasFile ? item.data.coverageStatus : "planned",
    downloadable: hasFile,
    featured: hasFile,
    visual: getVisual(formatCategories, item.data.format),
    imageAlt: `Ilustración de recurso: ${item.data.title}`,
    tags: item.data.tags,
    source: "resources",
  };
};

// Orden del catálogo (regla D5 de Documentos_Proyecto/03_Guias/Reglas.md): por nivel (A1 → C1); dentro de cada
// nivel, primero la gramática en el orden en que se aprende (src/data/modulosGramatica.ts), después el DELF y al
// final los demás recursos. Las demostraciones no se muestran al alumno.
const ordenNiveles = ["A1", "A2", "B1", "B2", "C1"];
const nivelInicial = (lvls: string[]) => Math.min(...lvls.map((l) => ordenNiveles.indexOf(l)).filter((i) => i >= 0));
const posicionLeccion = (id: string) => {
  const i = ordenLecciones.indexOf(id);
  return i === -1 ? 999 : i;
};
const ordenDominio: Record<string, number> = { grammar: 0, delf: 1 };
const conClave = [
  ...contentItems
    .filter((item) => !item.data.demonstration)
    .map((item) => ({
      clave: [
        nivelInicial(item.data.levels),
        ordenDominio[item.data.domain] ?? 2,
        item.data.domain === "grammar" ? posicionLeccion(item.id) : (item.data.examOrder ?? 999),
      ],
      titulo: item.data.title,
      recurso: toContentResource(item),
    })),
  ...resourceItems
    .filter((item) => !item.data.demonstration)
    .map((item) => ({
      clave: [nivelInicial(item.data.levels), 3, 0],
      titulo: item.data.title,
      recurso: toResourceItem(item),
    })),
];
const resourceCatalog = conClave
  .sort(
    (a, b) =>
      a.clave[0] - b.clave[0] ||
      a.clave[1] - b.clave[1] ||
      a.clave[2] - b.clave[2] ||
      a.titulo.localeCompare(b.titulo, "es"),
  )
  .map((entrada) => entrada.recurso);

// Sin bloque de destacados: repetía temas que ya salen en el catálogo ordenado.
const featuredResources: ResourceItem[] = [];

const zeroCounts = <T extends string>(ids: readonly T[]) =>
  Object.fromEntries(ids.map((id) => [id, 0])) as Record<T, number>;

const counts = {
  levels: zeroCounts(levels.map((level) => level.id)),
  competencies: zeroCounts([
    "comprension-oral",
    "comprension-escrita",
    "produccion-oral",
    "produccion-escrita",
  ] as const),
  formats: zeroCounts(resourceFormatCategoryIds),
  topics: zeroCounts([...topicFilters.map((topic) => topic.id), "delf"] as const),
  availability: zeroCounts(coverageStatuses.map((status) => status.id)),
};

resourceCatalog.forEach((item) => {
  item.levels.forEach((level) => {
    counts.levels[level] += 1;
  });
  item.competencies.forEach((competency) => {
    counts.competencies[competency] += 1;
  });
  item.formatCategories.forEach((format) => {
    counts.formats[format] += 1;
  });
  item.topics.forEach((topic) => {
    counts.topics[topic] += 1;
  });
  counts.availability[item.availability] += 1;
});

const downloadableCount = resourceCatalog.filter((item) => item.downloadable && item.href).length;
---

<BaseLayout
  title="Recursos para aprender francés A1-C1"
  description="Explora audios, guías, ejercicios, transcripciones, recursos visuales y materiales para aprender francés desde A1 hasta C1 y preparar el DELF."
>
  <main class="resources-page">
    <ResourcesHero />
    <ResourceFormatGrid counts={counts.formats} />
    <ResourcesCatalog
      items={resourceCatalog}
      featuredItems={featuredResources}
      counts={counts}
    />
    <ResourceTopicGrid counts={counts.topics} />
    <DownloadResourcesBanner downloadableCount={downloadableCount} />
  </main>
</BaseLayout>

<style>
  .resources-page {
    background:
      radial-gradient(circle at 97% 12%, rgba(0, 85, 164, 0.045), transparent 20rem),
      radial-gradient(circle at 4% 44%, rgba(184, 134, 11, 0.065), transparent 18rem),
      var(--color-bg);
  }
</style>
