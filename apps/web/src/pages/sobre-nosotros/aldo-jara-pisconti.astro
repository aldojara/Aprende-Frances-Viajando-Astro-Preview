---
import AuthorClosing from "../../components/author/AuthorClosing.astro";
import AuthorHero from "../../components/author/AuthorHero.astro";
import ProfessionalArchitecture from "../../components/author/ProfessionalArchitecture.astro";
import ProfileConnections from "../../components/author/ProfileConnections.astro";
import ProjectEcosystem from "../../components/author/ProjectEcosystem.astro";
import ProjectPrinciples from "../../components/author/ProjectPrinciples.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const profilePageStructuredData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://aprendefrancesviajando.com/sobre-nosotros/aldo-jara-pisconti/#profilepage",
  url: "https://aprendefrancesviajando.com/sobre-nosotros/aldo-jara-pisconti/",
  name: "Aldo Jara Pisconti",
  description:
    "Conoce a Aldo Jara Pisconti, creador de Aprende Francés Viajando, y su ecosistema de proyectos que conecta datos, inteligencia artificial, educación, mentoría, viajes y contenido.",
  isPartOf: {
    "@type": "WebSite",
    "@id": "https://aprendefrancesviajando.com/#website",
    name: "Aprende Francés Viajando",
    url: "https://aprendefrancesviajando.com/",
  },
  mainEntity: {
    "@type": "Person",
    "@id": "https://aprendefrancesviajando.com/sobre-nosotros/aldo-jara-pisconti/#person",
    name: "Aldo Jara Pisconti",
    url: "https://aprendefrancesviajando.com/sobre-nosotros/aldo-jara-pisconti/",
    image: "https://aprendefrancesviajando.com/images/project/aldo-jara-pisconti-paris.webp",
    description:
      "Fundador y creador de Aprende Francés Viajando. Combina datos, inteligencia artificial, educación, mentoría, producto, comunicación y experiencias de viaje para desarrollar proyectos con utilidad real.",
    sameAs: ["https://www.linkedin.com/in/aldojarapisconti/"],
    knowsAbout: [
      "Análisis de datos",
      "Inteligencia artificial",
      "Educación",
      "EdTech",
      "Mentoría",
      "Estrategia de producto",
      "Comunicación",
      "Creación de contenidos",
    ],
  },
};
---

<BaseLayout
  title="Aldo Jara Pisconti | Autor de Aprende Francés Viajando"
  description="Conoce a Aldo Jara Pisconti, creador de Aprende Francés Viajando, y su ecosistema de proyectos que conecta datos, inteligencia artificial, educación, mentoría, viajes y contenido."
  canonical="/sobre-nosotros/aldo-jara-pisconti/"
  image="/images/project/aldo-jara-pisconti-paris.webp"
  type="profile"
  robots="index,follow"
  structuredData={profilePageStructuredData}
>
  <main class="author-page">
    <AuthorHero />
    <ProfessionalArchitecture />
    <ProjectEcosystem />
    <ProfileConnections />
    <ProjectPrinciples />
    <AuthorClosing />
  </main>
</BaseLayout>

<style>
  .author-page {
    background:
      radial-gradient(circle at 94% 8%, rgba(0, 85, 164, 0.07), transparent 22rem),
      radial-gradient(circle at 4% 38%, rgba(184, 134, 11, 0.08), transparent 20rem),
      linear-gradient(180deg, #ffffff 0, #f7fbff 34rem, var(--color-bg) 100%);
  }
</style>
