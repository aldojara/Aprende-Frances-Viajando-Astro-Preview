---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import UnidadLeccion from "../../../components/unidad/UnidadLeccion.astro";
import { passeComposeConMateriales } from "../../../data/unidades/ejemplo-materiales";

const title = `${passeComposeConMateriales.titulo} · Vista previa con todos los materiales`;
const description = passeComposeConMateriales.objetivo;
---

<BaseLayout
  title={title}
  description={description}
  robots="noindex,nofollow"
>
  <UnidadLeccion unidad={passeComposeConMateriales} />
</BaseLayout>
