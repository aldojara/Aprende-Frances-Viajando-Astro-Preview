---
import { getCollection } from "astro:content";
import ListingLayout from "../../../layouts/ListingLayout.astro";
import StatusBadge from "../../../components/shared/StatusBadge.astro";
import SectionHeader from "../../../components/shared/SectionHeader.astro";
import CatalogGrid from "../../../components/catalog/CatalogGrid.astro";
import { levels } from "../../../data/taxonomies";
import { ordenLecciones } from "../../../data/modulosGramatica";

export function getStaticPaths() {
  return levels.map((level) => ({
    params: { level: level.slug },
    props: { level },
  }));
}

const { level } = Astro.props;
const contentItems = await getCollection("content");
// Solo contenido real del nivel (las demostraciones no se muestran al alumno). La gramática va en el orden en
// que se aprende, el mismo del índice de Gramática (src/data/modulosGramatica.ts); después, el DELF del nivel.
const delNivel = contentItems.filter(
  (item) => item.data.levels.includes(level.id) && !item.data.demonstration,
);
const posicion = (id: string) => {
  const i = ordenLecciones.indexOf(id);
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
const gramatica = delNivel
  .filter((item) => item.data.domain === "grammar")
  .sort((a, b) => posicion(a.id) - posicion(b.id));
const delf = delNivel
  .filter((item) => item.data.domain === "delf")
  .sort(
    (a, b) =>
      (a.data.examOrder ?? 999) - (b.data.examOrder ?? 999) ||
      a.data.title.localeCompare(b.data.title, "es"),
  );
const otros = delNivel.filter((item) => item.data.domain !== "grammar" && item.data.domain !== "delf");
const bloques = [
  { id: "gramatica", titulo: "Gramática", descripcion: "En el orden en que se aprende.", items: gramatica },
  { id: "delf", titulo: `DELF ${level.label}`, descripcion: "Guías para preparar el examen.", items: delf },
  { id: "otros", titulo: "Más recursos", descripcion: "", items: otros },
].filter((bloque) => bloque.items.length > 0);
---

<ListingLayout
  eyebrow={`Nivel ${level.label}`}
  title={`${level.label} · ${level.name}`}
  description={level.description}
>
  <section class="section level-detail">
    <div class="container level-detail-grid">
      <aside class="level-summary card">
        <div class="level-summary-top">
          <span class="level-code">{level.label}</span>
          <StatusBadge status={level.coverageStatus} />
        </div>

        <p>
          Estamos completando este nivel tema a tema. Abajo tienes lo que ya
          puedes estudiar.
        </p>
      </aside>

      <div class="level-main">
        <SectionHeader
          eyebrow="Objetivos del nivel"
          title={`Qué podrás hacer en ${level.label}`}
          description="Lo que sabrás hacer en francés al terminar este nivel."
        />

        <ul class="capability-list">
          {level.capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section level-content">
    <div class="container level-content-layout">
      <SectionHeader
        eyebrow={`Nivel ${level.label}`}
        title={`Lo que ya puedes estudiar en ${level.label}`}
        description={
          bloques.length > 0
            ? delf.length > 0
              ? "Ordenado como se aprende: primero la gramática, después la preparación del DELF."
              : "Ordenado como se aprende."
            : "Todavía no hay temas publicados en este nivel."
        }
      />

      {bloques.length > 0 ? (
        bloques.map((bloque) => (
          <div class="level-bloque" id={`nivel-${bloque.id}`}>
            <h2 class="level-bloque-titulo">{bloque.titulo}</h2>
            {bloque.descripcion && <p class="level-bloque-desc">{bloque.descripcion}</p>}
            <CatalogGrid items={bloque.items} />
          </div>
        ))
      ) : (
        <div class="level-empty card">
          <StatusBadge status={level.coverageStatus} />
          <h2>Muy pronto</h2>
          <p>
            Estamos preparando los primeros temas de este nivel. Mientras tanto,
            puedes ver los demás niveles.
          </p>
        </div>
      )}
    </div>
  </section>
</ListingLayout>

<style>
  .level-detail {
    background: var(--color-surface);
  }

  .level-detail-grid {
    display: grid;
    grid-template-columns: minmax(13rem, 0.26fr) minmax(0, 0.74fr);
    gap: 1.25rem;
    align-items: start;
  }

  .level-summary {
    position: sticky;
    top: 6rem;
    padding: 1rem;
  }

  .level-summary-top {
    display: grid;
    gap: 0.8rem;
  }

  .level-code {
    color: var(--color-gold);
    font-family: var(--font-display);
    font-size: 3rem;
    font-weight: 800;
    line-height: 1;
  }

  .level-summary p {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }

  .level-main {
    display: grid;
    gap: 1.25rem;
  }

  .capability-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .capability-list li {
    min-height: 100%;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    color: var(--color-heading);
    font-weight: 700;
  }

  .level-bloque {
    display: grid;
    gap: 0.6rem;
  }

  .level-bloque + .level-bloque {
    margin-top: 1.5rem;
  }

  .level-bloque-titulo {
    margin: 0;
    font-size: 1.35rem;
    color: var(--color-heading);
  }

  .level-bloque-desc {
    margin: 0 0 0.4rem;
    color: var(--color-text-muted);
  }

  .level-content {
    border-top: 1px solid var(--color-border);
  }

  .level-content-layout {
    display: grid;
    gap: 1.5rem;
  }

  .level-empty {
    max-width: 680px;
    padding: 1.25rem;
  }

  .level-empty h2 {
    margin-top: 0.85rem;
    font-size: 1.45rem;
  }

  .level-empty p {
    margin: 0.55rem 0 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .level-detail-grid,
    .capability-list {
      grid-template-columns: 1fr;
    }

    .level-summary {
      position: static;
    }
  }
</style>
