---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeaturedLevelContent from "../../components/levels/FeaturedLevelContent.astro";
import HowToLevels from "../../components/levels/HowToLevels.astro";
import LevelExplorer from "../../components/levels/LevelExplorer.astro";
import LevelsFeatureBands from "../../components/levels/LevelsFeatureBands.astro";
import LevelsFinalCta from "../../components/levels/LevelsFinalCta.astro";
import LevelsHero from "../../components/levels/LevelsHero.astro";
import LevelsNextSteps from "../../components/levels/LevelsNextSteps.astro";
---

<BaseLayout
  title="Niveles de francés A1-C1"
  description="Explora la ruta de aprendizaje de francés desde A1 hasta C1, con objetivos comunicativos, gramática, vocabulario y competencias adaptadas a cada nivel."
>
  <main class="levels-page">
    <LevelsHero />
    <HowToLevels />
    <LevelExplorer />
    <LevelsFeatureBands />
    <FeaturedLevelContent />
    <LevelsNextSteps />
    <LevelsFinalCta />
  </main>
</BaseLayout>

<style>
  .levels-page {
    background:
      radial-gradient(circle at 95% 8%, rgba(0, 85, 164, 0.05), transparent 18rem),
      linear-gradient(180deg, rgba(255, 255, 255, 0.24), transparent 18rem),
      var(--color-bg);
  }
</style>
