---
// Laboratorio · Opción 2 «Práctica por fases». Solo prototipo local: noindex y fuera del sitemap.
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import EjerciciosCorregibles from "../../../../components/practica/EjerciciosCorregibles.astro";
import LaboratorioErrores from "../../../../components/practica/LaboratorioErrores.astro";
import RetoFormulario from "../../../../components/practica/RetoFormulario.astro";
import { fichaPdf } from "../../../../data/practicaAvoirEtre";
import { paso1 } from "../../../../data/practicaAvoirEtreOpcion2";
import { withBase } from "../../../../utils/paths";

const pdf = withBase(fichaPdf);
---

<BaseLayout
  title="¿Avoir o être? Práctica por fases (laboratorio · opción 2)"
  description="Prototipo: práctica en tres pasos con laboratorio de errores."
  robots="noindex,nofollow"
>
  <main data-variante="opcion-2">
    <p class="prototipo-aviso" role="note">
      Laboratorio · Opción 2 · Práctica por fases · prototipo, no publicar ·
      <a href={withBase("/laboratorio/")}>volver al laboratorio</a>
    </p>

    <section class="practica-hero">
      <div class="container">
        <p class="eyebrow">Passé composé · A2–B1</p>
        <h1>¿Avoir o être? Elige el auxiliar sin dudar</h1>
        <p class="practica-hero-texto">
          Practica en tres pasos: reconoce el auxiliar, entiende por qué te confundes y aplícalo en
          casos nuevos.
        </p>
        <div class="practica-acciones">
          <a class="button button-primary button-descarga" href={pdf} download data-descarga="cabecera">
            Descargar la ficha gratis (PDF)
          </a>
          <a class="button button-secondary" href="#paso-1">Empezar la práctica</a>
        </div>
        <p class="practica-nota">Ficha sin correo ni registro · Práctica y explicaciones gratis</p>

        <ol class="pasos" data-pasos aria-label="Pasos de la práctica">
          <li data-paso="1"><span>1</span> Reconocer <em>gratis</em></li>
          <li data-paso="2"><span>2</span> Entender tu error <em>gratis</em></li>
          <li data-paso="3"><span>3</span> Aplicarlo en casos nuevos <em>por correo</em></li>
        </ol>
      </div>
    </section>

    <section class="section" id="paso-1" aria-labelledby="paso-1-titulo">
      <div class="container seccion-estrecha">
        <p class="eyebrow">Paso 1 · Reconocer</p>
        <h2 id="paso-1-titulo">Tres parejas de frases parecidas</h2>
        <p class="seccion-intro">
          Cada pareja se parece, pero el auxiliar cambia. Elige y pulsa «Corregir»: verás las respuestas
          y por qué.
        </p>
        <details class="regla-breve">
          <summary>Repasar la regla en 30 segundos</summary>
          <p>
            ¿Pronominal (<span lang="fr">se lever</span>…)? → être. ¿Movimiento o cambio de estado
            (<span lang="fr">aller, venir, partir</span>…)? → être. Los demás → avoir. Ojo:
            <span lang="fr">sortir, monter, descendre, passer</span>… con complemento directo → avoir.
          </p>
        </details>
        <div data-paso1>
          <EjerciciosCorregibles grupo="o2" preguntas={paso1} evento="practica" />
        </div>
      </div>
    </section>

    <section class="section seccion-suave" id="paso-2" aria-labelledby="paso-2-titulo" hidden data-seccion-paso2>
      <div class="container seccion-estrecha">
        <p class="eyebrow">Paso 2 · Entender tu error · gratis</p>
        <h2 id="paso-2-titulo" tabindex="-1">Descubre por qué te confundiste</h2>
        <LaboratorioErrores />
        <p class="saltar">
          <a href="#paso-3" data-saltar>Prefiero ir directamente al paso 3</a>
        </p>
      </div>
    </section>

    <section class="section" id="paso-3" aria-labelledby="paso-3-titulo" hidden data-seccion-paso3>
      <div class="container reto">
        <div>
          <p class="eyebrow">Paso 3 · Aplicarlo · gratis, a cambio de tu correo</p>
          <h2 id="paso-3-titulo" tabindex="-1" data-oferta-titulo>Aplícalo en casos nuevos</h2>
          <p class="seccion-intro" data-oferta-texto>
            Recibe el acceso a un reto de 5 sesiones con corrección al momento.
          </p>
          <ul class="reto-lista">
            <li>Empieza por lo que te ha costado en esta práctica</li>
            <li>10 ejercicios por sesión, con la explicación de cada respuesta</li>
            <li>Tu avance se guarda en este navegador</li>
          </ul>
        </div>
        <RetoFormulario />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main [hidden] {
    display: none;
  }

  .prototipo-aviso {
    margin: 0;
    padding: 0.5rem 1rem;
    background: var(--color-gold);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .prototipo-aviso a {
    text-decoration: underline;
  }

  .practica-hero {
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(247, 244, 237, 0)),
      var(--color-bg);
    padding-block: 3rem 2.5rem;
  }

  .practica-hero h1 {
    max-width: 820px;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
  }

  .practica-hero-texto {
    max-width: 640px;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .practica-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .button-descarga {
    min-height: 3.25rem;
    padding-inline: 1.6rem;
    font-size: 1.05rem;
  }

  .practica-acciones .button-secondary {
    min-height: 3.25rem;
  }

  .practica-nota {
    margin: 0.6rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .pasos {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pasos li {
    display: inline-flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.4rem 0.8rem 0.4rem 0.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .pasos span {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 50%;
    background: var(--color-surface-soft);
    color: var(--color-blue-dark);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .pasos em {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    font-style: normal;
    font-weight: 500;
  }

  .pasos li.hecho {
    border-color: #2f7d4f;
  }

  .pasos li.hecho span {
    background: #2f7d4f;
    color: #ffffff;
  }

  .pasos li.actual {
    border-color: var(--color-blue);
  }

  .seccion-suave {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface-soft);
  }

  .seccion-estrecha {
    max-width: 820px;
  }

  .section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  }

  .seccion-intro {
    max-width: 680px;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-text-muted);
  }

  .regla-breve {
    margin-bottom: 1.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .regla-breve summary {
    color: var(--color-blue);
    cursor: pointer;
    font-weight: 600;
  }

  .regla-breve p {
    margin: 0.6rem 0 0;
  }

  .saltar {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .saltar a {
    color: var(--color-blue);
    text-decoration: underline;
  }

  .reto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .reto-lista {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  @media (max-width: 900px) {
    .reto {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { ordenEstandar } from "../../../../data/practicaAvoirEtre";
  import { confusiones } from "../../../../data/practicaAvoirEtreOpcion2";
  import { elegirConfusion, type ResultadoPregunta } from "../../../../utils/laboratorioErrores";
  import { guardarProgreso, leerProgreso, track } from "../../../../utils/track";

  const paso2 = document.querySelector<HTMLElement>("[data-seccion-paso2]");
  const paso3 = document.querySelector<HTMLElement>("[data-seccion-paso3]");
  const mensaje = document.querySelector<HTMLElement>("[data-lab-mensaje]");
  const pasos = document.querySelector<HTMLElement>("[data-pasos]");
  const ofertaTitulo = document.querySelector<HTMLElement>("[data-oferta-titulo]");
  const ofertaTexto = document.querySelector<HTMLElement>("[data-oferta-texto]");
  const nombre = (id: string) => confusiones.find((c) => c.id === id)?.nombre ?? "";

  const marcarPaso = (hecho: number) => {
    pasos?.querySelectorAll<HTMLElement>("[data-paso]").forEach((paso) => {
      const n = Number(paso.dataset.paso);
      paso.classList.toggle("hecho", n <= hecho);
      paso.classList.toggle("actual", n === hecho + 1);
    });
  };

  const irA = (seccion: HTMLElement | null) => {
    if (!seccion) return;
    seccion.hidden = false;
    seccion.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
    seccion.scrollIntoView({ behavior: "smooth", block: "start" });
  };

  let confusionActual = "";
  let modoActual = "";

  const mostrarPaso3 = () => {
    const nombreConfusion = nombre(confusionActual);
    if (ofertaTitulo && ofertaTexto) {
      if (modoActual === "con-fallos") {
        ofertaTitulo.textContent = `Practica «${nombreConfusion}» en casos nuevos`;
        ofertaTexto.textContent =
          "Recibe el acceso a un reto de 5 sesiones que empieza justo por lo que te costó, con corrección al momento.";
      } else {
        const inicio =
          modoActual === "incompleto"
            ? "No hubo errores en lo que respondiste."
            : "No fallaste en esta práctica.";
        ofertaTitulo.textContent = "Consolídalo en casos nuevos";
        ofertaTexto.textContent = `${inicio} Recibe el acceso a un reto de 5 sesiones con casos más variados, con corrección al momento.`;
      }
    }
    marcarPaso(2);
    track("paso3_visto", { confusion: confusionActual, modo: modoActual });
    irA(paso3);
  };

  document.querySelector("[data-paso1]")?.addEventListener("afv:corregido", (event) => {
    const { resultados } = (event as CustomEvent<{ resultados: ResultadoPregunta[] }>).detail;
    const eleccion = elegirConfusion(resultados, confusiones, ordenEstandar);
    confusionActual = eleccion.confusion;
    modoActual = eleccion.modo;

    const progreso = leerProgreso();
    guardarProgreso({ ...progreso, orden: eleccion.orden.join("-") });

    if (mensaje) {
      const faltan = eleccion.sinResponder
        ? ` Dejaste ${eleccion.sinResponder} sin responder; no las contamos como fallos.`
        : "";
      if (eleccion.modo === "con-fallos") {
        const otras = eleccion.conFallos.slice(1).map(nombre);
        mensaje.textContent =
          `Te costó: ${nombre(eleccion.confusion)}. Veamos por qué.` +
          (otras.length ? ` También fallaste en: ${otras.join(", ")}.` : "") +
          faltan;
      } else if (eleccion.modo === "incompleto") {
        mensaje.textContent = `Sin errores en las respuestas que diste.${faltan} ¿Sabrías explicar por qué cambia el auxiliar?`;
      } else {
        mensaje.textContent = "¡Sin errores! ¿Sabrías explicar por qué cambia el auxiliar?";
      }
    }

    document.querySelectorAll<HTMLElement>("[data-confusion]").forEach((bloque) => {
      bloque.hidden = bloque.dataset.confusion !== eleccion.confusion;
    });

    marcarPaso(1);
    track("laboratorio_inicio", { confusion: eleccion.confusion, modo: eleccion.modo });
    irA(paso2);
  });

  document.querySelectorAll<HTMLElement>("[data-confusion]").forEach((bloque) => {
    const confusion = bloque.dataset.confusion ?? "";

    bloque.querySelector("[data-comprobar-razon]")?.addEventListener("click", () => {
      const elegida = bloque.querySelector<HTMLInputElement>("[data-razones] input:checked");
      const aviso = bloque.querySelector<HTMLElement>("[data-aviso-razon]");
      if (aviso) aviso.hidden = Boolean(elegida);
      if (!elegida) return;

      bloque.querySelectorAll<HTMLElement>("[data-respuesta]").forEach((respuesta, indice) => {
        respuesta.hidden = indice !== Number(elegida.value) && respuesta.dataset.correcta !== "true";
      });
      const correcta =
        bloque.querySelectorAll<HTMLElement>("[data-respuesta]")[Number(elegida.value)]?.dataset
          .correcta === "true";
      track("laboratorio_razon", { confusion, correcta: correcta ? "si" : "no" });

      const ejemplo = bloque.querySelector<HTMLElement>("[data-ejemplo]");
      if (ejemplo) ejemplo.hidden = false;
    });

    bloque.querySelector("[data-corregir-ejemplo]")?.addEventListener("click", () => {
      const item = bloque.querySelector<HTMLElement>("[data-ejemplo] [data-pregunta]");
      if (!item) return;
      const elegida = item.querySelector<HTMLInputElement>("input:checked");
      const correcta = Number(item.dataset.correcta);
      const veredicto = item.querySelector<HTMLElement>("[data-veredicto]");
      const solucion = item.querySelector<HTMLElement>("[data-solucion]");
      const feedback = item.querySelector<HTMLElement>("[data-feedback]");
      const opciones = Array.from(item.querySelectorAll<HTMLInputElement>("input"));

      item.classList.remove("es-correcta", "es-incorrecta", "sin-responder");
      const acierto = Boolean(elegida) && Number(elegida?.value) === correcta;
      item.classList.add(!elegida ? "sin-responder" : acierto ? "es-correcta" : "es-incorrecta");
      if (veredicto) veredicto.textContent = !elegida ? "Sin responder." : acierto ? "¡Correcto!" : "No es correcto.";
      if (solucion) solucion.textContent = `Respuesta: ${opciones[correcta]?.closest("label")?.textContent?.trim()}.`;
      if (feedback) feedback.hidden = false;

      track("laboratorio_ejemplo", { confusion, correcta: acierto ? "si" : "no" });
      mostrarPaso3();
    });
  });

  document.querySelector("[data-saltar]")?.addEventListener("click", (event) => {
    event.preventDefault();
    mostrarPaso3();
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-descarga]").forEach((boton) => {
    boton.addEventListener("click", () => track("descarga_ficha", { posicion: boton.dataset.descarga ?? "" }));
  });
</script>
