---
// Laboratorio · Opción 3 «Mira, entiende y vuelve a probar». Solo prototipo local: noindex y
// fuera del sitemap. El vídeo provisional vive en public/laboratorio-local/ (fuera de git).
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import EjerciciosCorregibles from "../../../../components/practica/EjerciciosCorregibles.astro";
import PreguntaOpciones from "../../../../components/practica/PreguntaOpciones.astro";
import RetoFormulario from "../../../../components/practica/RetoFormulario.astro";
import { fichaPdf } from "../../../../data/practicaAvoirEtre";
import { ayudas, desafio, ejercicios } from "../../../../data/practicaAvoirEtreOpcion3";
import { withBase } from "../../../../utils/paths";

const pdf = withBase(fichaPdf);
---

<BaseLayout
  title="¿Avoir o être? Mira, entiende y vuelve a probar (laboratorio · opción 3)"
  description="Prototipo: práctica con vídeo de ayuda según tu error."
  robots="noindex,nofollow"
>
  <main data-variante="opcion-3">
    <p class="prototipo-aviso" role="note">
      Laboratorio · Opción 3 · Mira, entiende y vuelve a probar · prototipo, no publicar ·
      <a href={withBase("/laboratorio/")}>volver al laboratorio</a>
    </p>

    <section class="practica-hero">
      <div class="container">
        <p class="eyebrow">Passé composé · A2–B1</p>
        <h1>¿Avoir o être? Elige el auxiliar sin dudar</h1>
        <p class="practica-hero-texto">
          Responde, corrige y, si fallas, mira una explicación breve en vídeo de justo ese error.
        </p>
        <div class="practica-acciones">
          <a class="button button-primary button-descarga" href={pdf} download data-descarga="cabecera">
            Descargar la ficha gratis (PDF)
          </a>
          <a class="button button-secondary" href="#practica">Empezar la práctica</a>
        </div>
        <p class="practica-nota">Ficha sin correo ni registro · Práctica, respuestas y vídeos gratis</p>
      </div>
    </section>

    <section class="section" id="practica" aria-labelledby="practica-titulo">
      <div class="container seccion-media">
        <p class="eyebrow">Practica</p>
        <h2 id="practica-titulo">8 frases: ¿avoir o être?</h2>
        <p class="seccion-intro">Elige una opción en cada frase y pulsa «Corregir».</p>
        <div class="seccion-estrecha" data-practica id="mis-respuestas">
          <EjerciciosCorregibles grupo="o3" preguntas={ejercicios} evento="practica" />
        </div>

        <!-- Aparece al corregir, justo bajo el resultado -->
        <div class="ayuda" data-ayuda-zona hidden>
          <div class="ayuda-resumen card" data-resumen tabindex="-1">
            <p class="ayuda-recuento" data-recuento aria-live="polite"></p>
            <p class="ayuda-sin-respuestas" data-sin-respuestas hidden>
              Responde al menos una frase para ver tu ayuda.
            </p>
            <a class="enlace" href="#mis-respuestas" data-ver-respuestas>Ver mis respuestas ↑</a>
          </div>

          <div class="ayuda-pestanas" data-pestanas hidden>
            <span>Repasar:</span>
          </div>

          {
            Object.values(ayudas).map((ayuda) => (
              <section class="ayuda-bloque card" data-ayuda={ayuda.tipo} hidden>
                <div class="ayuda-media">
                  <div class="ayuda-marco">
                    <video
                      controls
                      playsinline
                      preload="metadata"
                      src={withBase(ayuda.video)}
                      data-video
                    />
                    <button class="button button-primary ayuda-play" type="button" data-ver-video>
                      ▶ Entender esta diferencia
                    </button>
                  </div>
                  {ayuda.videoProvisional && (
                    <p class="ayuda-nota">
                      Vídeo provisional (vertical V1, 78 s). El clip definitivo de este error está por
                      producir.
                    </p>
                  )}
                  <p class="ayuda-nota ayuda-error" data-video-error hidden>
                    El vídeo no está disponible en esta copia del prototipo. Lee la explicación.
                  </p>
                </div>

                <div class="ayuda-info">
                  <p class="eyebrow">Vamos a repasar esta diferencia</p>
                  <h3 tabindex="-1">{ayuda.titulo}</h3>
                  <p class="ayuda-tu-respuesta" data-tu-respuesta />

                  <details class="ayuda-texto">
                    <summary>Prefiero leerlo</summary>
                    <p>{ayuda.resumen}</p>
                  </details>

                  <div class="ayuda-ejemplo" data-ejemplo-zona hidden>
                    <h4>Un caso nuevo</h4>
                    <ol class="lista-limpia" data-instantaneo>
                      <PreguntaOpciones
                        pregunta={ayuda.ejemploNuevo}
                        numero={1}
                        grupo={`o3-nuevo-${ayuda.tipo}`}
                      />
                    </ol>
                    <p class="ayuda-pista" data-pista hidden>
                      {ayuda.pista}
                      <button class="enlace-boton" type="button" data-rever>Volver a ver el vídeo</button>
                    </p>
                  </div>

                  <div class="ayuda-acciones">
                    <button class="button button-secondary" type="button" data-probar>
                      Comprobar si lo entendí
                    </button>
                    <button class="button button-primary" type="button" data-continuar>
                      Recibir práctica sobre esta dificultad
                    </button>
                  </div>
                </div>
              </section>
            ))
          }

          <section class="ayuda-bloque ayuda-bloque-simple card" data-sin-fallos hidden>
            <p class="eyebrow">Sin errores</p>
            <h3 tabindex="-1" data-sin-fallos-titulo>¡Sin errores!</h3>
            <p>¿Te atreves con un desafío? Tres frases más difíciles; la corrección aparece al elegir.</p>
            <ol class="lista-limpia desafio" data-instantaneo>
              {desafio.map((pregunta, indice) => (
                <PreguntaOpciones pregunta={pregunta} numero={indice + 1} grupo="o3-desafio" />
              ))}
            </ol>
            <div class="ayuda-acciones">
              <button class="button button-primary" type="button" data-continuar>
                Recibir más práctica
              </button>
            </div>
          </section>
        </div>
      </div>
    </section>

    <section class="section seccion-suave" id="seguir" aria-labelledby="seguir-titulo" hidden data-seccion-seguir>
      <div class="container reto">
        <div>
          <p class="eyebrow">Gratis, a cambio de tu correo</p>
          <h2 id="seguir-titulo" tabindex="-1" data-oferta-titulo>Recibe más práctica como esta</h2>
          <p class="seccion-intro" data-oferta-texto>
            Un reto de 5 sesiones con corrección al momento.
          </p>
          <ul class="reto-lista">
            <li>Empieza por lo que te ha costado</li>
            <li>10 ejercicios por sesión, con la explicación de cada respuesta</li>
            <li>Tu avance se guarda en este navegador</li>
          </ul>
        </div>
        <RetoFormulario />
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main [hidden] {
    display: none;
  }

  /* El resumen de la ayuda (correctas · incorrectas · sin responder) sustituye a la línea genérica. */
  [data-practica] :global([data-resultado]) {
    display: none;
  }

  /* La cabecera de la web es fija: los destinos de los enlaces dejan margen para no quedar tapados. */
  main :global([data-pregunta]),
  #mis-respuestas,
  .ayuda-resumen,
  .ayuda-bloque,
  #seguir {
    scroll-margin-top: 6rem;
  }

  .prototipo-aviso {
    margin: 0;
    padding: 0.5rem 1rem;
    background: var(--color-gold);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .prototipo-aviso a {
    text-decoration: underline;
  }

  .practica-hero {
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.54), rgba(247, 244, 237, 0)),
      var(--color-bg);
    padding-block: 3rem 2.5rem;
  }

  .practica-hero h1 {
    max-width: 820px;
    font-size: clamp(2.2rem, 5vw, 4.2rem);
  }

  .practica-hero-texto {
    max-width: 640px;
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .practica-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .button-descarga,
  .practica-acciones .button-secondary {
    min-height: 3.25rem;
  }

  .button-descarga {
    padding-inline: 1.6rem;
    font-size: 1.05rem;
  }

  .practica-nota {
    margin: 0.6rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .seccion-media {
    max-width: 980px;
  }

  .seccion-estrecha {
    max-width: 820px;
  }

  .section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  }

  .seccion-intro {
    max-width: 680px;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-text-muted);
  }

  .seccion-suave {
    border-block: 1px solid var(--color-border);
    background: var(--color-surface-soft);
  }

  .ayuda {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .ayuda-resumen {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    align-items: center;
    padding: 0.9rem 1.25rem;
  }

  .ayuda-recuento,
  .ayuda-sin-respuestas {
    margin: 0;
    color: var(--color-heading);
    font-weight: 700;
  }

  .enlace,
  .enlace-boton {
    color: var(--color-blue);
    font-weight: 600;
    text-decoration: underline;
  }

  .enlace-boton {
    margin-left: 0.4rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
  }

  .ayuda-pestanas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-weight: 600;
  }

  .ayuda-pestanas :global(button[aria-pressed="true"]) {
    border-color: var(--color-blue);
    background: rgba(0, 85, 164, 0.08);
    color: var(--color-blue);
  }

  .ayuda-bloque {
    display: grid;
    grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: 1.25rem;
    border-left: 4px solid var(--color-gold);
  }

  .ayuda-bloque-simple {
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  .ayuda-marco {
    position: relative;
  }

  .ayuda-marco video {
    display: block;
    width: 100%;
    aspect-ratio: 9 / 16;
    max-height: 70vh;
    border-radius: var(--radius-md);
    background: #0b2f55;
  }

  .ayuda-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max-content;
    max-width: 90%;
    min-height: 3.25rem;
    transform: translate(-50%, -50%);
    box-shadow: var(--shadow-md);
  }

  .ayuda-play:hover {
    transform: translate(-50%, calc(-50% - 1px));
  }

  .ayuda-nota {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .ayuda-error {
    color: var(--color-red);
  }

  .ayuda-info {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .ayuda-info .eyebrow,
  .ayuda-bloque-simple .eyebrow {
    margin-bottom: -0.5rem;
  }

  .ayuda-bloque h3 {
    font-size: 1.5rem;
  }

  .ayuda-bloque h4 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  .ayuda-tu-respuesta {
    margin: 0;
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface-soft);
  }

  .ayuda-texto summary {
    color: var(--color-blue);
    cursor: pointer;
    font-weight: 600;
  }

  .ayuda-texto p {
    margin: 0.5rem 0 0;
  }

  .ayuda-ejemplo {
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  .lista-limpia {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ayuda-pista {
    margin: 0.75rem 0 0;
    font-weight: 600;
  }

  .ayuda-acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .reto {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .reto-lista {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding-left: 1.2rem;
  }

  @media (max-width: 900px) {
    .reto,
    .ayuda-bloque {
      grid-template-columns: 1fr;
    }

    .ayuda-media {
      max-width: 320px;
    }
  }
</style>

<script>
  import { ordenEstandar } from "../../../../data/practicaAvoirEtre";
  import { ayudas, ejercicios, type TipoVideo } from "../../../../data/practicaAvoirEtreOpcion3";
  import {
    decidirAyuda,
    ordenDesde,
    type ResultadoEjercicio,
  } from "../../../../utils/ayudaVideo";
  import { guardarProgreso, leerProgreso, track } from "../../../../utils/track";

  const zona = document.querySelector<HTMLElement>("[data-ayuda-zona]");
  const resumen = document.querySelector<HTMLElement>("[data-resumen]");
  const recuentoTexto = document.querySelector<HTMLElement>("[data-recuento]");
  const sinRespuestas = document.querySelector<HTMLElement>("[data-sin-respuestas]");
  const verRespuestas = document.querySelector<HTMLAnchorElement>("[data-ver-respuestas]");
  const pestanas = document.querySelector<HTMLElement>("[data-pestanas]");
  const sinFallos = document.querySelector<HTMLElement>("[data-sin-fallos]");
  const seguir = document.querySelector<HTMLElement>("[data-seccion-seguir]");
  const ofertaTitulo = document.querySelector<HTMLElement>("[data-oferta-titulo]");
  const ofertaTexto = document.querySelector<HTMLElement>("[data-oferta-texto]");
  const bloques = Array.from(document.querySelectorAll<HTMLElement>("[data-ayuda]"));
  const tipoPorId = Object.fromEntries(ejercicios.map((e) => [e.id, e.tipo])) as Record<string, TipoVideo>;
  const nombreCorto = (tipo: TipoVideo) => ayudas[tipo].titulo.split(":")[0];
  const textoOpcion = (id: string, indice: number) =>
    ejercicios.find((e) => e.id === id)?.opciones[indice] ?? "";

  // Estado de la ayuda: el tipo que se ve manda sobre la comparación, la oferta y el reto.
  let modoActual = "";
  let tipoActual: TipoVideo | null = null;
  let tiposConFallos: TipoVideo[] = [];
  let falladoPorTipo: Partial<Record<TipoVideo, string>> = {};

  const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;

  const pausarVideos = () =>
    document.querySelectorAll<HTMLVideoElement>("[data-video]").forEach((video) => video.pause());

  const seleccionarTipo = (tipo: TipoVideo) => {
    tipoActual = tipo;
    pausarVideos();
    bloques.forEach((bloque) => (bloque.hidden = bloque.dataset.ayuda !== tipo));

    const bloque = bloques.find((b) => b.dataset.ayuda === tipo);
    const tuRespuesta = bloque?.querySelector<HTMLElement>("[data-tu-respuesta]");
    const fallado = falladoPorTipo[tipo];
    const item = fallado
      ? document.querySelector<HTMLElement>(`[data-practica] [data-pregunta="${fallado}"]`)
      : null;
    const elegida = item?.querySelector<HTMLInputElement>("input:checked");
    if (tuRespuesta && fallado && item && elegida) {
      tuRespuesta.textContent = `Elegiste «${textoOpcion(fallado, Number(elegida.value))}»; la correcta es «${textoOpcion(fallado, Number(item.dataset.correcta))}».`;
    }

    pestanas?.querySelectorAll<HTMLButtonElement>("button").forEach((boton) => {
      boton.setAttribute("aria-pressed", String(boton.dataset.tipo === tipo));
    });

    guardarProgreso({ ...leerProgreso(), orden: ordenDesde(tipo, tiposConFallos, ordenEstandar).join("-") });
  };

  const irASeguir = () => {
    if (ofertaTitulo && ofertaTexto) {
      if (modoActual === "con-fallos" && tipoActual) {
        ofertaTitulo.textContent = "Recibe práctica sobre esta dificultad";
        ofertaTexto.textContent = `Un reto de 5 sesiones que empieza por «${nombreCorto(tipoActual)}», con corrección al momento.`;
      } else {
        ofertaTitulo.textContent = "Sigue practicando con casos más variados";
        ofertaTexto.textContent = "Un reto de 5 sesiones con corrección al momento.";
      }
    }
    pausarVideos();
    track("seguir_visto", { modo: modoActual, tipo: tipoActual ?? "ninguno" });
    if (seguir) {
      seguir.hidden = false;
      seguir.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
      seguir.scrollIntoView({ behavior: "smooth", block: "start" });
    }
  };

  document.querySelector("[data-practica]")?.addEventListener("afv:corregido", (event) => {
    const { resultados } = (event as CustomEvent<{ resultados: ResultadoEjercicio[] }>).detail;
    const decision = decidirAyuda(resultados, tipoPorId, ordenEstandar);
    modoActual = decision.modo;
    if (!zona || !recuentoTexto) return;

    zona.hidden = false;
    const { correctas, incorrectas, sinResponder: vacias } = decision.recuento;
    recuentoTexto.textContent = [
      plural(correctas, "correcta", "correctas"),
      plural(incorrectas, "incorrecta", "incorrectas"),
      plural(vacias, "sin responder", "sin responder"),
    ].join(" · ");

    bloques.forEach((b) => (b.hidden = true));
    if (sinFallos) sinFallos.hidden = true;
    if (pestanas) pestanas.hidden = true;
    if (sinRespuestas) sinRespuestas.hidden = decision.modo !== "sin-respuestas";
    tipoActual = null;

    if (decision.modo === "con-fallos") {
      tiposConFallos = decision.tipos;
      falladoPorTipo = decision.falladoPorTipo;
      if (pestanas) {
        pestanas.querySelectorAll("button").forEach((b) => b.remove());
        decision.tipos.forEach((tipo) => {
          const boton = document.createElement("button");
          boton.type = "button";
          boton.className = "button button-secondary";
          boton.dataset.tipo = tipo;
          boton.textContent = nombreCorto(tipo);
          boton.addEventListener("click", () => {
            seleccionarTipo(tipo);
            track("ayuda_cambiada", { tipo });
          });
          pestanas.append(boton);
        });
        pestanas.hidden = decision.tipos.length < 2;
      }
      seleccionarTipo(decision.tipos[0]);
      track("ayuda_ofrecida", { modo: "con-fallos", tipo: decision.tipos[0] });
    } else if (decision.modo === "sin-fallos") {
      tiposConFallos = [];
      guardarProgreso({ ...leerProgreso(), orden: decision.orden.join("-") });
      if (sinFallos) {
        sinFallos.hidden = false;
        const titulo = sinFallos.querySelector<HTMLElement>("[data-sin-fallos-titulo]");
        if (titulo) {
          titulo.textContent = vacias
            ? "Sin errores en las frases que respondiste"
            : "¡Sin errores!";
        }
      }
      track("ayuda_ofrecida", { modo: "sin-fallos" });
    }

    // El resultado queda visible: se muestra el resumen, no se salta más abajo.
    resumen?.focus({ preventScroll: true });
    resumen?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  verRespuestas?.addEventListener("click", (event) => {
    event.preventDefault();
    const destino =
      document.querySelector<HTMLElement>("[data-practica] .es-incorrecta") ??
      document.querySelector<HTMLElement>("[data-practica] .sin-responder") ??
      document.querySelector<HTMLElement>("#mis-respuestas");
    destino?.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  bloques.forEach((bloque) => {
    const tipo = bloque.dataset.ayuda ?? "";
    const video = bloque.querySelector<HTMLVideoElement>("[data-video]");
    const botonVer = bloque.querySelector<HTMLElement>("[data-ver-video]");
    const ejemploZona = bloque.querySelector<HTMLElement>("[data-ejemplo-zona]");

    const verVideo = () => {
      if (!video) return;
      if (botonVer) botonVer.hidden = true;
      video.play().catch(() => undefined);
      track("video_play", { tipo });
    };

    botonVer?.addEventListener("click", verVideo);
    video?.addEventListener("play", () => {
      if (botonVer) botonVer.hidden = true;
    });
    bloque.querySelector("[data-rever]")?.addEventListener("click", () => {
      if (video) video.currentTime = 0;
      verVideo();
      bloque.scrollIntoView({ behavior: "smooth", block: "start" });
    });
    video?.addEventListener("ended", () => {
      track("video_fin", { tipo });
      if (ejemploZona) ejemploZona.hidden = false;
    });
    video?.addEventListener("error", () => {
      if (botonVer) botonVer.hidden = true;
      const aviso = bloque.querySelector<HTMLElement>("[data-video-error]");
      if (aviso) aviso.hidden = false;
      const detalles = bloque.querySelector<HTMLDetailsElement>("details");
      if (detalles) detalles.open = true;
    });

    bloque.querySelector("[data-probar]")?.addEventListener("click", () => {
      if (!ejemploZona) return;
      ejemploZona.hidden = false;
      ejemploZona.querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
      ejemploZona.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  });

  // Ejercicios de un clic: la corrección aparece al elegir.
  document.querySelectorAll<HTMLElement>("[data-instantaneo]").forEach((lista) => {
    lista.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;
      const item = input.closest<HTMLElement>("[data-pregunta]");
      if (!item) return;
      const correcta = Number(item.dataset.correcta);
      const acierto = Number(input.value) === correcta;
      const opciones = Array.from(item.querySelectorAll<HTMLInputElement>("input"));
      const veredicto = item.querySelector<HTMLElement>("[data-veredicto]");
      const solucion = item.querySelector<HTMLElement>("[data-solucion]");
      const feedback = item.querySelector<HTMLElement>("[data-feedback]");
      const bloque = lista.closest<HTMLElement>("[data-ayuda]");

      item.classList.remove("es-correcta", "es-incorrecta");
      item.classList.add(acierto ? "es-correcta" : "es-incorrecta");
      if (veredicto) {
        veredicto.textContent = acierto
          ? bloque
            ? "¡Correcto! Has resuelto un caso nuevo de esta diferencia."
            : "¡Correcto!"
          : "No es correcto.";
      }
      if (solucion) solucion.textContent = `Respuesta: ${opciones[correcta]?.closest("label")?.textContent?.trim()}.`;
      if (feedback) feedback.hidden = false;

      const pista = bloque?.querySelector<HTMLElement>("[data-pista]");
      if (pista) pista.hidden = acierto;
      track(bloque ? "ejemplo_nuevo" : "desafio", {
        tipo: bloque?.dataset.ayuda ?? "desafio",
        correcta: acierto ? "si" : "no",
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-continuar]").forEach((boton) => {
    boton.addEventListener("click", irASeguir);
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-descarga]").forEach((boton) => {
    boton.addEventListener("click", () => track("descarga_ficha", { posicion: boton.dataset.descarga ?? "" }));
  });
</script>
