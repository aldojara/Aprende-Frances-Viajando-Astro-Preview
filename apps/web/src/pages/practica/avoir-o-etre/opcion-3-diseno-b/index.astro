---
// Laboratorio · Opción 3 · Diseño B. Mismo recorrido y lógica que la opción 3, con el diseño elegido en
// Claude Design (dirección B «tutor visual» con la claridad de A). Solo prototipo local: noindex y fuera
// del sitemap. El avatar y el vídeo provisionales viven en public/laboratorio-local/ (fuera de git).
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import EjerciciosCorregibles from "../../../../components/practica/EjerciciosCorregibles.astro";
import PreguntaOpciones from "../../../../components/practica/PreguntaOpciones.astro";
import RetoFormulario from "../../../../components/practica/RetoFormulario.astro";
import { fichaPdf } from "../../../../data/practicaAvoirEtre";
import {
  ayudas,
  desafio,
  ejercicios,
  fraseCorrecta,
  VIDEO_PROVISIONAL,
  videoPorEjercicio,
} from "../../../../data/practicaAvoirEtreOpcion3";
import { withBase } from "../../../../utils/paths";

const pdf = withBase(fichaPdf);
const avatar = withBase("/laboratorio-local/avatar-provisional.jpg");
const partes = (enunciado: string) => {
  const [antes, despues = ""] = enunciado.split("___");
  return { antes, despues };
};
---

<BaseLayout
  title="¿Avoir o être? Mira, entiende y vuelve a probar (laboratorio · opción 3 · diseño B)"
  description="Prototipo: práctica con ayuda para cada error, diseño B."
  robots="noindex,nofollow"
>
  <main class="diseno-b" data-variante="opcion-3-diseno-b">
    <p class="prototipo-aviso" role="note">
      Laboratorio · Opción 3 · Diseño B · prototipo, no publicar ·
      <a href={withBase("/laboratorio/")}>volver al laboratorio</a>
    </p>

    <section class="b-hero">
      <div class="container b-hero-dentro">
        <div class="b-tutor">
          <img class="b-avatar" src={avatar} alt="Tu profesor" width="76" height="76" data-avatar />
          <p class="b-bocadillo">Responde las 8 frases. Si fallas alguna, te explico justo ese error.</p>
        </div>

        <div class="b-titulo">
          <p class="b-eyebrow">Passé composé · A2–B1</p>
          <h1>¿Avoir o être? Elige el auxiliar sin dudar</h1>
        </div>

        <div class="b-descarga">
          <div class="b-descarga-botones">
            <a class="b-boton b-boton-oro" href={pdf} download data-descarga="cabecera">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 21h14"></path></svg>
              Descargar la ficha gratis (PDF)
            </a>
            <a class="b-boton b-boton-contorno" href="#practica">Empezar la práctica</a>
          </div>
          <p class="b-nota">2 páginas · sin correo ni registro</p>
          <p class="b-descargada" role="status" data-descargada hidden>
            <strong>Ficha descargada.</strong> ¿Pruebas 8 frases para ver si la dominas? ↓
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="practica" aria-labelledby="practica-titulo">
      <div class="container seccion-estrecha">
        <p class="eyebrow">Practica</p>
        <h2 id="practica-titulo">8 frases: ¿avoir o être?</h2>
        <p class="seccion-intro">Elige una opción en cada frase y pulsa «Corregir».</p>
        <div data-practica>
          <EjerciciosCorregibles grupo="o3b" preguntas={ejercicios} evento="practica" />
        </div>

        <!-- Aparece al corregir: todo se revisa sin salir de esta tarjeta -->
        <section class="ayuda" data-ayuda-zona aria-labelledby="ayuda-titulo" hidden>
          <header class="ayuda-cabecera">
            <p class="ayuda-recuento" data-recuento aria-live="polite"></p>
            <h3 id="ayuda-titulo" tabindex="-1" data-estado-titulo></h3>
            <p class="ayuda-estado" data-estado-texto></p>
          </header>

          <ol class="errores" data-errores hidden>
            {
              ejercicios.map((ejercicio, indice) => {
                const { antes, despues } = partes(ejercicio.enunciado);
                const video = videoPorEjercicio[ejercicio.id];
                const ayuda = ayudas[ejercicio.tipo];
                return (
                  <li class="error" data-fallo={ejercicio.id} data-tipo={ejercicio.tipo} hidden>
                    <button
                      class="error-boton"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`error-${ejercicio.id}`}
                      data-error-boton
                    >
                      <span class="error-numero">Frase {indice + 1}</span>
                      <span class="error-frase" lang="fr">
                        {antes}
                        <span class="hueco">___</span>
                        {despues}
                      </span>
                      <span class="error-comparacion">
                        <span class="etiqueta etiqueta-mal">
                          <span class="etiqueta-titulo">Elegiste</span>
                          <s lang="fr" data-elegida />
                        </span>
                        <span class="etiqueta etiqueta-bien">
                          <span class="etiqueta-titulo">Correcta</span>
                          <strong lang="fr">{ejercicio.opciones[ejercicio.correcta]}</strong>
                        </span>
                      </span>
                      <svg class="error-icono" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
                    </button>

                    <div class="error-panel" id={`error-${ejercicio.id}`} data-error-panel hidden>
                      <p class="error-explicacion">{ejercicio.explicacion}</p>
                      <p class="error-correcta">
                        <span>Frase correcta:</span> <span lang="fr">{fraseCorrecta(ejercicio)}</span>
                      </p>

                      <!-- Antes del vídeo: el reto, sin pasos previos obligatorios -->
                      <div class="error-reto">
                        <button
                          class="b-boton b-boton-oro"
                          type="button"
                          aria-expanded="false"
                          aria-controls="reto-zona"
                          data-abrir-reto
                        >
                          Quiero acertar la próxima →
                        </button>
                        <p class="invitacion-linea">Reto de 5 sesiones gratis · recibe el acceso por correo</p>
                      </div>
                      <div class="reto-hueco" data-reto-hueco />

                      {video && (
                        <button
                          class="b-video"
                          type="button"
                          aria-expanded="false"
                          aria-controls={`video-${ejercicio.id}`}
                          data-ver-video
                        >
                          <span class="b-video-icono" aria-hidden="true">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
                          </span>
                          <span class="b-video-texto">
                            <strong>Ver el vídeo de este error</strong>
                            {video === VIDEO_PROVISIONAL && <span>Vista previa con el vídeo provisional</span>}
                          </span>
                        </button>
                      )}
                      <p class="aviso-video" data-video-pendiente hidden={Boolean(video)}>
                        Vídeo pendiente: el clip de este ejemplo está en preparación.
                      </p>
                      {video && (
                        <div class="error-video-zona" id={`video-${ejercicio.id}`} data-video-zona hidden>
                          <video class="error-video" controls playsinline preload="metadata" src={withBase(video)} data-video />
                          {video === VIDEO_PROVISIONAL && (
                            <p class="aviso-video">
                              Vista previa con el vídeo provisional V1 (78 s). El clip de esta frase durará unos 16 s.
                            </p>
                          )}
                        </div>
                      )}

                      <div class="error-practica">
                        <button class="enlace-boton" type="button" data-probar>Comprobar si lo entendí</button>
                        <div class="ayuda-ejemplo" data-ejemplo-zona hidden>
                          <h4>Un caso nuevo · {ayuda.titulo}</h4>
                          <ol class="lista-limpia" data-instantaneo>
                            <PreguntaOpciones
                              pregunta={ayuda.ejemploNuevo}
                              numero={1}
                              grupo={`o3b-nuevo-${ejercicio.id}`}
                            />
                          </ol>
                          <p class="ayuda-pista" data-pista hidden>{ayuda.pista}</p>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })
            }
          </ol>

          <div class="vacias" data-vacias hidden>
            <p class="vacias-titulo">Sin responder · no cuentan como error</p>
            <ul class="lista-limpia">
              {
                ejercicios.map((ejercicio, indice) => {
                  const { antes, despues } = partes(ejercicio.enunciado);
                  return (
                    <li class="vacia" data-vacia={ejercicio.id} hidden>
                      <span>
                        <span class="error-numero">Frase {indice + 1}</span>{" "}
                        <span lang="fr">
                          {antes}
                          <span class="hueco">___</span>
                          {despues}
                        </span>
                      </span>
                      <button class="enlace-boton" type="button" data-responder={ejercicio.id}>
                        Responder
                      </button>
                    </li>
                  );
                })
              }
            </ul>
          </div>

          <div class="desafio-zona" data-desafio hidden>
            <p>¿Te atreves con un desafío? Tres frases más difíciles; la corrección aparece al elegir.</p>
            <ol class="lista-limpia" data-instantaneo>
              {desafio.map((pregunta, indice) => (
                <PreguntaOpciones pregunta={pregunta} numero={indice + 1} grupo="o3b-desafio" />
              ))}
            </ol>
          </div>

          <!-- Invitación general al reto, siempre al final. Un solo formulario: se mueve al hueco del botón
               que se pulse (este o el de un error) y conserva lo escrito. -->
          <div class="invitacion" data-invitacion>
            <button
              class="b-boton b-boton-contorno-oscuro"
              type="button"
              aria-expanded="false"
              aria-controls="reto-zona"
              data-abrir-reto
            >
              Quiero acertar la próxima →
            </button>
            <p class="invitacion-linea">Reto de 5 sesiones gratis · recibe el acceso por correo</p>
            <a class="b-descarga-enlace" href={pdf} download data-descarga="tras-corregir">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"></path><path d="M7 10l5 5 5-5"></path><path d="M5 21h14"></path></svg>
              Descargar la ficha (PDF)
            </a>

            <div class="reto-hueco" data-reto-hueco data-reto-final>
              <div class="reto-zona" id="reto-zona" data-reto-zona hidden>
                <p class="reto-eyebrow">Reto gratis · 5 sesiones</p>
                <h4 tabindex="-1" data-oferta-titulo>Sigue practicando con casos más variados</h4>
                <p data-oferta-texto>Un reto de 5 sesiones con corrección al momento.</p>
                <ul class="reto-lista">
                  <li>Empieza por lo que te ha costado</li>
                  <li>10 ejercicios por sesión, con la explicación de cada respuesta</li>
                  <li>Tu avance se guarda en este navegador</li>
                </ul>
                <RetoFormulario />
              </div>
            </div>
          </div>
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main [hidden] {
    display: none;
  }

  .diseno-b {
    --b-navy: #0b2f55;
    --b-oro: #b8860b;
    --b-oro-claro: #f0d48a;
    --b-tinta-oro: #1f1a10;
    --b-mal-fondo: #f8e7e4;
    --b-mal: #9a3329;
    --b-bien-fondo: #e6f2ea;
    --b-bien: #23633e;
  }

  /* El recuento de la tarjeta sustituye a la línea genérica del formulario compartido. */
  [data-practica] :global([data-resultado]) {
    display: none;
  }

  /* La cabecera de la web es fija: los destinos de los desplazamientos dejan margen. */
  main :global([data-pregunta]),
  .ayuda,
  .error,
  .reto-zona {
    scroll-margin-top: 6rem;
  }

  .prototipo-aviso {
    margin: 0;
    padding: 0.5rem 1rem;
    background: var(--color-gold);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
  }

  .prototipo-aviso a {
    text-decoration: underline;
  }

  /* Presentación: franja azul marino con el tutor y la descarga como acción principal. */
  .b-hero {
    border-radius: 0 0 28px 28px;
    background: var(--b-navy);
    color: #ffffff;
    padding-block: 1.75rem 2rem;
  }

  .b-hero-dentro {
    display: grid;
    gap: 1.25rem;
    max-width: 820px;
  }

  .b-tutor {
    display: flex;
    gap: 0.9rem;
    align-items: flex-end;
  }

  .b-avatar {
    flex: none;
    width: 76px;
    height: 76px;
    border: 3px solid var(--b-oro-claro);
    border-radius: 50%;
    object-fit: cover;
  }

  .b-bocadillo {
    max-width: 30rem;
    margin: 0;
    padding: 0.75rem 0.9rem;
    border-radius: 16px 16px 16px 4px;
    background: #ffffff;
    color: var(--color-text);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .b-titulo {
    display: grid;
    gap: 0.4rem;
  }

  .b-eyebrow,
  .reto-eyebrow {
    margin: 0;
    color: var(--b-oro-claro);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .b-hero h1 {
    margin: 0;
    color: #ffffff;
    font-size: clamp(1.75rem, 5vw, 3.2rem);
    line-height: 1.12;
  }

  .b-descarga {
    display: grid;
    gap: 0.5rem;
  }

  .b-descarga-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .b-boton {
    display: inline-flex;
    gap: 0.55rem;
    align-items: center;
    justify-content: center;
    min-height: 3.3rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    font: inherit;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
  }

  .b-boton-oro {
    background: var(--b-oro);
    color: var(--b-tinta-oro);
  }

  .b-boton-oro:hover {
    background: #a57808;
  }

  .b-boton-contorno {
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    color: #ffffff;
  }

  .b-boton-contorno-oscuro {
    border: 2px solid var(--b-navy);
    background: transparent;
    color: var(--b-navy);
  }

  .b-nota {
    margin: 0;
    color: #c9d6e6;
    font-size: 0.85rem;
  }

  .b-descargada {
    max-width: 30rem;
    margin: 0;
    padding: 0.6rem 0.8rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.12);
    font-size: 0.92rem;
  }

  .b-descargada strong {
    color: var(--b-oro-claro);
  }

  .section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  }

  .seccion-estrecha {
    max-width: 820px;
  }

  .seccion-intro {
    max-width: 680px;
    margin: 0.75rem 0 1.25rem;
    color: var(--color-text-muted);
  }

  /* Ejercicios compactos: opciones en dos columnas, sin el punto del radio (sigue siendo un radio). */
  .diseno-b :global(.pregunta fieldset) {
    padding: 0.85rem;
    border-radius: 14px;
  }

  .diseno-b :global(.pregunta legend) {
    margin-bottom: 0.6rem;
    font-size: 1.05rem;
  }

  .diseno-b [data-practica] :global(.pregunta-opciones) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .diseno-b [data-practica] :global(.opcion) {
    position: relative;
    justify-content: center;
    min-height: 2.9rem;
    border-radius: 10px;
    text-align: center;
  }

  .diseno-b [data-practica] :global(.opcion input) {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .diseno-b [data-practica] :global(.opcion:has(input:checked)) {
    border-width: 2px;
  }

  .diseno-b [data-practica] :global(.opcion:has(input:focus-visible)) {
    outline: 3px solid var(--color-blue);
    outline-offset: 2px;
  }

  /* «Corregir» siempre a mano mientras se ven los ejercicios. */
  .diseno-b [data-practica] :global(.ejercicios-acciones) {
    position: sticky;
    bottom: 0;
    z-index: 5;
    margin-inline: -0.75rem;
    padding: 0.75rem;
    border-top: 1px solid var(--color-border);
    border-radius: 14px 14px 0 0;
    background: var(--color-surface);
    box-shadow: 0 -8px 24px rgba(11, 47, 85, 0.08);
    flex-wrap: nowrap;
  }

  .diseno-b [data-practica] :global([data-corregir]) {
    flex: 1;
    min-height: 3.1rem;
    border-radius: 999px;
    background: var(--b-navy);
  }

  .diseno-b [data-practica] :global(.b-contador) {
    flex: none;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    line-height: 1.25;
  }

  /* Tarjeta de resultados */
  .ayuda {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .ayuda-cabecera {
    display: grid;
    gap: 0.3rem;
  }

  .ayuda-recuento {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .ayuda h3 {
    margin: 0;
    color: var(--b-navy);
    font-size: 1.5rem;
  }

  .ayuda-estado {
    margin: 0;
  }

  .ayuda h4 {
    margin: 0 0 0.5rem;
    font-size: 1.05rem;
  }

  .errores {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .error {
    border-radius: 20px;
    background: var(--color-surface);
    box-shadow: 0 6px 20px rgba(11, 47, 85, 0.08);
  }

  .error:has([aria-expanded="true"][data-error-boton]) {
    box-shadow: 0 10px 28px rgba(11, 47, 85, 0.14);
  }

  .error-boton {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 0.75rem;
    width: 100%;
    padding: 1rem;
    border: 0;
    border-radius: 20px;
    background: none;
    color: var(--color-text);
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .error-numero {
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .error-frase {
    grid-column: 1;
    color: var(--b-navy);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .hueco {
    display: inline-block;
    margin-inline: 0.15rem;
    color: var(--b-oro);
    font-weight: 800;
  }

  .error-comparacion {
    grid-column: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .etiqueta {
    display: grid;
    gap: 0.1rem;
    padding: 0.45rem 0.65rem;
    border-radius: 12px;
  }

  .etiqueta-titulo {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .etiqueta-mal {
    background: var(--b-mal-fondo);
    color: var(--b-mal);
  }

  .etiqueta-mal s {
    font-weight: 600;
  }

  .etiqueta-bien {
    background: var(--b-bien-fondo);
    color: var(--b-bien);
  }

  .error-icono {
    grid-column: 2;
    grid-row: 1 / span 3;
    align-self: start;
    color: var(--color-blue);
    transition: transform 0.15s ease;
  }

  [aria-expanded="true"] > .error-icono {
    transform: rotate(180deg);
  }

  .error-panel {
    display: grid;
    gap: 0.8rem;
    padding: 0 1rem 1.1rem;
  }

  .error-panel p {
    margin: 0;
  }

  .error-explicacion {
    line-height: 1.55;
  }

  .error-correcta {
    padding: 0.55rem 0.8rem;
    border-radius: 10px;
    background: var(--color-surface-soft);
    font-size: 0.95rem;
  }

  .error-correcta > span:first-child {
    font-weight: 700;
  }

  .error-correcta [lang="fr"] {
    color: var(--b-bien);
    font-weight: 600;
  }

  .error-reto,
  .invitacion {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }

  .invitacion-linea {
    color: #5c5751;
    font-size: 0.85rem;
  }

  .b-video {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-self: start;
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-bg);
    cursor: pointer;
    font: inherit;
    text-align: left;
  }

  .b-video-icono {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 10px;
    background: var(--b-navy);
    color: #ffffff;
  }

  .b-video-texto {
    display: grid;
    gap: 0.1rem;
  }

  .b-video-texto strong {
    color: var(--b-navy);
  }

  .b-video-texto span {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .aviso-video {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .error-video-zona {
    display: grid;
    gap: 0.4rem;
  }

  .error-video {
    display: block;
    width: 100%;
    max-width: 280px;
    aspect-ratio: 9 / 16;
    border-radius: 14px;
    background: var(--b-navy);
  }

  .error-practica {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }

  .enlace-boton {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-blue);
    cursor: pointer;
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
  }

  .ayuda-ejemplo {
    width: 100%;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border);
  }

  .lista-limpia {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ayuda-pista {
    margin: 0.75rem 0 0;
    font-weight: 600;
  }

  .vacias {
    display: grid;
    gap: 0.5rem;
  }

  .vacias-titulo {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .vacia {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.9rem;
    border: 1px dashed #cfc9bf;
    border-radius: 14px;
  }

  .desafio-zona p {
    margin: 0 0 0.75rem;
  }

  .invitacion {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .invitacion p {
    margin: 0;
  }

  .b-descarga-enlace {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-blue);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .reto-hueco {
    width: 100%;
  }

  .reto-hueco:empty {
    display: none;
  }

  /* El formulario del reto: bloque azul marino con el formulario compartido adaptado a este fondo. */
  .reto-zona {
    display: grid;
    gap: 0.75rem;
    width: 100%;
    box-sizing: border-box;
    margin-top: 0.25rem;
    padding: 1.1rem;
    border-radius: 18px;
    background: var(--b-navy);
    color: #ffffff;
  }

  .reto-zona p,
  .reto-zona h4 {
    margin: 0;
  }

  .reto-zona h4 {
    color: #ffffff;
    font-size: 1.3rem;
    line-height: 1.25;
  }

  .reto-lista {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding-left: 1.2rem;
    color: #e6ecf3;
  }

  .reto-lista li::marker {
    color: var(--b-oro-claro);
  }

  .reto-zona :global(.reto-form),
  .reto-zona :global(.reto-confirmacion) {
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    color: #ffffff;
  }

  .reto-zona :global(.reto-form-simulado) {
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
  }

  .reto-zona :global(.campo) {
    color: #ffffff;
  }

  .reto-zona :global(.campo em) {
    color: #c9d6e6;
  }

  .reto-zona :global(.campo input),
  .reto-zona :global(.campo select) {
    min-height: 3.1rem;
    border: 0;
    border-radius: 12px;
    background: #ffffff;
    color: var(--color-text);
  }

  .reto-zona :global(.campo-error) {
    color: #ffc2b8;
  }

  .reto-zona :global(.casilla) {
    color: #e6ecf3;
  }

  .reto-zona :global(.casilla input) {
    accent-color: var(--b-oro);
  }

  .reto-zona :global(.reto-form-aviso),
  .reto-zona :global(.reto-confirmacion p) {
    color: #c9d6e6;
  }

  .reto-zona :global(.reto-confirmacion h3) {
    color: #ffffff;
  }

  .reto-zona :global(.reto-form .button),
  .reto-zona :global(.reto-confirmacion .button) {
    min-height: 3.3rem;
    border: 0;
    border-radius: 999px;
    background: var(--b-oro);
    color: var(--b-tinta-oro);
    font-weight: 800;
  }

  @media (max-width: 600px) {
    .b-descarga-botones .b-boton,
    .error-reto .b-boton,
    .invitacion .b-boton {
      width: 100%;
    }

    .error-reto,
    .invitacion {
      justify-items: stretch;
      text-align: center;
    }

    .b-descarga-enlace {
      justify-self: center;
    }

    .b-video {
      justify-self: stretch;
    }
  }
</style>

<script>
  import { ordenEstandar, tipos as tiposReto } from "../../../../data/practicaAvoirEtre";
  import { ejercicios, type TipoVideo } from "../../../../data/practicaAvoirEtreOpcion3";
  import {
    decidirAyuda,
    ordenDesde,
    type DecisionAyuda,
    type ResultadoEjercicio,
  } from "../../../../utils/ayudaVideo";
  import { guardarProgreso, leerProgreso, track } from "../../../../utils/track";

  const zona = document.querySelector<HTMLElement>("[data-ayuda-zona]");
  const recuentoTexto = document.querySelector<HTMLElement>("[data-recuento]");
  const estadoTitulo = document.querySelector<HTMLElement>("[data-estado-titulo]");
  const estadoTexto = document.querySelector<HTMLElement>("[data-estado-texto]");
  const listaErrores = document.querySelector<HTMLElement>("[data-errores]");
  const errores = Array.from(document.querySelectorAll<HTMLElement>("[data-fallo]"));
  const zonaVacias = document.querySelector<HTMLElement>("[data-vacias]");
  const vacias = Array.from(document.querySelectorAll<HTMLElement>("[data-vacia]"));
  const desafioZona = document.querySelector<HTMLElement>("[data-desafio]");
  const botonesReto = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-abrir-reto]"));
  const retoZona = document.querySelector<HTMLElement>("[data-reto-zona]");
  const huecoFinal = document.querySelector<HTMLElement>("[data-reto-final]");
  const ofertaTitulo = document.querySelector<HTMLElement>("[data-oferta-titulo]");
  const ofertaTexto = document.querySelector<HTMLElement>("[data-oferta-texto]");
  const tipoPorId = Object.fromEntries(ejercicios.map((e) => [e.id, e.tipo])) as Record<string, TipoVideo>;
  const numeroDe = (id: string) => ejercicios.findIndex((e) => e.id === id) + 1;
  const nombreSesion = (tipo: TipoVideo) => tiposReto.find((t) => t.id === tipo)?.nombre ?? tipo;

  // Estado: el error abierto (o el último abierto) manda sobre la oferta y el orden del reto.
  let decision: DecisionAyuda | null = null;
  let errorActual: string | null = null;

  const plural = (n: number, uno: string, varios: string) => `${n} ${n === 1 ? uno : varios}`;

  const pausarVideos = () =>
    document.querySelectorAll<HTMLVideoElement>("[data-ayuda-zona] [data-video]").forEach((v) => v.pause());

  const enlaceReto = () => document.querySelector<HTMLAnchorElement>("[data-reto-enlace]");

  // Guarda el orden del reto y, si el acceso ya se mostró, actualiza su enlace.
  const fijarOrden = (orden: string) => {
    guardarProgreso({ ...leerProgreso(), orden });
    const enlace = enlaceReto();
    if (enlace?.search.includes("orden=")) {
      const url = new URL(enlace.href);
      url.searchParams.set("orden", orden);
      enlace.href = url.pathname + url.search;
    }
  };

  const actualizarOferta = () => {
    if (!ofertaTitulo || !ofertaTexto || !decision) return;
    if (decision.modo === "con-fallos" && errorActual) {
      const tipo = tipoPorId[errorActual];
      ofertaTitulo.textContent = `Tu reto empieza por: ${nombreSesion(tipo)}`;
      ofertaTexto.textContent = `La primera sesión trabaja el error de la frase ${numeroDe(errorActual)}; después, el resto de dificultades. Corrección al momento.`;
      fijarOrden(ordenDesde(tipo, decision.tipos, ordenEstandar).join("-"));
    } else {
      ofertaTitulo.textContent =
        decision.modo === "todo-correcto"
          ? "Sigue practicando con casos más variados"
          : "Practica el passé composé paso a paso";
      ofertaTexto.textContent = "Un reto de 5 sesiones con corrección al momento.";
      fijarOrden((decision.modo === "sin-respuestas" ? ordenEstandar : decision.orden).join("-"));
    }
  };

  // Un solo formulario del reto. Al cerrarlo puede volver al hueco final; mover el nodo conserva lo escrito.
  const cerrarReto = (volverAlFinal = false) => {
    if (!retoZona) return;
    retoZona.hidden = true;
    botonesReto.forEach((boton) => boton.setAttribute("aria-expanded", "false"));
    if (volverAlFinal && huecoFinal && retoZona.parentElement !== huecoFinal) huecoFinal.append(retoZona);
  };

  const plegarVideos = () => {
    pausarVideos();
    document.querySelectorAll<HTMLElement>("[data-ayuda-zona] [data-video-zona]").forEach((z) => (z.hidden = true));
    document
      .querySelectorAll<HTMLElement>("[data-ayuda-zona] [data-ver-video]")
      .forEach((boton) => boton.setAttribute("aria-expanded", "false"));
  };

  // Solo una explicación abierta a la vez: abrir una cierra la anterior y pliega y detiene su vídeo.
  // Si el formulario estaba en el error que se cierra, vuelve al final de la tarjeta.
  const abrirError = (id: string | null, desplazar = false) => {
    plegarVideos();
    const errorDelReto = retoZona?.closest<HTMLElement>("[data-fallo]");
    if (errorDelReto && errorDelReto.dataset.fallo !== id) cerrarReto(true);
    errores.forEach((item) => {
      const abierto = item.dataset.fallo === id;
      item.querySelector("[data-error-boton]")?.setAttribute("aria-expanded", String(abierto));
      const panel = item.querySelector<HTMLElement>("[data-error-panel]");
      if (panel) panel.hidden = !abierto;
    });
    if (!id) return;
    errorActual = id;
    actualizarOferta();
    if (desplazar) {
      errores.find((item) => item.dataset.fallo === id)?.scrollIntoView({ behavior: "smooth", block: "nearest" });
    }
  };

  const reiniciarCasosNuevos = () => {
    errores.forEach((item) => {
      const ejemplo = item.querySelector<HTMLElement>("[data-ejemplo-zona]");
      if (ejemplo) ejemplo.hidden = true;
      ejemplo?.querySelectorAll<HTMLInputElement>("input").forEach((input) => (input.checked = false));
      ejemplo?.querySelectorAll<HTMLElement>("[data-pregunta]").forEach((p) => p.classList.remove("es-correcta", "es-incorrecta"));
      ejemplo?.querySelectorAll<HTMLElement>("[data-feedback], [data-pista]").forEach((el) => (el.hidden = true));
    });
  };

  const textos: Record<DecisionAyuda["modo"], (d: DecisionAyuda) => [string, string]> = {
    "sin-respuestas": () => [
      "Aún no has respondido ninguna frase",
      "Responde al menos una frase para ver tu ayuda.",
    ],
    "todo-correcto": (d) => [
      `¡Las ${d.recuento.correctas} frases, correctas!`,
      "Respondiste todas y no hay ningún error.",
    ],
    "parcial-sin-fallos": (d) => [
      "Sin errores en las frases que respondiste",
      `Pero ${d.recuento.sinResponder === 1 ? "falta 1 frase" : `faltan ${d.recuento.sinResponder} frases`} por responder: con ellas vacías no se puede saber si lo dominas todo. Respóndelas y vuelve a corregir.`,
    ],
    "con-fallos": (d) => [
      d.recuento.incorrectas === 1 ? "Repasa tu error" : `Repasa tus ${d.recuento.incorrectas} errores`,
      "Toca cada frase para ver su explicación.",
    ],
  };

  document.querySelector("[data-practica]")?.addEventListener("afv:corregido", (event) => {
    const { resultados } = (event as CustomEvent<{ resultados: ResultadoEjercicio[] }>).detail;
    decision = decidirAyuda(resultados, tipoPorId, ordenEstandar);
    errorActual = null;
    if (!zona) return;

    cerrarReto(true);
    zona.hidden = false;
    const { correctas, incorrectas, sinResponder } = decision.recuento;
    if (recuentoTexto) {
      recuentoTexto.textContent = [
        plural(correctas, "correcta", "correctas"),
        plural(incorrectas, "incorrecta", "incorrectas"),
        plural(sinResponder, "sin responder", "sin responder"),
      ].join(" · ");
    }
    const [titulo, texto] = textos[decision.modo](decision);
    if (estadoTitulo) estadoTitulo.textContent = titulo;
    if (estadoTexto) estadoTexto.textContent = texto;

    // Errores: uno por línea con la frase, la elección y la correcta.
    const fallos = decision.modo === "con-fallos" ? decision.fallos : [];
    errores.forEach((item) => {
      const id = item.dataset.fallo ?? "";
      item.hidden = !fallos.includes(id);
      const elegida = document.querySelector<HTMLInputElement>(`[data-practica] [data-pregunta="${id}"] input:checked`);
      const destino = item.querySelector<HTMLElement>("[data-elegida]");
      const ejercicio = ejercicios.find((e) => e.id === id);
      if (destino && elegida && ejercicio) destino.textContent = ejercicio.opciones[Number(elegida.value)];
    });
    if (listaErrores) listaErrores.hidden = !fallos.length;
    reiniciarCasosNuevos();

    // Sin responder: aparte, salvo cuando no hay ninguna respuesta (el aviso ya lo dice).
    const ids = decision.modo === "sin-respuestas" ? [] : decision.vacias;
    vacias.forEach((item) => (item.hidden = !ids.includes(item.dataset.vacia ?? "")));
    if (zonaVacias) zonaVacias.hidden = !ids.length;

    if (desafioZona) desafioZona.hidden = decision.modo !== "todo-correcto";

    abrirError(fallos[0] ?? null);
    actualizarOferta();
    track("ayuda_ofrecida", {
      modo: decision.modo,
      tipo: fallos[0] ? tipoPorId[fallos[0]] : "ninguno",
    });

    // El resultado queda a la vista: se salta al principio de la tarjeta.
    estadoTitulo?.focus({ preventScroll: true });
    zona.scrollIntoView({ behavior: "smooth", block: "start" });
  });

  // «Intentar de nuevo» (botón del formulario compartido) limpia también la tarjeta.
  document.querySelector("[data-practica] [data-reintentar]")?.addEventListener("click", () => {
    plegarVideos();
    cerrarReto(true);
    if (zona) zona.hidden = true;
    decision = null;
    errorActual = null;
  });

  errores.forEach((item) => {
    const id = item.dataset.fallo ?? "";
    const boton = item.querySelector<HTMLButtonElement>("[data-error-boton]");
    boton?.addEventListener("click", () => {
      const abierto = boton.getAttribute("aria-expanded") === "true";
      abrirError(abierto ? "" : id, !abierto);
      if (!abierto) track("error_abierto", { ejercicio: id, tipo: tipoPorId[id] });
    });

    const ejemploZona = item.querySelector<HTMLElement>("[data-ejemplo-zona]");
    item.querySelector("[data-probar]")?.addEventListener("click", () => {
      if (!ejemploZona) return;
      ejemploZona.hidden = false;
      ejemploZona.querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
      ejemploZona.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });

    // Vídeo plegado: se despliega y empieza al pulsar «Ver el vídeo»; otro toque lo pliega.
    const video = item.querySelector<HTMLVideoElement>("[data-video]");
    const verVideo = item.querySelector<HTMLButtonElement>("[data-ver-video]");
    const zonaVideo = item.querySelector<HTMLElement>("[data-video-zona]");
    verVideo?.addEventListener("click", () => {
      if (!video || !zonaVideo) return;
      const abrir = zonaVideo.hidden;
      zonaVideo.hidden = !abrir;
      verVideo.setAttribute("aria-expanded", String(abrir));
      if (!abrir) {
        video.pause();
        return;
      }
      video.play().catch(() => undefined);
      zonaVideo.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
    video?.addEventListener("play", () => track("video_play", { ejercicio: id }));
    video?.addEventListener("ended", () => track("video_fin", { ejercicio: id }));
    // Si el archivo no está en esta copia, se vuelve al aviso «vídeo pendiente».
    video?.addEventListener("error", () => {
      const pendiente = item.querySelector<HTMLElement>("[data-video-pendiente]");
      if (zonaVideo) zonaVideo.hidden = true;
      if (verVideo) verVideo.hidden = true;
      if (pendiente) pendiente.hidden = false;
    });
  });

  vacias.forEach((item) => {
    item.querySelector<HTMLButtonElement>("[data-responder]")?.addEventListener("click", () => {
      const pregunta = document.querySelector<HTMLElement>(
        `[data-practica] [data-pregunta="${item.dataset.vacia}"]`,
      );
      pregunta?.scrollIntoView({ behavior: "smooth", block: "start" });
      pregunta?.querySelector<HTMLInputElement>("input")?.focus({ preventScroll: true });
    });
  });

  // Ejercicios de un clic (caso nuevo y desafío): la corrección aparece al elegir.
  document.querySelectorAll<HTMLElement>("[data-instantaneo]").forEach((lista) => {
    lista.addEventListener("change", (event) => {
      const input = event.target as HTMLInputElement;
      const item = input.closest<HTMLElement>("[data-pregunta]");
      if (!item) return;
      const correcta = Number(item.dataset.correcta);
      const acierto = Number(input.value) === correcta;
      const opciones = Array.from(item.querySelectorAll<HTMLInputElement>("input"));
      const veredicto = item.querySelector<HTMLElement>("[data-veredicto]");
      const solucion = item.querySelector<HTMLElement>("[data-solucion]");
      const feedback = item.querySelector<HTMLElement>("[data-feedback]");
      const error = lista.closest<HTMLElement>("[data-fallo]");

      item.classList.remove("es-correcta", "es-incorrecta");
      item.classList.add(acierto ? "es-correcta" : "es-incorrecta");
      if (veredicto) {
        veredicto.textContent = acierto
          ? error
            ? "¡Correcto! Has resuelto un caso nuevo de esta diferencia."
            : "¡Correcto!"
          : "No es correcto.";
      }
      if (solucion) solucion.textContent = `Respuesta: ${opciones[correcta]?.closest("label")?.textContent?.trim()}.`;
      if (feedback) feedback.hidden = false;

      const pista = error?.querySelector<HTMLElement>("[data-pista]");
      if (pista) pista.hidden = acierto;
      track(error ? "ejemplo_nuevo" : "desafio", {
        tipo: error?.dataset.tipo ?? "desafio",
        correcta: acierto ? "si" : "no",
      });
    });
  });

  // «Quiero acertar la próxima →» (en el error abierto o al final): abre el único formulario en el
  // hueco de ese botón, sin obligar a ver el vídeo, resolver el caso nuevo ni revisar otros errores.
  botonesReto.forEach((boton) => {
    boton.addEventListener("click", () => {
      const hueco =
        boton.closest("[data-error-panel]")?.querySelector<HTMLElement>("[data-reto-hueco]") ?? huecoFinal;
      if (!retoZona || !hueco) return;
      if (!retoZona.hidden && retoZona.parentElement === hueco) {
        cerrarReto();
        return;
      }
      hueco.append(retoZona);
      retoZona.hidden = false;
      botonesReto.forEach((b) => b.setAttribute("aria-expanded", String(b === boton)));
      pausarVideos();
      actualizarOferta();
      track("seguir_visto", {
        modo: decision?.modo ?? "sin-corregir",
        tipo: errorActual ? tipoPorId[errorActual] : "ninguno",
        posicion: hueco === huecoFinal ? "final" : "error",
      });
      ofertaTitulo?.focus({ preventScroll: true });
      retoZona.scrollIntoView({ behavior: "smooth", block: "nearest" });
    });
  });

  // Tras descargar desde la presentación, una invitación suave a practicar.
  const descargada = document.querySelector<HTMLElement>("[data-descargada]");
  document.querySelectorAll<HTMLAnchorElement>("[data-descarga]").forEach((boton) => {
    boton.addEventListener("click", () => {
      track("descarga_ficha", { posicion: boton.dataset.descarga ?? "" });
      if (boton.dataset.descarga === "cabecera" && descargada) descargada.hidden = false;
    });
  });

  // Contador junto a «Corregir» (la barra queda fija abajo mientras se ven los ejercicios).
  const formPractica = document.querySelector<HTMLFormElement>("[data-practica] [data-ejercicios]");
  const accionesPractica = formPractica?.querySelector<HTMLElement>(".ejercicios-acciones");
  if (formPractica && accionesPractica) {
    const contador = document.createElement("span");
    contador.className = "b-contador";
    contador.setAttribute("aria-live", "polite");
    accionesPractica.prepend(contador);
    const total = formPractica.querySelectorAll("[data-pregunta]").length;
    const contar = () => {
      const respondidas = formPractica.querySelectorAll("input:checked").length;
      contador.textContent = `${respondidas} de ${total} respondidas`;
    };
    contar();
    formPractica.addEventListener("change", contar);
    formPractica.querySelector("[data-reintentar]")?.addEventListener("click", () => setTimeout(contar));
  }

  // Avatar provisional (solo en este equipo): si falta, se quita la imagen y queda el bocadillo.
  const avatar = document.querySelector<HTMLImageElement>("[data-avatar]");
  const quitarAvatar = () => avatar?.remove();
  if (avatar?.complete && avatar.naturalWidth === 0) quitarAvatar();
  avatar?.addEventListener("error", quitarAvatar);
</script>
